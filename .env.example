# Copy this to .env and fill in your own keys. .env is gitignored.

# IndiaDataHub Economic Monitor — Capital Market endpoints
# Sign up at https://feeds.indiadatahub.com to obtain your key
INDIA_DATAHUB_API_KEY=

# Zerodha Kite Connect — local-only market-data fetch.
# Never expose KITE_API_SECRET or access tokens in public site data.
KITE_API_KEY=
KITE_API_SECRET=
# For automated daily token refresh (TOTP auto-login). All optional —
# without them, use the manual `login-url` + `exchange-token` flow.
KITE_USER_ID=
KITE_PASSWORD=
KITE_TOTP_SECRET=

# DeepSeek — used by the v2 rebuild orchestrator (ipo_portal.orchestrator).
# Get a key at https://platform.deepseek.com. Never commit.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenRouter — optional filing extraction provider.
# Get a key at https://openrouter.ai/keys. Never commit.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_DEFAULT_MODEL=qwen/qwen3.5-flash-02-23
# Optional attribution headers shown in OpenRouter analytics/leaderboards.
OPENROUTER_SITE_URL=
OPENROUTER_APP_TITLE=IPO Watch Filing Processor

# Gemini — used by the SEBI new-filings PDF/article workflow.
GEMINI_API_KEY=

# Cloudflare Workers — used by GitHub Actions deploy jobs.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
