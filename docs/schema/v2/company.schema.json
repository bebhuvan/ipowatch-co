{
  "$id": "https://ipo-watch.local/schema/v2/company.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Company",
  "description": "Canonical schema for a company and the issues it has brought to market. Root carries the metadata envelope plus the company body.",
  "x-ipo-watch": {
    "design_notes": [
      "Company identity uses CIN as primary identifier; ISIN and exchange codes are secondary.",
      "Slug is generated by IPO Watch for stable referencing.",
      "Contact fields are marked PII and should be handled with care.",
      "Address fields are free-text and may contain HTML entities; sanitization recommended.",
      "Classification fields are optional as they may not be available for all companies."
    ],
    "field_provenance": {
      "address.corporate_office": {
        "sources": [
          "nse"
        ],
        "tier": "secondary"
      },
      "address.registered_office": {
        "sources": [
          "nse"
        ],
        "tier": "secondary"
      },
      "classification.board_type": {
        "sources": [
          "nse"
        ],
        "tier": "secondary"
      },
      "classification.industry": {
        "sources": [
          "nse"
        ],
        "tier": "secondary"
      },
      "classification.listing_status": {
        "sources": [
          "bse"
        ],
        "tier": "secondary"
      },
      "contact.company_secretary": {
        "sources": [
          "nse"
        ],
        "tier": "secondary"
      },
      "contact.email": {
        "sources": [
          "nse"
        ],
        "tier": "secondary"
      },
      "contact.telephone": {
        "sources": [
          "nse"
        ],
        "tier": "secondary"
      },
      "identity.bse_code": {
        "sources": [
          "bse"
        ],
        "tier": "primary"
      },
      "identity.cin": {
        "sources": [
          "nse"
        ],
        "tier": "primary"
      },
      "identity.isin": {
        "sources": [
          "nse",
          "trendlyne"
        ],
        "tier": "primary"
      },
      "identity.name": {
        "sources": [
          "bse",
          "nse",
          "trendlyne"
        ],
        "tier": "primary"
      },
      "identity.nse_symbol": {
        "sources": [
          "nse"
        ],
        "tier": "primary"
      },
      "identity.slug": {
        "sources": [
          "ipo-watch"
        ],
        "tier": "primary"
      },
      "identity.website": {
        "sources": [
          "nse"
        ],
        "tier": "secondary"
      }
    },
    "version": "2.0.0"
  },
  "type": "object",
  "additionalProperties": false,
  "required": [
    "slug",
    "company_name",
    "issues"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "format": "uri-reference",
      "description": "URL of the JSON Schema this record conforms to."
    },
    "schema_version": {
      "type": "string",
      "description": "SemVer of that schema."
    },
    "schema_url_self": {
      "type": [
        "string",
        "null"
      ],
      "description": "Stable URL where this document lives."
    },
    "dataset": {
      "type": "string",
      "description": "Dataset short-name, e.g. ipo-watch.issues."
    },
    "dataset_version": {
      "type": "string",
      "description": "Build-time version; increments every build. Pin for reproducible builds."
    },
    "generated_at": {
      "type": "string",
      "format": "date-time"
    },
    "generated_by": {
      "type": "string"
    },
    "time_zone": {
      "type": "string",
      "description": "Date-only fields are in this zone (Asia/Kolkata)."
    },
    "currency": {
      "type": "string",
      "description": "Monetary fields are in this currency (INR)."
    },
    "language": {
      "type": "string",
      "description": "BCP-47 language tag."
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object"
      },
      "description": "Every source that contributed to this record."
    },
    "field_provenance": {
      "type": "object",
      "description": "Map of field-path -> {source, snapshot_at, rule_id} for contested fields."
    },
    "data_quality": {
      "type": "object",
      "properties": {
        "state": {
          "enum": [
            "clean",
            "review",
            "quarantine"
          ]
        },
        "errors": {
          "type": "array"
        },
        "warnings": {
          "type": "array"
        }
      },
      "required": [
        "state"
      ],
      "description": "Render only state in (clean, review)."
    },
    "freshness": {
      "type": "object",
      "description": "Map of source -> last successful refresh ISO instant."
    },
    "license": {
      "type": "string"
    },
    "notes": {
      "type": [
        "string",
        "null"
      ]
    },
    "slug": {
      "type": "string"
    },
    "url_path": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "normalized_name": {
      "type": "string",
      "description": "Lower/normalized form used for dedup + matching."
    },
    "issue_count": {
      "type": "integer"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": true,
        "properties": {
          "slug": {
            "type": "string"
          },
          "url_path": {
            "type": "string"
          },
          "company_name": {
            "type": "string"
          },
          "symbol": {
            "type": [
              "string",
              "null"
            ]
          },
          "isin": {
            "type": [
              "string",
              "null"
            ]
          },
          "issue_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "board_type": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "data_quality_state": {
            "type": [
              "string",
              "null"
            ]
          },
          "source_count": {
            "type": [
              "integer",
              "null"
            ]
          },
          "open_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "close_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "listing_date": {
            "type": [
              "string",
              "null"
            ]
          },
          "price_band_lower_paise": {
            "type": [
              "integer",
              "null"
            ]
          },
          "price_band_upper_paise": {
            "type": [
              "integer",
              "null"
            ]
          },
          "issue_price_paise": {
            "type": [
              "integer",
              "null"
            ]
          },
          "issue_size_paise": {
            "type": [
              "integer",
              "null"
            ]
          },
          "overall_times_x": {
            "type": [
              "string",
              "null"
            ]
          },
          "listing_gain_bps": {
            "type": [
              "integer",
              "null"
            ]
          },
          "current_gain_bps": {
            "type": [
              "integer",
              "null"
            ]
          }
        }
      },
      "description": "Compact summaries of every issue by this company."
    }
  }
}
