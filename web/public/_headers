/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# HTML pages — site rebuilds hourly; stale-while-revalidate lets Cloudflare
# serve the cached page instantly while fetching the fresh version in the
# background. max-age=0 ensures the CDN always checks; SWR=3600 covers the gap.
/
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=3600
/*/
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=3600
/*/*/
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=3600
/*/*/*/
  Cache-Control: public, max-age=0, must-revalidate, stale-while-revalidate=3600

# LLM context files — allow unrestricted access, no cache restriction
/llms.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/llms-full.txt
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: text/plain; charset=utf-8
  Access-Control-Allow-Origin: *

/context.json
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: application/json; charset=utf-8
  Access-Control-Allow-Origin: *

/robots.txt
  Cache-Control: public, max-age=86400
  Content-Type: text/plain; charset=utf-8

# Sitemap — allow search engines and LLM crawlers to cache
/sitemap*.xml
  Cache-Control: public, max-age=3600, stale-while-revalidate=86400
  Content-Type: application/xml; charset=utf-8

# Data API endpoints
/data/*
  Cache-Control: public, max-age=0, must-revalidate

# Immutable hashed assets
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Workers preview URLs — noindex
https://:version.:subdomain.workers.dev/*
  X-Robots-Tag: noindex
