              <h3 class="serif text-[20px] leading-tight">{primaryFinancialSeries[0].source.label}</h3>
              <span class="label">reported sequence</span>
            </div>
            <svg viewBox={`0 0 ${primaryChart.width} ${primaryChart.height}`} class="w-full h-auto block" role="img" aria-label={`${primaryFinancialSeries[0].source.label} chart`}>
              {/* Zero baseline */}
              <line x1="28" x2={primaryChart.width - 28} y1={primaryChart.zeroY} y2={primaryChart.zeroY} stroke="var(--color-ink)" stroke-width="1.5" />
              {/* Bars — accent for positive, muted for negative */}
              {primaryChart.bars.map((bar) => (
                <rect x={bar.x} y={bar.y} width={bar.w} height={bar.h}
                  fill={bar.row.value < 0 ? 'var(--color-mute-2)' : 'var(--color-accent)'}
                  opacity={bar.row.value < 0 ? '0.6' : '0.75'} />
              ))}
              {/* Trend line */}
              {primaryChart.points && <polyline points={primaryChart.points} fill="none" stroke="var(--color-ink)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" opacity="0.5" />}
            </svg>
            <div class="grid gap-2 mt-4 border-t border-[color:var(--color-rule)] pt-4" style={`grid-template-columns: repeat(${Math.min(primaryFinancialSeries.length, 8)}, minmax(0, 1fr));`}>
              {primaryFinancialSeries.map((row) => (
                <div class="min-w-0 text-center">
                  <div class="serif text-[18px] font-light leading-tight num break-words">{row.value.toLocaleString('en-IN')}</div>
                  <div class="mt-1 text-[11px] mute num">{row.label}</div>
                </div>
              ))}
            </div>
            {secondaryFinancialSeries.length > 0 && (
              <div class="mt-8 pt-6 border-t border-[color:var(--color-rule)]">
                <div class="stat-label mb-4">{secondaryFinancialSeries[0].source.label}</div>
                <div class="space-y-3">
                  {secondaryFinancialSeries.map((row) => {
                    const maxAbs = Math.max(...secondaryFinancialSeries.map((r) => Math.abs(r.value)), 1);
                    const w = Math.max(2, (Math.abs(row.value) / maxAbs) * 100);
                    return (
                      <div class="grid grid-cols-[52px_minmax(0,1fr)_90px] items-center gap-3">
                        <span class="text-[12px] mute num">{row.label}</span>
                        <span class="h-[10px] bg-[color:var(--color-rule)] relative">
                          <span class={`absolute inset-y-0 ${row.value < 0 ? 'right-1/2 bg-[color:var(--color-mute-2)]' : 'left-1/2 bg-[color:var(--color-accent)]'}`} style={`width: ${Math.min(50, w / 2).toFixed(1)}%; opacity: 0.7;`}></span>
                        </span>
                        <span class="text-right num serif text-[16px] font-light">{row.value.toLocaleString('en-IN')}</span>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}
          </div>
        )}
        {financialTrendFacts.length > 0 && (
          <div class="max-w-[680px] mx-auto mt-8 space-y-4">
            {financialTrendFacts.slice(0, 5).map((fact) => (
              <p class="text-[16px] leading-[1.72]">
                <span class="font-semibold">{fact.label}.</span> {fact.value}
              </p>
            ))}
          </div>
        )}
        {articleRatios.length > 0 && (
          <div class="max-w-[680px] mx-auto mt-8 grid grid-cols-2 sm:grid-cols-3 gap-px bg-[color:var(--color-rule)] border border-[color:var(--color-rule)]">
            {articleRatios.slice(0, 6).map((row) => (
              <div class="bg-white p-5">
                <div class="text-[10px] mute uppercase tracking-[0.08em]">{row.label}</div>
                <div class="mt-2 serif text-[21px] num">{row.value.toLocaleString('en-IN')}</div>
              </div>
            ))}
          </div>
        )}
        {sourcePages(financialSourceFacts.length ? financialSourceFacts : financialTrendFacts) && (
          <p class="max-w-[680px] mx-auto mt-4 text-[11px] mute">{sourcePages(financialSourceFacts.length ? financialSourceFacts : financialTrendFacts)}</p>
        )}
      </div>
    )}

    <!-- Shareholding and control -->
    {(shareholdingSourceFacts.length > 0 || controlParagraph) && (
      <div class="max-w-[680px] mb-20">
        <div class="label mb-5">Shareholding and control</div>
        {controlParagraph && <p class="text-[16px] leading-[1.72] mb-8">{controlParagraph}</p>}
        {shareholdingRows.length > 0 && (
          <div class="space-y-5 mb-8">
            {shareholdingRows.map((row) => (
              <div>
                <div class="flex items-baseline justify-between gap-4">
                  <span class="text-[14px] leading-snug">{row.value}</span>
                  <span class="serif text-[22px] num">{row.pct.toFixed(row.pct % 1 === 0 ? 0 : 2)}%</span>
                </div>
                <div class="mt-2 h-[10px] bg-[color:var(--color-rule)] relative">
                  <span class="absolute inset-y-0 left-0 bg-[color:var(--color-ink)]" style={`width: ${Math.max(0, Math.min(100, row.pct)).toFixed(2)}%;`}></span>
                </div>
              </div>
            ))}
          </div>
        )}
        {articleRelatedParty.length > 0 && (
          <p class="mt-5 text-[16px] leading-[1.72]">
            <span class="font-semibold">Related-party angle.</span> {articleRelatedParty[0].value}
          </p>
        )}
        {articleLitigation.length > 0 && (
          <p class="mt-5 text-[16px] leading-[1.72]">
            <span class="font-semibold">Legal overhang.</span> {articleLitigation[0].value}
          </p>
        )}
        {sourcePages(shareholdingSourceFacts) && <p class="mt-5 text-[11px] mute">{sourcePages(shareholdingSourceFacts)}</p>}
      </div>
    )}

    <!-- Risk thesis -->
    {riskParagraphs.length > 0 && (
      <div class="max-w-[680px]">
        <div class="label mb-5">Risk thesis</div>
        <div class="flex gap-5 mb-8">
          <div class="w-[3px] bg-[color:var(--color-accent)] shrink-0 rounded-full"></div>
          <div>
            <p class="serif text-[28px] leading-none num">{riskCountFact?.value ?? riskThesisFacts.length}</p>
            <p class="mt-1 text-[12px] mute leading-relaxed">{riskCountFact ? 'risk factors disclosed in the filing' : 'risk items extracted from the filing'}</p>
          </div>
        </div>
        <div class="space-y-5 mb-8">
          {riskParagraphs.map((line) => (
            <p class="text-[16px] leading-[1.72]">{line}</p>
          ))}
        </div>
        {riskThesisFacts.length > 0 && (
          <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-0 border-t border-[color:var(--color-ink)]">
            {riskThesisFacts.slice(0, 8).map((fact) => (
              <p class="py-4 border-b border-[color:var(--color-rule)] text-[13.5px] leading-relaxed">
                <span class="block text-[10px] mute uppercase tracking-[0.08em] mb-1">{fact.label}</span>
                {fact.value}
              </p>
            ))}
          </div>
        )}
        {sourcePages([riskCountFact, ...riskThesisFacts]) && <p class="mt-4 text-[11px] mute">{sourcePages([riskCountFact, ...riskThesisFacts])}</p>}
      </div>
    )}
  </section>
)}

<!-- TIJORI ENRICHMENT -->
{hasTijoriResearch && (
  <section id="research" class="page-tight py-20 border-t border-[color:var(--color-rule)]">
    <header class="flex flex-wrap items-baseline justify-between gap-4 mb-12">
      <h2 class="section-title">Company research</h2>
      <span class="text-[11px] mute tracking-[0.06em] uppercase font-semibold">
        Source: Tijori Finance · third-party enrichment
      </span>
    </header>

    <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_340px] gap-16">
      <!-- Left: description + financials + revenue mix -->
      <div class="space-y-16">

        {tijori?.business_description && (
          <div>
            <div class="label mb-4">About the company</div>
            <p class="serif text-[18px] leading-[1.6] text-[color:var(--color-ink-soft)] max-w-[62ch]">{tijori.business_description}</p>
          </div>
        )}

        {tijoriFinancialRows.length > 0 && (
          <div>
            <div class="label mb-4">Financials (₹ crore)</div>
            <table class="w-full text-[13.5px]">
              <thead>
                <tr class="border-b-2 border-[color:var(--color-ink)]">
                  <th class="text-left pb-3 pr-6 label">Period</th>
                  <th class="text-right pb-3 pr-6 label">Revenue</th>
                  <th class="text-right pb-3 pr-6 label">PAT</th>
                  <th class="text-right pb-3 label">Debt</th>
                </tr>
              </thead>
              <tbody>
                {tijoriFinancialRows.map((row) => (
                  <tr class="border-b border-[color:var(--color-rule)]">
