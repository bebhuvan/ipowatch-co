                  <span class="relative h-[24px] bg-white border border-[color:var(--color-rule)]">
                    <span
                      class={`absolute inset-y-0 left-0 ${isCutoff ? 'bg-[color:var(--color-accent)]' : 'bg-[color:var(--color-ink)]'}`}
                      style={`width: ${pct.toFixed(1)}%; opacity: ${isCutoff ? 1 : 0.3 + (pct / 100) * 0.6};`}
                    ></span>
                  </span>
                  <span class="col-start-2 sm:col-start-auto text-right serif text-[20px] num">{formatInt(row.quantity)}</span>
                </div>
              );
            })}
          </div>
          {(bidBook[0]?.timestamp || demandGraph?.note) && (
            <p class="mt-5 text-[12.5px] mute max-w-[78ch]">
              {bidBook[0]?.timestamp && <>Updated <span class="num">{bidBook[0].timestamp}</span>. </>}
              {demandGraph?.note && <>{demandGraph.note}</>}
            </p>
          )}
        </div>
      )}
    </div>
  </section>
)}


<!-- PARTIES -->
{(brlmName || registrarName || sponsorName) && (
  <section id="parties" class="page-tight py-20 border-t border-[color:var(--color-rule)]">
    <header class="mb-10">
      <h2 class="section-title">Parties to the issue</h2>
    </header>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-0 border-t border-[color:var(--color-ink)]">
      {brlmName && (
        <div class="pt-6 pr-8 pb-8 border-b sm:border-b-0 sm:border-r border-[color:var(--color-rule)]">
          <div class="stat-label mb-3">Book-running lead manager</div>
          <div class="serif text-[20px] leading-[1.3] text-[color:var(--color-ink-soft)]">{titleCase(brlmName)}</div>
          {brlm.meta && <p class="text-[12px] mute mt-2">{brlm.meta}</p>}
        </div>
      )}
      {registrarName && (
        <div class="pt-6 px-0 sm:px-8 pb-8 border-b sm:border-b-0 sm:border-r border-[color:var(--color-rule)]">
          <div class="stat-label mb-3">Registrar</div>
          <div class="serif text-[20px] leading-[1.3] text-[color:var(--color-ink-soft)]">{titleCase(registrarName)}</div>
          {registrar.meta && <p class="text-[12px] mute mt-2">{registrar.meta}</p>}
        </div>
      )}
      {sponsorName && (
        <div class="pt-6 pl-0 sm:pl-8 pb-8">
          <div class="stat-label mb-3">Sponsor bank</div>
          <div class="serif text-[20px] leading-[1.3] text-[color:var(--color-ink-soft)]">{titleCase(sponsorName)}</div>
        </div>
      )}
    </div>
  </section>
)}

<!-- EXCHANGE ISSUE DETAILS -->
{(visibleIssueInfoRows.length > 0 || offerMetadataRows.length > 0) && (
  <section id="filings" class="page-tight py-20">
    <header class="flex items-baseline justify-between mb-10">
      <h2 class="section-title">Exchange filings</h2>
      <span class="text-[12px] mute">Fields captured from NSE and BSE</span>
    </header>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
      {visibleIssueInfoRows.length > 0 && (
        <div>
          <div class="label mb-5">Issue information</div>
          <dl class="border-t border-[color:var(--color-rule-strong)]">
            {visibleIssueInfoRows.map((row) => (
              <div class="grid grid-cols-1 sm:grid-cols-[160px_minmax(0,1fr)] gap-1 sm:gap-5 py-5 border-b border-[color:var(--color-rule)]">
                <dt class="text-[12.5px] mute leading-snug">{row.title}</dt>
                <dd class="text-[15px] leading-snug min-w-0">
                  {row.href ? (
                    <a href={row.href} target="_blank" rel="noopener" class="hover:acc break-words">{row.value && row.value.startsWith('http') ? row.value : row.title}</a>
                  ) : (
                    <span class="break-words">{row.value}</span>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      )}
      {offerMetadataRows.length > 0 && (
        <div>
          <div class="label mb-5">Company and offer metadata</div>
          <dl class="border-t border-[color:var(--color-rule-strong)]">
            {offerMetadataRows.map((row) => (
              <div class="grid grid-cols-1 sm:grid-cols-[160px_minmax(0,1fr)] gap-1 sm:gap-5 py-5 border-b border-[color:var(--color-rule)]">
                <dt class="text-[12.5px] mute leading-snug">{row.title}</dt>
                <dd class="text-[15px] leading-snug min-w-0">
                  {row.href ? (
                    <a href={row.href} target="_blank" rel="noopener" class="hover:acc break-words">{row.value}</a>
                  ) : (
                    <span class="break-words">{row.value}</span>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      )}
    </div>
  </section>
)}

<!-- DOCUMENTS -->
{documents.length > 0 && (
  <section class="bg-[color:var(--color-paper-soft)]">
    <div class="page-tight py-20">
      <header class="mb-10">
        <h2 class="section-title">Documents</h2>
      </header>
      <ul class="list-none p-0 m-0 bg-white border border-[color:var(--color-rule-card)]">
        {documents.map((doc: any, idx: number) => (
          <li>
            <a href={doc.url} target="_blank" rel="noopener" class={`flex items-baseline justify-between gap-6 py-5 px-6 group ${idx < documents.length - 1 ? 'border-b border-[color:var(--color-rule)]' : ''}`}>
              <span class="serif font-medium text-[16px] group-hover:acc transition-colors">{doc.type}</span>
              <span class="text-[12px] mute num">{doc.source_date ?? doc.date ?? ''}</span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
)}

<!-- PROVENANCE -->
<section class="page-tight pt-10 pb-16 border-t border-[color:var(--color-rule)]">
  <p class="text-[11.5px] mute leading-[1.6] max-w-[70ch]">
    Data sources:
    {(issue.sources ?? []).map((s: any, i: number) => (
      <>
        {i > 0 ? ', ' : ' '}
        <span>{String(s.source ?? '').toUpperCase()}</span>
      </>
    ))}.
    Data quality <span class="num">{issue.data_quality?.state ?? 'unknown'}</span>{issue.data_quality?.warning_count ? <>, {issue.data_quality.warning_count} warning{issue.data_quality.warning_count === 1 ? '' : 's'}</> : null}.
  </p>
</section>

</Base>
