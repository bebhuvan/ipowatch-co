      {issue.subscription.trajectory.length > 1 && (
        <div class={`${subscriptionRows.length > 0 ? 'mt-16' : ''}`}>
          <header class="mb-8">
            <h2 class="section-title">Subscription over time</h2>
          </header>
          <div class="max-w-[1080px]">
            <TrajectoryChart observations={issue.subscription.trajectory} />
          </div>
        </div>
      )}

      {bidBook.length > 0 && (
        <div class={`${subscriptionRows.length > 0 || issue.subscription.trajectory.length > 1 ? 'mt-16' : ''}`}>
          <header class="flex items-baseline justify-between mb-8">
            <h2 class="section-title">Bid book by price</h2>
            <span class="text-[12px] mute">{bidBookSource === 'NSE' ? 'cumulative NSE demand' : 'where the demand sits'}</span>
          </header>
          <div class="space-y-2 max-w-[980px]">
            {bidBook.slice().sort((a, b) => b.price - a.price).map((row) => {
              const pct = bidBookMaxQty > 0 ? (row.quantity / bidBookMaxQty) * 100 : 0;
              const isCutoff = priceMax != null && row.price === priceMax;
              return (
                <div class="grid grid-cols-[86px_minmax(0,1fr)] sm:grid-cols-[108px_minmax(0,1fr)_170px] items-center gap-3 sm:gap-5 num py-1">
