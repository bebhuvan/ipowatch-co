---
import Base from '../layouts/Base.astro';
import { getIPOSchemas } from '../lib/seo';
import TrajectoryChart from './TrajectoryChart.astro';
import {
  formatDateLong,
  formatDateShort,
  formatInt,
  formatRupee,
  formatRupeeRange,
  formatTimes,
  formatLakhCr,
  daysFromNow,
} from '../lib/format';
import {
  extractIngredient,
  type IssueDetail,
} from '../lib/issues';

const { issue, reportHref = null } = Astro.props as { issue: IssueDetail; reportHref?: string | null };
const today = new Date();

const status = issue.classification.status;
const company = issue.company.name ?? '';
const exchange = issue.classification.exchange_platform ?? '—';
const issueType = issue.classification.issue_type ?? 'IPO';

const exch = (issue.exchange_details ?? {}) as any;
const bseDetail = exch.bse?.issue_detail?.data?.IPONO_0?.[0] ?? null;
const nseIssueInfo = (exch.nse?.issue_detail?.data?.issueInfo?.dataList ?? []) as any[];
const nseOfferRows = (exch.nse?.offer_document_detail?.data?.data?.InPrincipal ?? []) as any[];

const splitParty = (raw: string | null | undefined): { name: string | null; meta: string | null } => {
  if (!raw) return { name: null, meta: null };
  const [first, ...rest] = String(raw).split('^');
  const meta = rest.join('^').split('|')[0]?.replace(/\s+/g, ' ').trim() || null;
  return { name: first?.trim() || null, meta };
};
const brlm = splitParty(bseDetail?.Book_Running_Lead_Manager);
const registrar = splitParty(bseDetail?.Registrar);
const sponsor = splitParty(bseDetail?.Sponsor_Bank);
const leadManagerNames = issue.parties?.lead_managers ?? [];
const brlmName = brlm.name ?? (leadManagerNames.length ? leadManagerNames.join(', ') : null);
const registrarName = registrar.name ?? issue.parties?.registrar ?? null;
const sponsorName = sponsor.name ?? issue.parties?.sponsor_bank ?? null;

// Exchange data often sends party names in ALL CAPS — convert to title case for display.
const _abbrevs = new Set(['IPO', 'NSE', 'BSE', 'SEBI', 'LLP', 'NBFC', 'AMC', 'AIF', 'SBI', 'HDFC', 'ICICI', 'IIFL', 'JM', 'SPA', 'BOI', 'PTC', 'UTI']);
const titleCase = (str: string | null | undefined): string | null => {
  if (!str) return null;
  return str.replace(/\b([A-Z][A-Z0-9]*)\b/g, (word) => {
    if (_abbrevs.has(word)) return word;
    return word.charAt(0) + word.slice(1).toLowerCase();
  }).replace(/\bPvt\b/g, 'Pvt').replace(/\bLtd\b/g, 'Ltd').replace(/\bPte\b/g, 'Pte');
};

const ing = extractIngredient(issue);
const priceMin = ing.priceMin;
const priceMax = ing.priceMax;
const lotSize = ing.lotSize;
const sharesOffered = ing.sharesOffered;
const faceValue = ing.faceValue;

const minInvestment = lotSize != null && priceMax != null ? lotSize * priceMax : null;
const subscribed = issue.subscription.trajectory.length
  ? issue.subscription.trajectory[issue.subscription.trajectory.length - 1].total?.times ?? issue.subscription.times
  : issue.subscription.times;
const lastTrajectory = issue.subscription.trajectory.length
  ? issue.subscription.trajectory[issue.subscription.trajectory.length - 1]
  : null;

const parseNum = (value: unknown): number | null => {
  if (typeof value === 'number') return Number.isFinite(value) ? value : null;
  if (typeof value !== 'string') return null;
  const cleaned = value.replace(/,/g, '').trim();
  if (!cleaned || cleaned === '-') return null;
  const n = Number(cleaned);
  return Number.isFinite(n) ? n : null;
};

const cleanCell = (value: unknown): string | null => {
  if (value == null) return null;
  const text = String(value).replace(/^"+|"+$/g, '').replace(/\s+/g, ' ').trim();
  return text && text !== '-' ? text : null;
};

const hrefFromValue = (value: unknown): string | null => {
  if (typeof value !== 'string') return null;
  const html = value.match(/href=([^ >]+)/i)?.[1]?.replace(/^["']|["']$/g, '');
  if (html) return html;
  return value.startsWith('http') ? value : null;
};

const CATEGORY_LABELS: Record<string, string> = {
  // Top-level
  qib:          'QIB — Qualified Institutional Buyers',
  nii:          'NII — Non-Institutional Investors',
  retail:       'Retail Individual Investors',
  employee:     'Employee',
  shareholder:  'Shareholder',
  policyholder: 'Policyholder',
  // QIB sub-categories
  qib_fii:      'QIB · FII / FPI',
  qib_dfi:      'QIB · Domestic Financial Institutions',
  qib_mf:       'QIB · Mutual Funds',
  qib_other:    'QIB · Others',
  // NII sub-categories (big NII = bNII, small NII = sNII)
  nii_gt_10l:   'NII · Big (> ₹10 lakh)',
  nii_lte_10l:  'NII · Small (≤ ₹10 lakh)',
  nii_hni:      'NII · HNI / High Net-worth',
  // Other common aliases
  dii:          'DII — Domestic Institutional Investors',
  anchor:       'Anchor Investors',
  total:        'Total',
};
const labelize = (key: string) => {
  const lower = (key ?? '').toLowerCase().replace(/\s+/g, '_');
  if (CATEGORY_LABELS[lower]) return CATEGORY_LABELS[lower];
  // BSE/NSE sometimes send verbose strings — normalise before fallback
  const norm = key
    .replace(/_/g, ' ')
    .replace(/([a-z])([A-Z])/g, '$1 $2')
    .replace(/\s+/g, ' ')
    .trim()
    .replace(/\b\w/g, (c) => c.toUpperCase());
  return norm;
};

// Bid book / demand by price. BSE exposes exact quantity; NSE exposes cumulative demand.
type BidBookRow = { price: number; quantity: number; timestamp: string | null; source: string };
const isBidBookRow = (row: { price: number | null; quantity: number | null; timestamp: string | null; source: string }): row is BidBookRow =>
  row.price != null && row.quantity != null;
const bseBidRows: BidBookRow[] = (((exch.bse?.issue_detail?.data?.IPONO_2 ?? []) as any[])
  .map((r: any) => ({ price: parseNum(r.Price), quantity: parseNum(r.Quantity), timestamp: cleanCell(r.process_dttm), source: 'BSE' }))
  .filter(isBidBookRow));
const nseDemandRows: BidBookRow[] = (((exch.nse?.demand_data?.nse?.rows ?? exch.nse?.issue_detail?.data?.demandDataNSE ?? []) as any[])
  .map((r: any) => ({ price: parseNum(r.price), quantity: parseNum(r.cumQty), timestamp: cleanCell(r.timestamp), source: 'NSE' }))
  .filter(isBidBookRow));
const latestDemandCurve = (issue.subscription.demand_curves ?? [])
  .slice()
  .sort((a, b) => (b.observed_at ?? '').localeCompare(a.observed_at ?? ''))[0] ?? null;
const v3DemandRows: BidBookRow[] = latestDemandCurve
  ? latestDemandCurve.points.map((point) => ({
    price: point.price,
    quantity: point.cumulative_quantity,
    timestamp: latestDemandCurve.source_updated_at,
    source: latestDemandCurve.scope === 'all' ? 'NSE all-exchange' : 'NSE',
  }))
  : [];
const bidBook = bseBidRows.length ? bseBidRows : nseDemandRows.length ? nseDemandRows : v3DemandRows;
const bidBookMaxQty = bidBook.length ? Math.max(...bidBook.map((r) => r.quantity)) : 0;
const bidBookSource = bidBook[0]?.source ?? null;
const demandGraph = exch.nse?.issue_detail?.data?.demandGraph ?? null;

const sizeText = sharesOffered && priceMax != null
  ? formatLakhCr(sharesOffered * priceMax)
  : issue.issue_size?.text ?? null;

const statusLabel = status === 'current' ? 'open' : status === 'upcoming' ? 'upcoming' : status === 'past' ? 'listed' : 'filed';
const tagLine = [issueType, exchange].filter(Boolean).join('  ·  ');

const dateLine = (() => {
  if (status === 'current') {
    const d = daysFromNow(issue.timeline.close_date, today);
    if (d === 0) return 'closes today';
    if (d === 1) return 'closes tomorrow';
    if (d != null && d > 0) return `closes ${formatDateShort(issue.timeline.close_date)}`;
    return 'closed';
  }
  if (status === 'upcoming') return `opens ${formatDateLong(issue.timeline.open_date)}`;
  if (status === 'past') return issue.timeline.listing_date ? `listed ${formatDateLong(issue.timeline.listing_date)}` : '';
  return '';
})();

const standfirst = (() => {
  const parts: string[] = [];
  if (status === 'current') {
    if (sizeText) parts.push(`Raising ${sizeText}`);
    if (priceMin != null && priceMax != null) parts.push(`at ${formatRupeeRange(priceMin, priceMax)} per share`);
  } else if (status === 'upcoming') {
    if (sizeText) parts.push(`Will raise ${sizeText}`);
    if (priceMin != null && priceMax != null) parts.push(`at ${formatRupeeRange(priceMin, priceMax)} per share`);
  } else if (status === 'past' && issue.timeline.listing_date) {
    if (sizeText) parts.push(`Raised ${sizeText}`);
    const ip = issue.pricing.issue_price ?? priceMax;
    if (ip != null) parts.push(`at ${formatRupee(ip)} per share`);
  }
  return parts.join(' ');
})();

const heroFigure = (() => {
  if (status === 'current') {
    if (subscribed != null) return { value: formatTimes(subscribed), label: 'total subscription so far' };
    if (priceMin != null && priceMax != null) return { value: formatRupeeRange(priceMin, priceMax), label: 'price band per share' };
    return null;
  }
  if (status === 'upcoming') {
    if (priceMin != null && priceMax != null) return { value: formatRupeeRange(priceMin, priceMax), label: 'price band per share' };
    if (issue.pricing.issue_price != null) return { value: formatRupee(issue.pricing.issue_price), label: 'issue price' };
    return null;
  }
  if (status === 'past') {
    const g = issue.listing_performance.listing_day_gain;
    if (g != null) return { value: `${g > 0 ? '+' : ''}${g.toFixed(1)}%`, label: 'listing-day move', isGain: true, gain: g };
    return null;
  }
  return null;
})();

const documentOrder = ['DRHP', 'RHP', 'Prospectus', 'Final prospectus', 'Price Band Advertisement', 'Public issue advertisement'];
const documents = (issue.documents ?? []).slice().sort((a: any, b: any) => {
  const ai = documentOrder.indexOf(a.type);
  const bi = documentOrder.indexOf(b.type);
  return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
});

const fmtGain = (g: number | null | undefined) => g == null ? '—' : `${g > 0 ? '+' : ''}${g.toFixed(2)}%`;

type SplitRow = { key: string; label: string; times: number; offered: number | null; bid: number | null };
const splitRows: SplitRow[] = (() => {
  if (!lastTrajectory) return [];
  const order = [
    { key: 'qib', label: CATEGORY_LABELS['qib'] },
    { key: 'nii', label: CATEGORY_LABELS['nii'] },
    { key: 'retail', label: CATEGORY_LABELS['retail'] },
    { key: 'employee', label: CATEGORY_LABELS['employee'] },
    { key: 'shareholder', label: CATEGORY_LABELS['shareholder'] },
  ];
  return order.map(({ key, label }) => {
    const c = lastTrajectory.categories[key];
    if (!c || c.times == null) return null;
    return { key, label, times: c.times, offered: c.shares_offered, bid: c.shares_bid };
  }).filter((x): x is SplitRow => x != null);
})();

type SubscriptionRow = {
  sr: string | null;
  category: string;
  offered: number | null;
  bid: number | null;
  applications: number | null;
  times: number | null;
};

const subscriptionRows: SubscriptionRow[] = (() => {
  if (issue.subscription.consolidated?.categories.length) {
    return [
      ...(issue.subscription.consolidated.total_times != null ? [{
        sr: null,
        category: 'Total',
        offered: null,
        bid: null,
        times: issue.subscription.consolidated.total_times,
        applications: null,
      }] : []),
      ...issue.subscription.consolidated.categories.map((row, idx) => ({
        sr: String(idx + 1),
        category: labelize(row.category),
        offered: row.shares_offered,
        bid: row.shares_bid,
        times: row.times,
        applications: row.applications ?? null,
      })),
    ];
  }

  const bseRows = ((exch.bse?.consolidated_bid_details?.rows ?? exch.bse?.bid_details?.rows ?? []) as any[]);
  if (bseRows.length) {
    return bseRows.map((r) => ({
      sr: cleanCell(r.SRNo),
      category: cleanCell(r.col2) ?? '',
      offered: parseNum(r.col3),
      bid: parseNum(r.col4),
      times: parseNum(r.col5),
      applications: parseNum(r.col8),
    })).filter((r) => r.category && r.category.toLowerCase() !== 'category');
  }

  const nseRows = ((exch.nse?.bid_details?.rows ?? exch.nse?.issue_detail?.data?.bidDetails ?? []) as any[]);
  if (nseRows.length) {
    return nseRows.map((r) => ({
      sr: cleanCell(r.srNo),
      category: cleanCell(r.category) ?? '',
      offered: null,
      bid: parseNum(r.noOfshareBid ?? r.noOfSharesBid),
      times: null,
      applications: parseNum(r.noofapplication),
    })).filter((r) => r.category && r.category.toLowerCase() !== 'category');
  }

  const exchangeBook = issue.subscription.by_exchange.nse ?? issue.subscription.by_exchange.bse ?? null;
  if (exchangeBook?.categories?.length) {
    return exchangeBook.categories.map((row, idx) => ({
      sr: String(idx + 1),
      category: labelize(row.category),
      offered: row.shares_offered,
      bid: row.shares_bid,
      times: row.times,
      applications: row.applications ?? null,
    }));
  }

  return splitRows.map((r) => ({
    sr: null,
    category: r.label,
    offered: r.offered,
    bid: r.bid,
    times: r.times,
    applications: null,
  }));
})();
const subscriptionMax = subscriptionRows.length
  ? Math.max(...subscriptionRows.map((r) => r.times ?? (r.bid ?? 0)), 1)
  : 0;
const isMajorSubscriptionCategory = (category: string) => {
  const text = category.toLowerCase();
  return text === 'total' ||
    text.startsWith('qib') && !text.includes('·') ||   // top-level QIB, not sub-category
    text.startsWith('nii') && !text.includes('·') ||   // top-level NII
    text.includes('qualified institutional buyers') ||
    text === 'non institutional investors' ||
    text.includes('retail individual') ||
    text.includes('individual investors (ind category bidding for 2 lots') ||
    text === 'employee' ||
    text === 'shareholder';
};
const subscriptionTotalRow = subscriptionRows.find((row) => row.category.toLowerCase() === 'total') ?? null;
const subscriptionVisualRows = subscriptionRows
  .filter((row) => row.category.toLowerCase() !== 'total')
  .filter((row) => {
    // Hide categories with no meaningful data: bid=0, times=null, offered=null.
    // Keep rows with offered > 0 even if bid=0 (shares allocated but nobody bid).
    const hasBid = row.bid != null && row.bid > 0;
    const hasTimes = row.times != null && row.times > 0;
    const hasOffered = row.offered != null && row.offered > 0;
    const hasApps = row.applications != null && row.applications > 0;
    return hasBid || hasTimes || hasOffered || hasApps;
  })
  .map((row) => ({
    ...row,
    metric: row.times ?? row.bid ?? 0,
    isChild: !isMajorSubscriptionCategory(row.category),
  }));
const subscriptionLeaderMetric = subscriptionVisualRows.length
  ? Math.max(...subscriptionVisualRows.map((row) => row.metric))
  : 0;
const subscriptionSourceObservedAt = issue.sources
  .filter((source) => source.source.toLowerCase() === 'bse' && source.endpoint.includes('bid_details'))
  .map((source) => source.observed_at)
  .filter(Boolean)
  .sort()
  .at(-1) ?? null;
const formatObservedAt = (value: string | null): string | null => {
  if (!value) return null;
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return null;
  return `${date.toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', hour12: true, timeZone: 'Asia/Kolkata' })} IST`;
};
const subscriptionUpdatedAt =
  cleanCell(exch.bse?.consolidated_bid_details?.rows?.[1]?.Maxdt) ??
  cleanCell(exch.bse?.bid_details?.rows?.[1]?.Maxdt) ??
  cleanCell(exch.nse?.demand_data?.nse?.rows?.[0]?.timestamp) ??
  cleanCell(exch.nse?.issue_detail?.data?.demandGraph?.timestamp) ??
  formatObservedAt(lastTrajectory?.observed_at ?? null) ??
  formatObservedAt(subscriptionSourceObservedAt);
const subscriptionAllZero = subscriptionRows.length > 0 && subscriptionRows.every((row) =>
  (row.bid == null || row.bid === 0) &&
  (row.times == null || row.times === 0) &&
  (row.applications == null || row.applications === 0)
);

const issueInfoRows = nseIssueInfo
  .map((row) => ({
    title: cleanCell(row.title) ?? 'Exchange note',
    value: cleanCell(row.value),
    href: hrefFromValue(row.value),
  }))
  .filter((row) => row.value || row.href);
const canonicalIssueInfoRows = issue.exchange_issue_info ?? [];
const visibleIssueInfoRows = issueInfoRows.length ? issueInfoRows : canonicalIssueInfoRows;

const offerMetadataRows = nseOfferRows.flatMap((row) => {
  const wanted = [
    'industry',
    'mode_Of_Issue',
    'eligibility_Of_The_Issue',
    'tentative_No_of_Shares',
    'estimated_Total_Issue_Amount',
    'name_Of_LM_BRLM',
    'name_Of_RTA',
    'name_Of_Promoter',
    'name_Of_Market_Maker',
    'name_Of_Company_Secretary_And_Compliance_Officer',
    'website',
    'registered_Office_Region',
    'registered_Office_Address',
    'corporate_Office_Address',
    'isin',
    'corporate_Identity_Number',
  ];
  return wanted.map((key) => ({ title: labelize(key), value: cleanCell(row[key]), href: hrefFromValue(row[key]) })).filter((r) => r.value || r.href);
});

type FactLeaf = {
  value?: unknown;
  raw_excerpt?: string | null;
  source_page?: number | null;
  source_section?: string | null;
  confidence?: string | null;
};
type FactItem = { label: string; value: string; rawValue: unknown; page: number | null; section: string | null; confidence: string | null };

const isFactLeaf = (value: unknown): value is FactLeaf =>
  Boolean(value && typeof value === 'object' && 'value' in (value as Record<string, unknown>));

const readableFactText = (text: string): string => {
  const companyName = company || 'the company';
  return text
    .replace(/\s+/g, ' ')
    .trim()
    .replace(/\bOur Corporate Promoter\b/g, 'the corporate promoter')
    .replace(/\bour Corporate Promoter\b/g, 'the corporate promoter')
    .replace(/\bOur Holding Company\b/g, 'the holding company')
    .replace(/\bour Holding Company\b/g, 'the holding company')
    .replace(/\bOur Promoters\b/g, 'the promoters')
    .replace(/\bour Promoters\b/g, 'the promoters')
    .replace(/\bOur Directors\b/g, 'the directors')
    .replace(/\bour Directors\b/g, 'the directors')
    .replace(/\bOur Group Company\b/g, 'the group company')
    .replace(/\bour Group Company\b/g, 'the group company')
    .replace(/\bOur Company\b/g, companyName)
    .replace(/\bour Company\b/g, companyName)
    .replace(/\bWe have\b/g, `${companyName} has`)
    .replace(/\bwe have\b/g, `${companyName} has`)
    .replace(/\bWe are\b/g, `${companyName} is`)
    .replace(/\bwe are\b/g, `${companyName} is`)
    .replace(/\bWe derive\b/g, `${companyName} derives`)
    .replace(/\bwe derive\b/g, `${companyName} derives`)
    .replace(/\bWe operate\b/g, `${companyName} operates`)
    .replace(/\bwe operate\b/g, `${companyName} operates`)
    .replace(/\bWe cannot assure\b/g, `${companyName} cannot assure`)
    .replace(/\bwe cannot assure\b/g, `${companyName} cannot assure`)
    .replace(/\bwe sell\b/g, 'it sells')
    .replace(/\bwe will not\b/g, 'it will not')
    .replace(/^Derive\b/g, `${companyName} derives`)
    .replace(/\bour products\b/g, 'its products')
    .replace(/\bour customers\b/g, 'its customers')
    .replace(/\bour raw material suppliers\b/g, 'its raw material suppliers')
    .replace(/\bour business\b/g, 'its business')
    .replace(/\bour operations\b/g, 'its operations')
    .replace(/\bour results\b/g, 'its results')
    .replace(/\bour cash flows\b/g, 'its cash flows')
    .replace(/\bour financial condition\b/g, 'its financial condition')
    .replace(/\bour manufacturing facility\b/g, 'its manufacturing facility')
    .replace(/\bour visibility and brand\b/g, 'its visibility and brand')
    .replace(/\bour logo\b/g, 'its logo');
};

const factText = (value: unknown): string | null => {
  if (value == null || value === '') return null;
  if (typeof value === 'number') return value.toLocaleString('en-IN');
  if (typeof value === 'string') return readableFactText(value) || null;
  return null;
};

const factItem = (label: string, leaf: unknown): FactItem | null => {
  if (!isFactLeaf(leaf)) return null;
  const value = factText(leaf.value);
  if (!value) return null;
  return {
    label,
    value,
    rawValue: leaf.value,
    page: typeof leaf.source_page === 'number' ? leaf.source_page : null,
    section: leaf.source_section ?? null,
    confidence: leaf.confidence ?? null,
  };
};

const factList = (label: string, values: unknown, limit = 6): FactItem[] =>
  Array.isArray(values)
    ? values.map((leaf) => factItem(label, leaf)).filter((leaf): leaf is FactItem => leaf != null).slice(0, limit)
    : [];

const uniqueFacts = (items: FactItem[], limit = items.length): FactItem[] => {
  const seen = new Set<string>();
  const out: FactItem[] = [];
  for (const item of items) {
    const key = (item.label + ":" + item.value).toLowerCase();
    if (seen.has(key)) continue;
    seen.add(key);
    out.push(item);
    if (out.length >= limit) break;
  }
  return out;
};

const sourcePages = (items: (FactItem | null | undefined)[], limit = 6): string | null => {
  const pages = Array.from(new Set(items
    .map((item) => item?.page)
    .filter((page): page is number => typeof page === "number")))
    .sort((a, b) => a - b)
    .slice(0, limit);
  return pages.length ? "Source: DRHP p." + pages.join(", p.") : null;
};

const sentenceJoin = (items: string[]) => {
  const cleaned = items.map((item) => item.trim()).filter(Boolean);
  if (!cleaned.length) return null;
  return cleaned.map((item) => item.endsWith(".") ? item : item + ".").join(" ");
};

const stripTerminalPeriod = (value: string) => value.replace(/[.;]\s*$/g, '');
const lowerFirst = (value: string) => {
  if (!value || /^[A-Z]{2,}\b/.test(value)) return value;
  return value.charAt(0).toLowerCase() + value.slice(1);
};
const sentence = (value: string | null | undefined) => {
  if (!value) return null;
  const trimmed = value.trim();
  return trimmed.endsWith('.') ? trimmed : `${trimmed}.`;
};
const firstFact = (values: unknown, fallbackLabel: string): FactItem | null =>
  Array.isArray(values)
    ? values.map((leaf) => factItem(fallbackLabel, leaf)).find((leaf): leaf is FactItem => leaf != null) ?? null
    : factItem(fallbackLabel, values);

type ChartPoint = { label: string; value: number; source: FactItem };
const numericFactSeries = (label: string, values: unknown, periodValues: unknown, limit = 8): ChartPoint[] => {
  if (!Array.isArray(values)) return [];
  const periods = Array.isArray(periodValues)
    ? periodValues.map((leaf) => isFactLeaf(leaf) ? factText(leaf.value) : factText(leaf))
    : [];
  return values
    .map((leaf, idx) => {
      const fact = factItem(label, leaf);
      if (!fact) return null;
      const n = typeof fact.rawValue === 'number' ? fact.rawValue : parseNum(fact.value);
      if (n == null) return null;
      return {
        label: periods[idx] ?? `P${idx + 1}`,
        value: n,
        source: fact,
      };
    })
    .filter((row): row is ChartPoint => row != null)
    .slice(0, limit);
};

const chartGeometry = (rows: ChartPoint[], width = 620, height = 220, pad = 28) => {
  if (!rows.length) return { width, height, zeroY: height - pad, points: '', bars: [] as { x: number; y: number; h: number; w: number; row: ChartPoint }[] };
  const values = rows.map((row) => row.value);
  const min = Math.min(0, ...values);
  const max = Math.max(0, ...values);
  const spread = max - min || 1;
  const xStep = rows.length > 1 ? (width - pad * 2) / (rows.length - 1) : 0;
  const yFor = (value: number) => height - pad - ((value - min) / spread) * (height - pad * 2);
  const zeroY = yFor(0);
  const barSlot = (width - pad * 2) / Math.max(rows.length, 1);
  const barW = Math.max(12, Math.min(42, barSlot * 0.56));
  return {
    width,
    height,
    zeroY,
    points: rows.map((row, idx) => `${pad + idx * xStep},${yFor(row.value)}`).join(' '),
    bars: rows.map((row, idx) => {
      const x = pad + idx * barSlot + (barSlot - barW) / 2;
      const y = Math.min(yFor(row.value), zeroY);
      const h = Math.max(2, Math.abs(zeroY - yFor(row.value)));
      return { x, y, h, w: barW, row };
    }),
  };
};

const pctFromText = (text: string): number | null => {
  const match = text.match(/(\d+(?:\.\d+)?)\s*%/);
  if (!match) return null;
  const pct = Number(match[1]);
  return Number.isFinite(pct) ? pct : null;
};

const prospectus = issue.prospectus_facts;
const prospectusQuality = prospectus?.quality ?? null;
const facts = prospectus?.facts ?? {};
const businessFacts = facts.business?.business ?? {};
const industryFacts = facts.industry?.industry ?? {};
const financialFacts = facts.financials?.financials ?? {};
const riskFacts = facts.risks?.risks ?? {};
const offerFacts = facts.offer?.offer ?? {};
const issueTermFacts = facts.issue_terms?.issue_terms ?? {};
const intermediaryFacts = facts.intermediaries?.intermediaries ?? {};
const valuationFacts = facts.valuation_and_peers?.valuation_and_peers ?? {};
const governanceFacts = facts.governance?.governance ?? {};
const hasVerifiedProspectus = Boolean(prospectus?.deepseek?.used && prospectusQuality?.state !== 'fail');

const companyDescriptionFact = factItem('Company', businessFacts.company_description);
const businessModelFact = factItem('Business model', businessFacts.business_model);
const industryNameFact = factItem('Industry', industryFacts.industry_name);
const riskCountFact = factItem('Risk-factor count', riskFacts.risk_factor_count);
const issueStructureFact = factItem('Issue structure', offerFacts.issue_structure);
const freshIssueFact = factItem('Fresh issue', offerFacts.fresh_issue);
const ofsFact = factItem('Offer for sale', offerFacts.offer_for_sale);

const businessSnapshot = [
  ...factList('Product/service', businessFacts.products_services, 6),
  ...factList('Competitive strength', businessFacts.competitive_strengths, 4),
  ...factList('Key dependency', businessFacts.key_dependencies, 3),
  ...factList('Geography', businessFacts.geographies, 2),
];
const industrySnapshot = [
  factItem('Industry', industryFacts.industry_name),
  ...factList('Market size', industryFacts.market_size, 4),
  ...factList('Growth driver', industryFacts.drivers, 4),
  ...factList('Regulatory context', industryFacts.regulatory_context, 4),
].filter((leaf): leaf is FactItem => leaf != null);
const financialRows = [
  ...factList('Revenue', financialFacts.revenue, 4),
  ...factList('Profit after tax', financialFacts.pat, 4),
  ...factList('Operating cash flow', financialFacts.cash_flow, 4),
];
const riskRows = [
  ...factList('Top risk', riskFacts.top_risks, 5),
  ...factList('Customer/supplier risk', riskFacts.customer_supplier_risks, 4),
  ...factList('Financial risk', riskFacts.financial_risks, 4),
  ...factList('Regulatory risk', riskFacts.regulatory_risks, 4),
  ...factList('Promoter/legal risk', riskFacts.promoter_legal_risks, 3),
  ...factList('Issue-specific risk', riskFacts.issue_specific_risks, 3),
  ...factList('Red flag', riskFacts.red_flags, 5),
].slice(0, 14);
const advisorRows = [
  ...factList('Lead manager', offerFacts.lead_managers, 4),
  ...factList('Lead manager', intermediaryFacts.lead_managers, 4),
  factItem('Registrar', offerFacts.registrar),
  factItem('Registrar', intermediaryFacts.registrar),
  ...factList('Listing exchange', issueTermFacts.listing_exchanges, 3),
  ...factList('Listing exchange', intermediaryFacts.listing_exchanges, 3),
  ...factList('Object of issue', offerFacts.objects_of_issue, 4),
].filter((leaf): leaf is FactItem => leaf != null);
const issueTermRows = uniqueFacts([
  factItem('Exchange/platform', issueTermFacts.exchange_platform),
  factItem('Price band lower', issueTermFacts.price_band_lower),
  factItem('Price band upper', issueTermFacts.price_band_upper),
  factItem('Issue price', issueTermFacts.issue_price),
  factItem('Lot size', issueTermFacts.lot_size),
  factItem('Minimum application', issueTermFacts.minimum_application_amount),
  ...factList('Category reservation', issueTermFacts.category_reservation, 5),
  ...factList('Issue timetable', issueTermFacts.issue_timetable, 5),
  factItem('Basis of allotment', issueTermFacts.basis_of_allotment),
  factItem('Refund/unblocking', issueTermFacts.refund_or_unblocking),
  factItem('Credit of shares', issueTermFacts.credit_of_shares),
  factItem('Listing date', issueTermFacts.listing_date),
].filter((leaf): leaf is FactItem => leaf != null), 12);
const valuationRows = [
  ...factList('Valuation metric', valuationFacts.valuation_metrics, 4),
  ...factList('EPS / NAV / RoNW', valuationFacts.eps_nav_ronw, 4),
  ...factList('Peer comparison', valuationFacts.peer_comparison, 4),
].slice(0, 10);
const governanceRows = [
  ...factList('Promoter', governanceFacts.promoters, 4),
  ...factList('Director', governanceFacts.directors, 4),
  ...factList('KMP', governanceFacts.kmp, 4),
  ...factList('Litigation', governanceFacts.litigation, 4),
  ...factList('Regulatory action', governanceFacts.regulatory_actions, 3),
  ...factList('Default/dues', governanceFacts.defaults_or_dues, 3),
  ...factList('Promoter legal flag', governanceFacts.promoter_legal_flags, 3),
  ...factList('Related-party transaction', governanceFacts.related_party_transactions, 4),
].slice(0, 12);
const prospectusLead = sentenceJoin([
  companyDescriptionFact?.value ?? '',
  businessModelFact?.value ?? '',
  industryNameFact ? `The filing places the company in ${industryNameFact.value}` : '',
  issueStructureFact ? `The offer is described as ${issueStructureFact.value}` : '',
]);
const businessNarrativeFacts = uniqueFacts([
  companyDescriptionFact,
  businessModelFact,
  industryNameFact,
  ...businessSnapshot,
].filter((leaf): leaf is FactItem => leaf != null), 8);
const offerNarrativeFacts = uniqueFacts([
  issueStructureFact,
  freshIssueFact,
  ofsFact,
  ...advisorRows,
  ...issueTermRows,
].filter((leaf): leaf is FactItem => leaf != null), 12);
const financialNarrativeRows = uniqueFacts(financialRows, 8);
const riskNarrativeRows = uniqueFacts([
  riskCountFact,
  ...riskRows,
].filter((leaf): leaf is FactItem => leaf != null), 10);
const governanceNarrativeRows = uniqueFacts(governanceRows, 10);
const hasProspectusNarrative = Boolean(
  prospectusLead ||
  businessNarrativeFacts.length ||
  offerNarrativeFacts.length ||
  financialNarrativeRows.length ||
  riskNarrativeRows.length ||
  valuationRows.length ||
  governanceNarrativeRows.length
);

const articleCompanyDescription = companyDescriptionFact?.value ?? null;
const articleBusinessModel = businessModelFact?.value ?? null;
const articleIndustryName = industryNameFact?.value ?? offerMetadataRows.find((row) => row.title === 'Industry')?.value ?? null;
const articleProducts = uniqueFacts(factList('Product line', businessFacts.products_services, 8), 8);
const articleStrengths = uniqueFacts(factList('Strength', businessFacts.competitive_strengths, 8), 8);
const articleCustomers = uniqueFacts(factList('Customer concentration', businessFacts.customers, 4), 4);
const articleDependencies = uniqueFacts(factList('Dependency', businessFacts.key_dependencies, 4), 4);
const articleGeographies = uniqueFacts(factList('Geography', businessFacts.geographies, 4), 4);
const articleMarketSizes = uniqueFacts(factList('Market size', industryFacts.market_size, 8), 8);
const articleGrowthRates = uniqueFacts(factList('Growth rate', industryFacts.growth_rates, 8), 8);
const articleDrivers = uniqueFacts(factList('Driver', industryFacts.drivers, 8), 8);
const articleCompetition = uniqueFacts(factList('Competition', industryFacts.competition, 6), 6);
const articleHeadwinds = uniqueFacts(factList('Headwind', industryFacts.headwinds, 6), 6);
const articleRegulation = uniqueFacts(factList('Regulation', industryFacts.regulatory_context, 8), 8);
const articleObjects = uniqueFacts(factList('Object', offerFacts.objects_of_issue, 8), 8);
const articlePromoters = uniqueFacts(factList('Promoter', governanceFacts.promoters, 8), 8);
const articleShareholding = uniqueFacts(factList('Shareholding', governanceFacts.shareholding, 8), 8);
const articleLitigation = uniqueFacts(factList('Litigation', governanceFacts.litigation, 5), 5);
const articleRelatedParty = uniqueFacts(factList('Related party', governanceFacts.related_party_transactions, 4), 4);
const articleCapital = uniqueFacts(factList('Capital structure', governanceFacts.capital_structure, 5), 5);
const articlePAT = numericFactSeries('Profit after tax', financialFacts.pat, financialFacts.periods, 8);
const articleCashFlow = numericFactSeries('Operating cash flow', financialFacts.cash_flow, financialFacts.periods, 8);
const articleAssets = numericFactSeries('Assets', financialFacts.assets, financialFacts.periods, 8);
const articleRatios = numericFactSeries('Return / ratio', financialFacts.ratios, financialFacts.periods, 8);
const primaryFinancialSeries = articlePAT.length >= 2 ? articlePAT : articleCashFlow.length >= 2 ? articleCashFlow : articleAssets;
const secondaryFinancialSeries = articleCashFlow.length >= 2 && primaryFinancialSeries !== articleCashFlow ? articleCashFlow : articleAssets.length >= 2 ? articleAssets : [];
const primaryChart = chartGeometry(primaryFinancialSeries);
const secondaryChart = chartGeometry(secondaryFinancialSeries);
const financialSourceFacts = [...primaryFinancialSeries.map((row) => row.source), ...secondaryFinancialSeries.map((row) => row.source)];
const financialTrendFacts = uniqueFacts([
  ...factList('Financial trend', financialFacts.notable_trends, 4),
  ...financialNarrativeRows,
], 8);

const shareholdingRows = articleShareholding
  .map((fact) => ({ ...fact, pct: pctFromText(fact.value) }))
  .filter((fact) => fact.pct != null)
  .slice(0, 4) as (FactItem & { pct: number })[];
const shareholdingSourceFacts = uniqueFacts([...articleShareholding, ...articlePromoters, ...articleCapital], 10);

const articleLeadParagraphs = [
  sentence(articleCompanyDescription),
  articleBusinessModel
    ? sentence(`The commercial hook is that ${lowerFirst(stripTerminalPeriod(articleBusinessModel))}`)
    : null,
  articleIndustryName
    ? sentence(`The DRHP places the company in ${articleIndustryName}, so the issue needs to be read as a sector-specific manufacturing and distribution story rather than only as an SME listing`)
    : null,
].filter((line): line is string => Boolean(line));

const businessParagraphs = [
  articleProducts.length
    ? sentence(`The operating mix covers ${articleProducts.map((fact) => stripTerminalPeriod(fact.value)).join(', ')}`)
    : null,
  articleStrengths.length
    ? sentence(`Management's own case rests on ${articleStrengths.slice(0, 5).map((fact) => lowerFirst(stripTerminalPeriod(fact.value))).join(', ')}`)
    : null,
  articleCustomers.length
    ? sentence(`The same filing also shows concentration risk: ${lowerFirst(stripTerminalPeriod(articleCustomers[0].value))}`)
    : null,
  articleDependencies.length
    ? sentence(`A key dependency is explicit in the DRHP: ${lowerFirst(stripTerminalPeriod(articleDependencies[0].value))}`)
    : null,
  articleGeographies.length
    ? sentence(`Geographically, the disclosed footprint includes ${articleGeographies.map((fact) => stripTerminalPeriod(fact.value)).join(', ')}`)
    : null,
].filter((line): line is string => Boolean(line));

const industryParagraphs = [
  articleIndustryName ? sentence(`This is a ${articleIndustryName} issue`) : null,
  articleMarketSizes.length || articleGrowthRates.length
    ? sentence(`The industry section gives a scale-and-growth frame: ${[...articleMarketSizes.slice(0, 3), ...articleGrowthRates.slice(0, 3)].map((fact) => stripTerminalPeriod(fact.value)).join('; ')}`)
    : null,
  articleDrivers.length
    ? sentence(`Demand drivers cited in the DRHP include ${articleDrivers.slice(0, 6).map((fact) => lowerFirst(stripTerminalPeriod(fact.value))).join(', ')}`)
    : null,
  articleCompetition.length || articleHeadwinds.length
    ? sentence(`The counterweight is competitive intensity: ${[...articleCompetition.slice(0, 3), ...articleHeadwinds.slice(0, 3)].map((fact) => lowerFirst(stripTerminalPeriod(fact.value))).join('; ')}`)
    : null,
].filter((line): line is string => Boolean(line));

const objectParagraph = articleObjects.length
  ? sentence(`The proceeds are not just a balance-sheet event: the named objects are ${articleObjects.map((fact) => lowerFirst(stripTerminalPeriod(fact.value))).join('; ')}`)
  : null;

const controlParagraph = shareholdingRows.length
  ? sentence(`Control is concentrated before the issue, with ${shareholdingRows.map((fact) => `${stripTerminalPeriod(fact.value)}`).join('; ')}`)
  : articlePromoters.length
    ? sentence(`The promoters identified in the DRHP include ${articlePromoters.slice(0, 5).map((fact) => stripTerminalPeriod(fact.value)).join(', ')}`)
    : null;

const riskThesisFacts = uniqueFacts([
  ...factList('Risk', riskFacts.top_risks, 6),
  ...factList('Customer/supplier risk', riskFacts.customer_supplier_risks, 4),
  ...factList('Financial risk', riskFacts.financial_risks, 5),
  ...factList('Regulatory risk', riskFacts.regulatory_risks, 5),
  ...factList('Red flag', riskFacts.red_flags, 5),
], 14);
const riskParagraphs = [
  riskCountFact ? sentence(`The DRHP lists ${riskCountFact.value} risk factors`) : null,
  riskThesisFacts[0] ? sentence(`The first layer is execution/legal risk: ${lowerFirst(stripTerminalPeriod(riskThesisFacts[0].value))}`) : null,
  articleCustomers.length ? sentence(`Customer concentration matters because ${lowerFirst(stripTerminalPeriod(articleCustomers[0].value))}`) : null,
  riskThesisFacts.find((fact) => fact.label === 'Financial risk')
    ? sentence(`Financial risk is also visible: ${lowerFirst(stripTerminalPeriod(riskThesisFacts.find((fact) => fact.label === 'Financial risk')!.value))}`)
    : null,
  riskThesisFacts.find((fact) => fact.label === 'Regulatory risk')
    ? sentence(`Regulatory risk is material because ${lowerFirst(stripTerminalPeriod(riskThesisFacts.find((fact) => fact.label === 'Regulatory risk')!.value))}`)
    : null,
].filter((line): line is string => Boolean(line));

const hasResearchArticle = Boolean(
  articleLeadParagraphs.length ||
  businessParagraphs.length ||
  industryParagraphs.length ||
  articleObjects.length ||
  primaryFinancialSeries.length ||
  shareholdingSourceFacts.length ||
  riskParagraphs.length
);

const tijori = issue.research?.tijori ?? null;
const tijoriValuationRows = tijori ? [
  { label: 'IPO size', value: tijori.valuation?.ipo_size },
  { label: 'Market cap', value: tijori.valuation?.market_cap },
  { label: 'P/E', value: tijori.valuation?.pe },
  { label: 'P/B', value: tijori.valuation?.pb },
  { label: 'Sector P/E', value: tijori.valuation?.sector_pe },
  { label: 'Sector P/B', value: tijori.valuation?.sector_pb },
].filter((row) => row.value != null && row.value !== '') : [];
const tijoriOfferRows = tijori ? [
  { label: 'Fresh issue', value: [tijori.offer_split?.fresh_issue_percent, tijori.offer_split?.fresh_issue_value].filter(Boolean).join(' · ') },
  { label: 'OFS / existing holders', value: [tijori.offer_split?.ofs_percent, tijori.offer_split?.ofs_value].filter(Boolean).join(' · ') },
].filter((row) => row.value) : [];
const tijoriFinancialRows = tijori?.financials?.yearly_results?.filter((row) =>
  row.period || row.net_sales_cr != null || row.pat_cr != null || row.debt_cr != null
) ?? [];
const tijoriRevenueRows = tijori?.revenue_mix?.latest?.filter((row) => row.segment && row.percent != null) ?? [];
const tijoriPeerRows = tijori?.peers?.filter((row) => row.company_name).slice(0, 6) ?? [];
const tijoriHoldingRows = tijori ? [
  { label: 'Promoter holding', pre: tijori.shareholding?.promoter?.pre_ipo, post: tijori.shareholding?.promoter?.post_ipo },
  { label: 'Public holding', pre: tijori.shareholding?.public?.pre_ipo, post: tijori.shareholding?.public?.post_ipo },
].filter((row) => row.pre || row.post) : [];
const fmtCr = (value: number | null | undefined) =>
  value == null ? '—' : `${value.toLocaleString('en-IN', { maximumFractionDigits: 2 })} Cr`;
const fmtMultiple = (value: number | string | null | undefined) =>
  value == null || value === '' ? '—' : typeof value === 'number' ? value.toLocaleString('en-IN', { maximumFractionDigits: 2 }) : value;
const hasTijoriResearch = Boolean(tijori && (
  tijori.business_description ||
  tijoriValuationRows.length ||
  tijoriOfferRows.length ||
  tijoriFinancialRows.length ||
  tijoriRevenueRows.length ||
  tijoriPeerRows.length ||
  tijoriHoldingRows.length
));

// Subscription window progress (current issues)
let progressPct = 0;
if (status === 'current' && issue.timeline.open_date && issue.timeline.close_date) {
  const o = new Date(issue.timeline.open_date + 'T10:00:00').getTime();
  const c = new Date(issue.timeline.close_date + 'T17:00:00').getTime();
  const e = Math.max(0, today.getTime() - o);
  const t = Math.max(1, c - o);
  progressPct = Math.max(0, Math.min(100, (e / t) * 100));
}

const schemas = getIPOSchemas(issue);
const formattedPriceRange = priceMin != null && priceMax != null ? `${formatRupee(priceMin)} - ${formatRupee(priceMax)}` : priceMax != null ? formatRupee(priceMax) : 'N/A';
const metaDescription = `Indian Primary Market Analysis for ${company} ${issueType} on ${exchange}. Pricing details: Price band of ${formattedPriceRange}, lot size of ${lotSize || 'N/A'} shares. Track real-time subscription status, bidding trajectory, timeline dates, Lead Managers (BRLM), and listing performance.`;
---

<Base title={company} description={metaDescription} schemas={schemas}>

<!-- HERO -->
<section class="page-tight pt-14 pb-10">
  <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-8 lg:gap-16">
    <div class="flex-1 min-w-0">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1 text-[12.5px] mute">
        <span class="inline-flex items-center gap-2">
          {status === 'current' && <span class="live-dot"></span>}
          <span class="label" style="color: inherit">{statusLabel}</span>
        </span>
        <span class="mute-2">·</span>
        <span>{tagLine}</span>
        {dateLine && (<>
          <span class="mute-2">·</span>
          <span>{dateLine}</span>
        </>)}
      </div>
      <h1 class="headline mt-5 max-w-[18ch] break-words hyphens-auto">{company}</h1>
      {standfirst && <p class="serif text-[22px] leading-[1.5] text-[color:var(--color-ink-soft)] max-w-[56ch] mt-5">{standfirst}.</p>}
      {reportHref && (
        <a
          href={reportHref}
          class="inline-flex items-baseline gap-2 mt-6 text-[13px] font-semibold tracking-[0.04em] border-b-2 pb-1"
          style="color: var(--color-accent-deep); border-color: var(--color-accent)"
        >
          <span class="uppercase">Read the full research report</span>
          <span aria-hidden="true">→</span>
        </a>
      )}
      {status === 'current' && progressPct > 0 && (
        <div class="mt-8 max-w-[36ch]">
          <div class="flex justify-between items-baseline text-[11px] tracking-[0.08em] uppercase mute font-semibold mb-2">
            <span>Subscription window</span>
            <span class="num">{Math.round(progressPct)}%</span>
          </div>
          <div class="h-[3px] bg-[color:var(--color-rule)] relative overflow-hidden">
            <div class="absolute inset-y-0 left-0 bg-[color:var(--color-accent)]" style={`width: ${progressPct}%`}></div>
          </div>
        </div>
      )}
    </div>
    {heroFigure && (
      <div class="shrink-0 lg:text-right">
        <p class={`figure num ${heroFigure.isGain && heroFigure.gain != null && heroFigure.gain > 50 ? 'acc' : ''}`}>{heroFigure.value}</p>
        <p class="stat-label mt-3">{heroFigure.label}</p>
      </div>
    )}
  </div>
</section>

<!-- VITALS BAND -->
<section class="page-tight pb-16">
  <div class="flex flex-wrap gap-x-10 gap-y-6 items-baseline">
    {priceMin != null && priceMax != null && (
      <div>
        <div class="stat-label mb-2">Price band</div>
        <div class="serif text-[28px] num leading-tight">{formatRupeeRange(priceMin, priceMax)}</div>
      </div>
    )}
    {issue.pricing.issue_price != null && status === 'past' && (
      <div>
        <div class="stat-label mb-2">Issue price</div>
        <div class="serif text-[28px] num leading-tight">{formatRupee(issue.pricing.issue_price)}</div>
      </div>
    )}
    {lotSize != null && (
      <div>
        <div class="stat-label mb-2">Shares per lot</div>
        <div class="serif text-[28px] num leading-tight">{formatInt(lotSize)}</div>
      </div>
    )}
    {minInvestment != null && (
      <div>
        <div class="stat-label mb-2">Retail minimum</div>
        <div class="serif text-[28px] num leading-tight">{formatRupee(minInvestment)}</div>
      </div>
    )}
    {sizeText && (
      <div>
        <div class="stat-label mb-2">Issue size</div>
        <div class="serif text-[28px] num leading-tight">{sizeText}</div>
      </div>
    )}
    {faceValue != null && (
      <div>
        <div class="stat-label mb-2">Face value</div>
        <div class="serif text-[28px] num leading-tight">{formatRupee(faceValue)}</div>
      </div>
    )}
    {status === 'past' && issue.listing_performance.listing_day_close != null && (
      <div>
        <div class="stat-label mb-2">Listing-day close</div>
        <div class="serif text-[28px] num leading-tight">{formatRupee(issue.listing_performance.listing_day_close)}</div>
      </div>
    )}
    {status === 'past' && issue.listing_performance.gain_loss != null && (
      <div>
        <div class="stat-label mb-2">Return since listing</div>
        <div class={`serif text-[28px] num leading-tight ${issue.listing_performance.gain_loss > 50 ? 'acc' : ''}`}>{fmtGain(issue.listing_performance.gain_loss)}</div>
      </div>
    )}
  </div>
</section>

<!-- SECTION ANCHOR NAV -->
{(hasVerifiedProspectus || hasTijoriResearch || subscriptionRows.length > 0 || issue.subscription.trajectory.length > 1) && (
  <nav class="sticky top-0 z-10 bg-[color:var(--color-paper)] border-b border-[color:var(--color-rule)]">
    <div class="page-tight">
      <div class="flex overflow-x-auto" style="scrollbar-width:none;-webkit-overflow-scrolling:touch">
        {(hasVerifiedProspectus || hasTijoriResearch) && (
          <a href="#research" class="ipo-nav-link">Research</a>
        )}
        {(subscriptionRows.length > 0 || issue.subscription.trajectory.length > 1 || bidBook.length > 0) && (
          <a href="#demand" class="ipo-nav-link">Demand</a>
        )}
        {(brlmName || registrarName) && (
          <a href="#parties" class="ipo-nav-link">Parties</a>
        )}
        {(visibleIssueInfoRows.length > 0 || offerMetadataRows.length > 0) && (
          <a href="#filings" class="ipo-nav-link">Filings</a>
        )}
      </div>
    </div>
  </nav>
)}

<!-- PROSPECTUS RESEARCH NOTE -->
{hasVerifiedProspectus && hasResearchArticle && (
  <section id="research" class="page-tight py-20">
    <header class="mb-14">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="section-title">Prospectus research note</h2>
        <span class="text-[12px] mute">
          {prospectusQuality?.state === 'review' ? 'review extraction' : 'verified extraction'}
          {prospectusQuality?.verified_fact_count != null && <> · <span class="num">{prospectusQuality.verified_fact_count}</span> verified facts</>}
        </span>
      </div>
    </header>

    <div class="max-w-[680px]">
      <!-- Executive summary -->
      {articleLeadParagraphs.length > 0 && (
        <div class="mb-20">
          {articleLeadParagraphs.map((line, idx) => (
