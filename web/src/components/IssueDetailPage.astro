                {fact.value}
                {fact.page && <span class="block mt-1 text-[11px] mute">DRHP p.<span class="num">{fact.page}</span></span>}
              </p>
            ))}
          </div>
        )}
        {valuationRows.length > 0 && (
          <div>
            <div class="label mb-4">Valuation and peers</div>
            {valuationRows.map((fact) => (
              <p class="py-3 border-b border-[color:var(--color-rule)] text-[13px] leading-relaxed">
                <span class="block mute text-[11px] uppercase tracking-[0.08em]">{fact.label}</span>
                {fact.value}
                {fact.page && <span class="block mt-1 text-[11px] mute">DRHP p.<span class="num">{fact.page}</span></span>}
              </p>
            ))}
          </div>
        )}
        {governanceRows.length > 0 && (
          <div>
            <div class="label mb-4">Governance</div>
            {governanceRows.map((fact) => (
              <p class="py-3 border-b border-[color:var(--color-rule)] text-[13px] leading-relaxed">
                <span class="block mute text-[11px] uppercase tracking-[0.08em]">{fact.label}</span>
                {fact.value}
                {fact.page && <span class="block mt-1 text-[11px] mute">DRHP p.<span class="num">{fact.page}</span></span>}
              </p>
            ))}
          </div>
        )}
      </div>
    )}
  </section>
)}

<!-- DOCUMENTS -->
{documents.length > 0 && (
  <section class="page-tight pt-12 pb-20 border-t border-[color:var(--color-rule)]">
    <header class="mb-9">
      <h2 class="section-title">Documents</h2>
    </header>
    <ul class="list-none p-0 m-0">
      {documents.map((doc: any) => (
        <li>
          <a href={doc.url} target="_blank" rel="noopener" class="flex items-baseline justify-between gap-6 py-4 border-b border-[color:var(--color-rule)] group">
            <span class="serif font-medium text-[16px] group-hover:acc transition-colors">{doc.type}</span>
            <span class="text-[12px] mute num">{doc.source_date ?? doc.date ?? ''}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<!-- PROVENANCE -->
<section class="page-tight pt-8 pb-16 border-t border-[color:var(--color-rule)]">
  <p class="text-[11.5px] mute leading-[1.6] max-w-[70ch]">
    Data sources:
    {(issue.sources ?? []).map((s: any, i: number) => (
      <>
        {i > 0 ? ', ' : ' '}
        <span>{String(s.source ?? '').toUpperCase()}</span>
      </>
    ))}.
    Data quality <span class="num">{issue.data_quality?.state ?? 'unknown'}</span>{issue.data_quality?.warning_count ? <>, {issue.data_quality.warning_count} warning{issue.data_quality.warning_count === 1 ? '' : 's'}</> : null}.
  </p>
</section>

</Base>
