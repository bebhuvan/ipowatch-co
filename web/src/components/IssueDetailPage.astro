                    <td class="py-3 pr-6 text-right num serif">{fmtCr(row.net_sales_cr)}</td>
                    <td class="py-3 pr-6 text-right num serif">{fmtCr(row.pat_cr)}</td>
                    <td class="py-3 text-right num serif">{fmtCr(row.debt_cr)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}

        {tijoriRevenueRows.length > 0 && (
          <div>
            <div class="label mb-5">Revenue mix</div>
            <div class="space-y-3">
              {tijoriRevenueRows.map((row) => (
                <div class="flex items-center gap-4">
                  <div class="flex-1 min-w-0">
                    <div class="flex items-baseline justify-between gap-4 mb-1">
                      <span class="text-[13px] truncate">{row.segment}</span>
                      <span class="text-[13px] num serif font-medium shrink-0">{row.percent?.toFixed(1)}%</span>
                    </div>
                    <div class="h-[3px] bg-[color:var(--color-rule)]">
                      <div class="h-full bg-[color:var(--color-accent)]" style={`width: ${Math.min(100, row.percent ?? 0)}%`}></div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}

        {tijoriPeerRows.length > 0 && (
          <div>
            <div class="label mb-4">Peer comparison</div>
            <table class="w-full text-[13.5px]">
              <thead>
                <tr class="border-b-2 border-[color:var(--color-ink)]">
                  <th class="text-left pb-3 pr-6 label">Company</th>
                  <th class="text-right pb-3 pr-6 label">Mkt cap (Cr)</th>
                  <th class="text-right pb-3 pr-6 label">Revenue</th>
                  <th class="text-right pb-3 pr-6 label">PAT</th>
                  <th class="text-right pb-3 pr-6 label">P/E</th>
                  <th class="text-right pb-3 label">P/B</th>
                </tr>
              </thead>
              <tbody>
                {tijoriPeerRows.map((row) => (
                  <tr class="border-b border-[color:var(--color-rule)]">
                    <td class="py-3 pr-6 font-semibold">{row.company_name}</td>
                    <td class="py-3 pr-6 text-right num serif">{row.market_cap ?? '—'}</td>
                    <td class="py-3 pr-6 text-right num serif">{fmtCr(row.net_sales_cr)}</td>
                    <td class="py-3 pr-6 text-right num serif">{fmtCr(row.pat_cr)}</td>
                    <td class="py-3 pr-6 text-right num serif">{fmtMultiple(row.pe)}</td>
                    <td class="py-3 text-right num serif">{fmtMultiple(row.pb)}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        )}
      </div>

      <!-- Right sidebar: valuation + offer split + shareholding -->
      <aside class="space-y-10">

        {tijoriValuationRows.filter(r => r.value != null && r.value !== '').length > 0 && (
          <div class="border-t-2 border-[color:var(--color-ink)] pt-5">
            <div class="label mb-4">Valuation</div>
            <dl>
              {tijoriValuationRows.filter(r => r.value != null && r.value !== '').map((row) => (
                <div class="flex justify-between items-baseline gap-4 py-[13px] border-b border-[color:var(--color-rule)]">
                  <dt class="stat-label">{row.label}</dt>
                  <dd class="num serif text-[20px] font-light">{String(row.value)}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        {tijoriOfferRows.filter(r => r.value).length > 0 && (
          <div class="border-t border-[color:var(--color-rule)] pt-5">
            <div class="label mb-4">Offer structure</div>
            <dl>
              {tijoriOfferRows.filter(r => r.value).map((row) => (
                <div class="flex justify-between items-baseline gap-4 py-[13px] border-b border-[color:var(--color-rule)]">
                  <dt class="stat-label">{row.label}</dt>
                  <dd class="num serif text-[18px]">{row.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}

        {tijoriHoldingRows.length > 0 && (
          <div class="border-t border-[color:var(--color-rule)] pt-5">
            <div class="label mb-4">Shareholding</div>
            <dl>
              {tijoriHoldingRows.map((row) => (
                <div class="py-4 border-b border-[color:var(--color-rule)]">
                  <div class="stat-label mb-3">{row.label}</div>
                  <div class="flex items-baseline gap-5">
                    {row.pre != null && (
                      <div>
                        <div class="num serif text-[22px] font-light">{row.pre}%</div>
                        <div class="label mt-1">Pre-IPO</div>
                      </div>
                    )}
                    {row.pre != null && row.post != null && <span class="text-[15px] text-[color:var(--color-mute-2)] pb-1">→</span>}
                    {row.post != null && (
                      <div>
                        <div class="num serif text-[22px] font-light text-[color:var(--color-ink)]">{row.post}%</div>
                        <div class="label mt-1">Post-IPO</div>
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </dl>
          </div>
        )}
      </aside>
    </div>
  </section>
)}
<!-- LIVE DEMAND -->
{(subscriptionRows.length > 0 || issue.subscription.trajectory.length > 1 || bidBook.length > 0) && (
  <section id="demand" class="bg-[color:var(--color-paper-soft)]">
    <div class="page-tight py-20">
      {subscriptionRows.length > 0 && (
        <div>
          <header class="flex items-baseline justify-between mb-10">
            <h2 class="section-title">Subscription by investor category</h2>
            {subscriptionUpdatedAt && <span class="text-[12px] mute num">as of {subscriptionUpdatedAt}</span>}
          </header>
          {subscriptionTotalRow && (
            <div class="mb-10 flex items-baseline justify-between gap-4 pb-6 border-b-2 border-[color:var(--color-ink)]">
              <div>
                <p class="label mb-2">Total demand</p>
                <p class="serif text-[30px] md:text-[38px] leading-tight num">
                  {formatInt(subscriptionTotalRow.bid)} shares bid
                  {subscriptionTotalRow.offered != null && <> <span class="mute-2">·</span> {formatInt(subscriptionTotalRow.offered)} offered</>}
                </p>
              </div>
              <div class="text-right">
                <p class="serif text-[52px] leading-none num acc">{subscriptionTotalRow.times == null ? '—' : formatTimes(subscriptionTotalRow.times)}</p>
                {subscriptionTotalRow.applications != null && <p class="mt-1 text-[12.5px] mute num">{formatInt(subscriptionTotalRow.applications)} applications</p>}
              </div>
            </div>
          )}
          {subscriptionAllZero && (
            <p class="mb-8 text-[13px] mute leading-relaxed max-w-[72ch]">
              BSE is publishing the category book for this issue, but the latest feed currently reports zero bids and no subscription multiple.
            </p>
          )}
          <div class="space-y-0">
            {subscriptionVisualRows.map((row) => {
              const width = subscriptionMax > 0 ? Math.min(100, (row.metric / subscriptionMax) * 100) : 0;
              const isLeader = row.metric > 0 && row.metric === subscriptionLeaderMetric;
              const hasTimes = row.times != null;
              return (
                <div class={`py-5 border-b border-[color:var(--color-rule)] ${row.isChild ? 'pl-0 md:pl-10' : ''}`}>
                  <div class="flex items-baseline justify-between gap-4">
                    <div class="flex items-baseline gap-3 min-w-0">
                      <span class="text-[12px] mute num w-6 shrink-0">{row.sr ?? ''}</span>
                      <h3 class={`${row.isChild ? 'text-[14px] text-[color:var(--color-mute)]' : 'serif text-[18px] text-[color:var(--color-ink)]'} leading-snug truncate`}>
                        {row.category}
                      </h3>
                    </div>
                    <span class={`serif num leading-none shrink-0 ${hasTimes ? 'text-[26px]' : 'text-[19px]'} ${isLeader || (hasTimes && row.times! >= 5) ? 'acc' : 'text-[color:var(--color-ink)]'}`}>
                      {hasTimes ? formatTimes(row.times) : formatInt(row.bid)}
                    </span>
                  </div>
                  <div class={`mt-3 h-[10px] bg-[color:var(--color-rule)] relative ${row.isChild ? 'ml-9' : 'ml-9'}`}>
                    <span
                      class={`absolute inset-y-0 left-0 transition-all ${isLeader ? 'bg-[color:var(--color-accent)]' : row.isChild ? 'bg-[color:var(--color-mute-2)]' : 'bg-[color:var(--color-ink)]'}`}
                      style={`width: ${Math.max(width, row.metric > 0 ? 1.5 : 0).toFixed(1)}%; opacity: ${row.isChild ? 0.6 : 1};`}
                    ></span>
                  </div>
                  {(hasTimes || row.offered != null || row.applications != null) && (
                    <p class="mt-2 ml-9 text-[12px] mute">
                      {/* Only show raw bid count in sub-label when times is shown above (adds context);
                          when bid is already the main metric, showing it again is redundant */}
                      {hasTimes && row.bid != null && <><span class="num text-[color:var(--color-ink)]">{formatInt(row.bid)}</span> shares bid</>}
                      {row.offered != null && <>{hasTimes && row.bid != null ? <> <span class="mute-2">·</span> </> : ''}<span class="num text-[color:var(--color-ink)]">{formatInt(row.offered)}</span> offered</>}
                      {row.applications != null && <> <span class="mute-2">·</span> <span class="num text-[color:var(--color-ink)]">{formatInt(row.applications)}</span> applications</>}
                    </p>
                  )}
                </div>
              );
            })}
          </div>
          {issue.subscription.shares_bid != null && (
            <p class="mt-6 text-[12.5px] mute">
              Total shares bid: <span class="num text-[color:var(--color-ink)]">{formatInt(issue.subscription.shares_bid)}</span>{issue.subscription.times != null && <> · total subscription <span class="num text-[color:var(--color-ink)]">{formatTimes(issue.subscription.times)}</span></>}.
            </p>
          )}
        </div>
