  { label: 'OFS / existing holders', value: [tijori.offer_split?.ofs_percent, tijori.offer_split?.ofs_value].filter(Boolean).join(' · ') },
].filter((row) => row.value) : [];
const tijoriFinancialRows = tijori?.financials?.yearly_results?.filter((row) =>
  row.period || row.net_sales_cr != null || row.pat_cr != null || row.debt_cr != null
) ?? [];
const tijoriRevenueRows = tijori?.revenue_mix?.latest?.filter((row) => row.segment && row.percent != null) ?? [];
const tijoriPeerRows = tijori?.peers?.filter((row) => row.company_name).slice(0, 6) ?? [];
const tijoriHoldingRows = tijori ? [
  { label: 'Promoter holding', pre: tijori.shareholding?.promoter?.pre_ipo, post: tijori.shareholding?.promoter?.post_ipo },
  { label: 'Public holding', pre: tijori.shareholding?.public?.pre_ipo, post: tijori.shareholding?.public?.post_ipo },
].filter((row) => row.pre || row.post) : [];
const fmtCr = (value: number | null | undefined) =>
  value == null ? '—' : `${value.toLocaleString('en-IN', { maximumFractionDigits: 2 })} Cr`;
const fmtMultiple = (value: number | string | null | undefined) =>
  value == null || value === '' ? '—' : typeof value === 'number' ? value.toLocaleString('en-IN', { maximumFractionDigits: 2 }) : value;
const hasTijoriResearch = Boolean(tijori && (
  tijori.business_description ||
  tijoriValuationRows.length ||
  tijoriOfferRows.length ||
  tijoriFinancialRows.length ||
  tijoriRevenueRows.length ||
  tijoriPeerRows.length ||
  tijoriHoldingRows.length
));

// Subscription window progress (current issues)
let progressPct = 0;
if (status === 'current' && issue.timeline.open_date && issue.timeline.close_date) {
  const o = new Date(issue.timeline.open_date + 'T10:00:00').getTime();
  const c = new Date(issue.timeline.close_date + 'T17:00:00').getTime();
  const e = Math.max(0, today.getTime() - o);
  const t = Math.max(1, c - o);
  progressPct = Math.max(0, Math.min(100, (e / t) * 100));
}

---

<Base title={company}>

<!-- STATUS LINE -->
<div class="page-tight pt-16 pb-3 flex flex-wrap items-baseline gap-x-3 text-[12.5px] mute">
  <span class="inline-flex items-center gap-2">
    {status === 'current' && <span class="live-dot"></span>}
    <span class="label" style="color: inherit">{statusLabel}</span>
  </span>
  <span class="mute-2">·</span>
  <span>{tagLine}</span>
  {dateLine && (<>
    <span class="mute-2">·</span>
    <span>{dateLine}</span>
  </>)}
</div>

<!-- HEADLINE + STANDFIRST -->
<section class="page-tight pb-12">
  <h1 class="headline mb-7 max-w-[16ch] break-words hyphens-auto">{company}</h1>
  {standfirst && <p class="serif text-[22px] leading-[1.46] text-[color:var(--color-ink-soft)] max-w-[60ch]">{standfirst}.</p>}
</section>

<!-- HERO FIGURE -->
{heroFigure && (
  <section class="page-tight pt-10 pb-20 border-t border-[color:var(--color-rule)]">
    <p class={`figure num ${heroFigure.isGain && heroFigure.gain != null && heroFigure.gain > 50 ? 'acc' : ''}`}>{heroFigure.value}</p>
    <p class="label mt-5">{heroFigure.label}</p>
    {status === 'current' && progressPct > 0 && (
      <div class="mt-9 max-w-[36ch]">
        <div class="flex justify-between items-baseline text-[11px] tracking-[0.08em] uppercase mute font-semibold mb-2">
          <span>Subscription window</span>
          <span class="num">{Math.round(progressPct)}%</span>
        </div>
        <div class="h-[3px] bg-[color:var(--color-rule)] relative overflow-hidden">
          <div class="absolute inset-y-0 left-0 bg-[color:var(--color-accent)]" style={`width: ${progressPct}%`}></div>
        </div>
      </div>
    )}
  </section>
)}

<!-- SPECS CARDS -->
<section class="page-tight pt-12 pb-20 border-t border-[color:var(--color-rule)]">
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5">
    {priceMin != null && priceMax != null && (
      <div class="bg-white border border-[color:var(--color-rule-card)] p-6">
        <div class="label mb-2">Price band</div>
        <div class="serif text-[26px] num leading-tight">{formatRupeeRange(priceMin, priceMax)}</div>
      </div>
    )}
    {issue.pricing.issue_price != null && status === 'past' && (
      <div class="bg-white border border-[color:var(--color-rule-card)] p-6">
        <div class="label mb-2">Issue price</div>
        <div class="serif text-[26px] num leading-tight">{formatRupee(issue.pricing.issue_price)}</div>
      </div>
    )}
    {lotSize != null && (
      <div class="bg-white border border-[color:var(--color-rule-card)] p-6">
        <div class="label mb-2">Shares per lot</div>
        <div class="serif text-[26px] num leading-tight">{formatInt(lotSize)}</div>
      </div>
    )}
    {minInvestment != null && (
      <div class="bg-white border border-[color:var(--color-rule-card)] p-6">
        <div class="label mb-2">Retail minimum</div>
        <div class="serif text-[26px] num leading-tight">{formatRupee(minInvestment)}</div>
      </div>
    )}
    {sizeText && (
      <div class="bg-white border border-[color:var(--color-rule-card)] p-6">
        <div class="label mb-2">Issue size</div>
        <div class="serif text-[26px] num leading-tight">{sizeText}</div>
      </div>
    )}
    {faceValue != null && (
      <div class="bg-white border border-[color:var(--color-rule-card)] p-6">
        <div class="label mb-2">Face value</div>
        <div class="serif text-[26px] num leading-tight">{formatRupee(faceValue)}</div>
      </div>
    )}
    {status === 'past' && issue.listing_performance.listing_day_close != null && (
      <div class="bg-white border border-[color:var(--color-rule-card)] p-6">
        <div class="label mb-2">Listing-day close</div>
        <div class="serif text-[26px] num leading-tight">{formatRupee(issue.listing_performance.listing_day_close)}</div>
      </div>
    )}
    {status === 'past' && issue.listing_performance.current_price != null && (
      <div class="bg-white border border-[color:var(--color-rule-card)] p-6">
        <div class="label mb-2">Current price</div>
        <div class="serif text-[26px] num leading-tight">{formatRupee(issue.listing_performance.current_price)}</div>
      </div>
    )}
    {status === 'past' && issue.listing_performance.gain_loss != null && (
      <div class="bg-white border border-[color:var(--color-rule-card)] p-6">
        <div class="label mb-2">Return since listing</div>
        <div class={`serif text-[26px] num leading-tight ${issue.listing_performance.gain_loss > 50 ? 'acc' : ''}`}>{fmtGain(issue.listing_performance.gain_loss)}</div>
      </div>
    )}
  </div>
</section>

<!-- SUBSCRIPTION BY CATEGORY -->
{subscriptionRows.length > 0 && (
  <section class="page-tight pt-12 pb-20 border-t border-[color:var(--color-rule)]">
    <header class="flex items-baseline justify-between mb-9">
      <h2 class="section-title">Subscription by investor category</h2>
      {subscriptionUpdatedAt && <span class="text-[12px] mute num">as of {subscriptionUpdatedAt}</span>}
    </header>
    {subscriptionTotalRow && (
      <div class="mb-7 border-y border-[color:var(--color-ink)] py-5">
        <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_auto] gap-4 md:items-end">
          <div>
            <p class="label mb-2">Total demand</p>
            <p class="serif text-[26px] md:text-[32px] leading-tight num">
              {formatInt(subscriptionTotalRow.bid)} shares bid
              {subscriptionTotalRow.offered != null && <> against {formatInt(subscriptionTotalRow.offered)} offered</>}
            </p>
          </div>
          <div class="md:text-right">
            <p class="serif text-[42px] leading-none num acc">{subscriptionTotalRow.times == null ? '—' : formatTimes(subscriptionTotalRow.times)}</p>
            {subscriptionTotalRow.applications != null && <p class="mt-2 text-[12.5px] mute num">{formatInt(subscriptionTotalRow.applications)} applications</p>}
          </div>
        </div>
      </div>
    )}
    {subscriptionAllZero && (
      <p class="mb-7 text-[13px] mute leading-relaxed max-w-[72ch]">
        BSE is publishing the category book for this issue, but the latest feed currently reports zero bids and no subscription multiple.
      </p>
    )}
    <div class="space-y-4">
      {subscriptionVisualRows.map((row) => {
        const width = subscriptionMax > 0 ? Math.min(100, (row.metric / subscriptionMax) * 100) : 0;
        const isLeader = row.metric > 0 && row.metric === subscriptionLeaderMetric;
        const hasTimes = row.times != null;
        return (
          <article class={`border-b border-[color:var(--color-rule)] pb-4 ${row.isChild ? 'ml-0 md:ml-12' : ''}`}>
            <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_116px] gap-3 md:items-baseline">
              <div>
                <div class="flex items-baseline gap-3">
                  <span class="text-[12px] mute num w-8 shrink-0">{row.sr ?? ''}</span>
                  <h3 class={`${row.isChild ? 'text-[13px] text-[color:var(--color-mute)]' : 'serif text-[22px] text-[color:var(--color-ink)]'} leading-snug`}>
                    {row.category}
                  </h3>
                </div>
                <p class="mt-2 ml-11 text-[12.5px] mute leading-relaxed">
                  {row.bid != null && <>Shares bid <span class="num text-[color:var(--color-ink)]">{formatInt(row.bid)}</span></>}
                  {row.offered != null && <> <span class="mute-2">·</span> Offered <span class="num text-[color:var(--color-ink)]">{formatInt(row.offered)}</span></>}
                  {row.applications != null && <> <span class="mute-2">·</span> Applications <span class="num text-[color:var(--color-ink)]">{formatInt(row.applications)}</span></>}
                </p>
              </div>
              <div class="md:text-right ml-11 md:ml-0">
                <span class={`serif num leading-none ${hasTimes ? 'text-[30px]' : 'text-[22px]'} ${isLeader || (hasTimes && row.times! >= 5) ? 'acc' : 'text-[color:var(--color-ink)]'}`}>
                  {hasTimes ? formatTimes(row.times) : formatInt(row.bid)}
                </span>
                {!hasTimes && <span class="ml-2 text-[11px] mute uppercase tracking-[0.08em]">shares</span>}
              </div>
            </div>
            <div class={`mt-3 ${row.isChild ? 'ml-11' : 'ml-11'} h-[10px] bg-[color:var(--color-rule)] relative`}>
              <span
                class={`absolute inset-y-0 left-0 ${isLeader ? 'bg-[color:var(--color-accent)]' : row.isChild ? 'bg-[color:var(--color-mute-2)]' : 'bg-[color:var(--color-ink)]'}`}
                style={`width: ${Math.max(width, row.metric > 0 ? 1.5 : 0).toFixed(1)}%; opacity: ${row.isChild ? 0.75 : 1};`}
              ></span>
            </div>
          </article>
        );
      })}
    </div>
    {issue.subscription.shares_bid != null && (
      <p class="mt-5 text-[12.5px] mute">
        Total shares bid: <span class="num text-[color:var(--color-ink)]">{formatInt(issue.subscription.shares_bid)}</span>{issue.subscription.times != null && <> · total subscription <span class="num text-[color:var(--color-ink)]">{formatTimes(issue.subscription.times)}</span></>}.
      </p>
    )}
  </section>
)}

<!-- TRAJECTORY -->
{issue.subscription.trajectory.length > 1 && (
  <section class="page-tight pt-12 pb-20 border-t border-[color:var(--color-rule)]">
    <header class="mb-9">
      <h2 class="section-title">Subscription over time</h2>
    </header>
    <div class="max-w-[1080px]">
      <TrajectoryChart observations={issue.subscription.trajectory} />
    </div>
  </section>
)}

<!-- BID BOOK -->
{bidBook.length > 0 && (
  <section class="page-tight pt-12 pb-20 border-t border-[color:var(--color-rule)]">
    <header class="flex items-baseline justify-between mb-9">
      <h2 class="section-title">Bid book by price</h2>
      <span class="text-[12px] mute">{bidBookSource === 'NSE' ? 'cumulative NSE demand' : 'where the demand sits'}</span>
    </header>
    <div class="space-y-3 max-w-[980px]">
      {bidBook.slice().sort((a, b) => b.price - a.price).map((row) => {
        const pct = bidBookMaxQty > 0 ? (row.quantity / bidBookMaxQty) * 100 : 0;
        const isCutoff = priceMax != null && row.price === priceMax;
        return (
          <div class="grid grid-cols-[86px_minmax(0,1fr)] sm:grid-cols-[108px_minmax(0,1fr)_170px] items-center gap-3 sm:gap-5 num py-1">
            <span class={`text-left sm:text-right serif text-[23px] ${isCutoff ? 'acc' : ''}`}>{formatRupee(row.price)}</span>
            <span class="relative h-[28px] bg-[color:var(--color-paper-soft)] border border-[color:var(--color-rule)]">
              <span
                class={`absolute inset-y-0 left-0 ${isCutoff ? 'bg-[color:var(--color-accent)]' : 'bg-[color:var(--color-ink)]'}`}
                style={`width: ${pct.toFixed(1)}%; opacity: ${isCutoff ? 1 : 0.3 + (pct / 100) * 0.6};`}
              ></span>
            </span>
            <span class="col-start-2 sm:col-start-auto text-right serif text-[21px] num">{formatInt(row.quantity)}</span>
          </div>
        );
      })}
    </div>
    {(bidBook[0]?.timestamp || demandGraph?.note) && (
      <p class="mt-5 text-[12.5px] mute max-w-[78ch]">
        {bidBook[0]?.timestamp && <>Updated <span class="num">{bidBook[0].timestamp}</span>. </>}
        {demandGraph?.note && <>{demandGraph.note}</>}
      </p>
    )}
  </section>
)}

<!-- EXCHANGE ISSUE DETAILS -->
{(visibleIssueInfoRows.length > 0 || offerMetadataRows.length > 0) && (
  <section class="page-tight pt-12 pb-20 border-t border-[color:var(--color-rule)]">
    <header class="flex items-baseline justify-between mb-9">
      <h2 class="section-title">Exchange filings</h2>
      <span class="text-[12px] mute">Fields captured from NSE and BSE</span>
    </header>
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
      {visibleIssueInfoRows.length > 0 && (
        <div>
          <div class="label mb-4">Issue information</div>
          <dl class="border-t border-[color:var(--color-ink)]">
            {visibleIssueInfoRows.map((row) => (
              <div class="grid grid-cols-1 sm:grid-cols-[180px_minmax(0,1fr)] gap-1 sm:gap-5 py-3 border-b border-[color:var(--color-rule)]">
                <dt class="text-[12px] mute leading-snug">{row.title}</dt>
                <dd class="text-[13px] leading-snug min-w-0">
                  {row.href ? (
                    <a href={row.href} target="_blank" rel="noopener" class="hover:acc break-words">{row.value && row.value.startsWith('http') ? row.value : row.title}</a>
                  ) : (
                    <span class="break-words">{row.value}</span>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      )}
      {offerMetadataRows.length > 0 && (
        <div>
          <div class="label mb-4">Company and offer metadata</div>
          <dl class="border-t border-[color:var(--color-ink)]">
            {offerMetadataRows.map((row) => (
              <div class="grid grid-cols-1 sm:grid-cols-[180px_minmax(0,1fr)] gap-1 sm:gap-5 py-3 border-b border-[color:var(--color-rule)]">
                <dt class="text-[12px] mute leading-snug">{row.title}</dt>
                <dd class="text-[13px] leading-snug min-w-0">
                  {row.href ? (
                    <a href={row.href} target="_blank" rel="noopener" class="hover:acc break-words">{row.value}</a>
                  ) : (
                    <span class="break-words">{row.value}</span>
                  )}
                </dd>
              </div>
            ))}
          </dl>
        </div>
      )}
    </div>
  </section>
)}

<!-- THIRD-PARTY RESEARCH SNAPSHOT -->
{hasTijoriResearch && tijori && (
  <section class="page-tight pt-12 pb-20 border-t border-[color:var(--color-rule)]">
    <header class="flex flex-wrap items-baseline justify-between gap-4 mb-9">
      <h2 class="section-title">Research snapshot</h2>
      <span class="text-[12px] mute">Tijori enrichment</span>
    </header>

    {tijori.business_description && (
      <p class="serif text-[22px] leading-[1.46] text-[color:var(--color-ink-soft)] max-w-[72ch] mb-10">
        {tijori.business_description}
      </p>
    )}

    {(tijoriValuationRows.length > 0 || tijoriOfferRows.length > 0) && (
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 mb-12">
        {tijoriValuationRows.length > 0 && (
          <div>
            <div class="label mb-4">Valuation</div>
            <dl class="grid grid-cols-2 sm:grid-cols-3 gap-px bg-[color:var(--color-rule)] border border-[color:var(--color-rule)]">
              {tijoriValuationRows.map((row) => (
                <div class="bg-white p-4 min-w-0">
                  <dt class="text-[11px] mute uppercase tracking-[0.08em]">{row.label}</dt>
                  <dd class="mt-2 serif text-[22px] leading-tight num break-words">{fmtMultiple(row.value)}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}
        {tijoriOfferRows.length > 0 && (
          <div>
            <div class="label mb-4">Offer split</div>
            <dl class="border-t border-[color:var(--color-ink)]">
              {tijoriOfferRows.map((row) => (
                <div class="grid grid-cols-1 sm:grid-cols-[180px_minmax(0,1fr)] gap-1 sm:gap-5 py-3 border-b border-[color:var(--color-rule)]">
                  <dt class="text-[12px] mute leading-snug">{row.label}</dt>
                  <dd class="text-[14px] leading-snug num">{row.value}</dd>
                </div>
              ))}
            </dl>
          </div>
        )}
      </div>
    )}

    {(tijoriFinancialRows.length > 0 || tijoriRevenueRows.length > 0) && (
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 mb-12">
        {tijoriFinancialRows.length > 0 && (
          <div>
            <div class="label mb-4">Financial trend</div>
            <div class="overflow-x-auto">
              <table class="w-full text-left border-t border-[color:var(--color-ink)]">
                <thead>
                  <tr class="text-[11px] mute uppercase tracking-[0.08em]">
                    <th class="py-3 pr-4 font-semibold">Period</th>
                    <th class="py-3 px-4 font-semibold text-right">Sales</th>
                    <th class="py-3 px-4 font-semibold text-right">PAT</th>
                    <th class="py-3 pl-4 font-semibold text-right">Debt</th>
                  </tr>
                </thead>
                <tbody>
                  {tijoriFinancialRows.map((row) => (
                    <tr class="border-t border-[color:var(--color-rule)] text-[13px]">
                      <td class="py-3 pr-4 whitespace-nowrap">{row.period ?? '—'}</td>
                      <td class="py-3 px-4 text-right num whitespace-nowrap">{fmtCr(row.net_sales_cr)}</td>
                      <td class="py-3 px-4 text-right num whitespace-nowrap">{fmtCr(row.pat_cr)}</td>
                      <td class="py-3 pl-4 text-right num whitespace-nowrap">{fmtCr(row.debt_cr)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
        {tijoriRevenueRows.length > 0 && (
          <div>
            <div class="label mb-4">Revenue mix</div>
            <div class="space-y-3">
              {tijoriRevenueRows.slice(0, 8).map((row) => (
                <div>
                  <div class="flex items-baseline justify-between gap-4 text-[13px]">
                    <span class="min-w-0 break-words">{row.segment}</span>
                    <span class="num serif text-[20px]">{row.percent?.toFixed(1)}%</span>
                  </div>
                  <div class="mt-2 h-[8px] bg-[color:var(--color-rule)] relative">
                    <span class="absolute inset-y-0 left-0 bg-[color:var(--color-ink)]" style={`width: ${Math.max(0, Math.min(100, row.percent ?? 0)).toFixed(1)}%`}></span>
                  </div>
                </div>
              ))}
            </div>
          </div>
        )}
      </div>
    )}

    {(tijoriPeerRows.length > 0 || tijoriHoldingRows.length > 0) && (
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        {tijoriPeerRows.length > 0 && (
          <div>
            <div class="label mb-4">Peers</div>
            <div class="overflow-x-auto">
              <table class="w-full text-left border-t border-[color:var(--color-ink)]">
                <thead>
                  <tr class="text-[11px] mute uppercase tracking-[0.08em]">
                    <th class="py-3 pr-4 font-semibold">Company</th>
                    <th class="py-3 px-4 font-semibold text-right">Sales</th>
                    <th class="py-3 px-4 font-semibold text-right">P/E</th>
                    <th class="py-3 pl-4 font-semibold text-right">P/B</th>
                  </tr>
                </thead>
                <tbody>
                  {tijoriPeerRows.map((row) => (
                    <tr class="border-t border-[color:var(--color-rule)] text-[13px]">
                      <td class="py-3 pr-4 min-w-[140px]">{row.company_name}</td>
                      <td class="py-3 px-4 text-right num whitespace-nowrap">{fmtCr(row.net_sales_cr)}</td>
                      <td class="py-3 px-4 text-right num whitespace-nowrap">{fmtMultiple(row.pe)}</td>
                      <td class="py-3 pl-4 text-right num whitespace-nowrap">{fmtMultiple(row.pb)}</td>
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </div>
        )}
        {tijoriHoldingRows.length > 0 && (
          <div>
            <div class="label mb-4">Shareholding</div>
            <dl class="border-t border-[color:var(--color-ink)]">
              {tijoriHoldingRows.map((row) => (
                <div class="grid grid-cols-1 sm:grid-cols-[180px_minmax(0,1fr)] gap-1 sm:gap-5 py-3 border-b border-[color:var(--color-rule)]">
                  <dt class="text-[12px] mute leading-snug">{row.label}</dt>
                  <dd class="text-[14px] leading-snug num">
                    {row.pre && <>Pre-IPO {row.pre}</>}
                    {row.pre && row.post && <span class="mute-2"> · </span>}
                    {row.post && <>Post-IPO {row.post}</>}
                  </dd>
                </div>
              ))}
            </dl>
          </div>
        )}
      </div>
    )}
  </section>
)}

<!-- PARTIES -->
{(brlmName || registrarName || sponsorName) && (
  <section class="page-tight pt-12 pb-20 border-t border-[color:var(--color-rule)]">
    <header class="mb-9">
      <h2 class="section-title">Parties to the issue</h2>
    </header>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
      {brlmName && (
        <div class="bg-white border border-[color:var(--color-rule-card)] p-6">
          <div class="label mb-3">Book-running lead manager</div>
          <div class="serif font-medium text-[20px] leading-snug">{brlmName}</div>
          {brlm.meta && <p class="text-[12px] mute mt-2">{brlm.meta}</p>}
        </div>
      )}
      {registrarName && (
        <div class="bg-white border border-[color:var(--color-rule-card)] p-6">
          <div class="label mb-3">Registrar</div>
          <div class="serif font-medium text-[20px] leading-snug">{registrarName}</div>
          {registrar.meta && <p class="text-[12px] mute mt-2">{registrar.meta}</p>}
        </div>
      )}
      {sponsorName && (
        <div class="bg-white border border-[color:var(--color-rule-card)] p-6">
          <div class="label mb-3">Sponsor bank</div>
          <div class="serif font-medium text-[20px] leading-snug">{sponsorName}</div>
        </div>
      )}
    </div>
  </section>
)}

<!-- VERIFIED PROSPECTUS FACTS -->
{hasVerifiedProspectus && hasResearchArticle && (
  <section class="page-tight pt-12 pb-20 border-t border-[color:var(--color-rule)]">
    <header class="mb-9">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="section-title">Prospectus research note</h2>
        <span class="text-[12px] mute">
          {prospectusQuality?.state === 'review' ? 'review extraction' : 'verified extraction'}
          {prospectusQuality?.verified_fact_count != null && <> · <span class="num">{prospectusQuality.verified_fact_count}</span> verified facts</>}
        </span>
      </div>
    </header>

    {articleLeadParagraphs.length > 0 && (
      <div class="mb-14 max-w-[78ch]">
        {articleLeadParagraphs.map((line, idx) => (
          <p class={`${idx === 0 ? 'serif text-[25px] leading-[1.45] text-[color:var(--color-ink-soft)]' : 'mt-5 text-[16px] leading-[1.8] text-[color:var(--color-ink)]'}`}>
            {line}
          </p>
        ))}
        {sourcePages([companyDescriptionFact, businessModelFact, industryNameFact]) && (
          <p class="mt-5 text-[11px] mute">{sourcePages([companyDescriptionFact, businessModelFact, industryNameFact])}</p>
        )}
      </div>
    )}

    {(businessParagraphs.length > 0 || articleStrengths.length > 0 || articleCustomers.length > 0) && (
      <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_340px] gap-12 mb-16">
        <article>
          <div class="label mb-4">Business model</div>
          <div class="space-y-5">
            {businessParagraphs.map((line) => (
              <p class="text-[16px] leading-[1.82] max-w-[76ch]">{line}</p>
            ))}
          </div>
          {sourcePages([...articleProducts, ...articleEndIndustries, ...articleDistribution, ...articleRnD, ...articleStrengths, ...articleCustomers, ...articleDependencies, ...articleGeographies]) && (
            <p class="mt-5 text-[11px] mute">{sourcePages([...articleProducts, ...articleEndIndustries, ...articleDistribution, ...articleRnD, ...articleStrengths, ...articleCustomers, ...articleDependencies, ...articleGeographies])}</p>
          )}
        </article>
        {(articleStrengths.length > 0 || articleCustomers.length > 0 || articleDependencies.length > 0) && (
          <aside>
            <div class="label mb-4">Operating read-through</div>
            <dl class="border-t border-[color:var(--color-ink)]">
              {[...articleStrengths.slice(0, 3), ...articleCustomers.slice(0, 1), ...articleDependencies.slice(0, 1)].map((fact) => (
                <div class="py-4 border-b border-[color:var(--color-rule)]">
                  <dt class="text-[11px] mute uppercase tracking-[0.08em]">{fact.label}</dt>
                  <dd class="mt-2 text-[14px] leading-relaxed">{fact.value}</dd>
                </div>
              ))}
            </dl>
          </aside>
        )}
      </div>
    )}

    {(industryParagraphs.length > 0 || articleMarketSizes.length > 0 || articleDrivers.length > 0 || articleRegulation.length > 0) && (
      <div class="mb-16">
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.95fr)_minmax(0,1.05fr)] gap-12">
          <article>
            <div class="label mb-4">Sector and industry</div>
            <div class="space-y-5">
              {industryParagraphs.map((line) => (
                <p class="text-[16px] leading-[1.82] max-w-[76ch]">{line}</p>
              ))}
            </div>
            {sourcePages([...articleOpportunityFacts, ...articleMarketSizes, ...articleAddressableMarket, ...articleGrowthRates, ...articleDrivers, ...articleDemandCatalysts, ...articlePolicyTailwinds, ...articleCompetition, ...articleHeadwinds]) && (
              <p class="mt-5 text-[11px] mute">{sourcePages([...articleOpportunityFacts, ...articleMarketSizes, ...articleAddressableMarket, ...articleGrowthRates, ...articleDrivers, ...articleDemandCatalysts, ...articlePolicyTailwinds, ...articleCompetition, ...articleHeadwinds])}</p>
            )}
          </article>
          <div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-px bg-[color:var(--color-rule)] border border-[color:var(--color-rule)]">
              {[...articleAddressableMarket.slice(0, 2), ...articleMarketSizes.slice(0, 4), ...articleGrowthRates.slice(0, 4)].slice(0, 8).map((fact) => (
                <div class="bg-white p-5 min-w-0">
                  <div class="text-[11px] mute uppercase tracking-[0.08em]">{fact.label}</div>
                  <div class="mt-3 serif text-[22px] leading-tight num break-words">{fact.value}</div>
                </div>
              ))}
            </div>
            {articleRegulation.length > 0 && (
              <div class="mt-6 border-t border-[color:var(--color-ink)]">
                {articleRegulation.slice(0, 4).map((fact) => (
                  <p class="py-3 border-b border-[color:var(--color-rule)] text-[13px] leading-relaxed">
                    <span class="font-semibold">Regulatory context.</span> {fact.value}
                  </p>
                ))}
              </div>
            )}
          </div>
        </div>
      </div>
    )}

    {(opportunityParagraphs.length > 0 || articleOpportunityFacts.length > 0 || articleExecutionFacts.length > 0) && (
      <div class="mb-16">
        <div class="label mb-4">Opportunity and execution path</div>
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_360px] gap-12">
          <article>
            <div class="space-y-5">
              {opportunityParagraphs.map((line) => (
                <p class="text-[16px] leading-[1.82] max-w-[78ch]">{line}</p>
              ))}
            </div>
            {sourcePages([...articleOpportunityFacts, ...articleExecutionFacts]) && (
              <p class="mt-5 text-[11px] mute">{sourcePages([...articleOpportunityFacts, ...articleExecutionFacts])}</p>
            )}
          </article>
          <aside>
            <div class="border-t border-[color:var(--color-ink)]">
              {[...articleExecutionFacts.slice(0, 5), ...articleOpportunityFacts.slice(0, 3)].slice(0, 8).map((fact, idx) => (
                <div class="grid grid-cols-[34px_minmax(0,1fr)] gap-4 py-4 border-b border-[color:var(--color-rule)]">
                  <span class="serif text-[22px] leading-none num text-[color:var(--color-ink-soft)]">{idx + 1}</span>
                  <div>
                    <div class="text-[10px] mute uppercase tracking-[0.08em]">{fact.label}</div>
                    <p class="mt-2 text-[14px] leading-relaxed">{fact.value}</p>
                  </div>
                </div>
              ))}
            </div>
          </aside>
        </div>
      </div>
    )}

    {(articleObjects.length > 0 || offerNarrativeFacts.length > 0) && (
      <div class="mb-16">
        <div class="label mb-4">Objects of the issue</div>
        {objectParagraph && <p class="text-[16px] leading-[1.82] max-w-[78ch] mb-6">{objectParagraph}</p>}
        <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
          {articleObjects.slice(0, 6).map((fact, idx) => (
            <article class="border border-[color:var(--color-rule-card)] bg-white p-5">
              <div class="serif text-[30px] leading-none num text-[color:var(--color-ink-soft)]">{idx + 1}</div>
              <p class="mt-4 text-[14px] leading-relaxed">{fact.value}</p>
            </article>
          ))}
        </div>
        {sourcePages(articleObjects) && <p class="mt-4 text-[11px] mute">{sourcePages(articleObjects)}</p>}
      </div>
    )}

    {(primaryFinancialSeries.length > 0 || financialTrendFacts.length > 0) && (
      <div class="mb-16">
        <div class="mb-4 flex flex-wrap items-center justify-between gap-3">
          <div class="label">Financial story</div>
          {financialsUrl && (
            <a href={financialsUrl} class="text-[12px] font-semibold border-b border-[color:var(--color-ink)]">
              View full financials
            </a>
          )}
        </div>
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,1.05fr)_minmax(280px,0.95fr)] gap-12">
          {primaryFinancialSeries.length > 0 && (
            <div>
              <div class="border-y border-[color:var(--color-ink)] py-5">
                <div class="flex flex-wrap items-baseline justify-between gap-4 mb-4">
                  <h3 class="serif text-[24px] leading-tight">{primaryFinancialSeries[0].source.label}</h3>
                  <span class="text-[11px] mute uppercase tracking-[0.08em]">reported sequence</span>
                </div>
                <svg viewBox={`0 0 ${primaryChart.width} ${primaryChart.height}`} class="w-full h-auto block" role="img" aria-label={`${primaryFinancialSeries[0].source.label} chart`}>
                  <line x1="28" x2={primaryChart.width - 28} y1={primaryChart.zeroY} y2={primaryChart.zeroY} stroke="var(--color-rule)" stroke-width="1" />
                  {primaryChart.bars.map((bar) => (
                    <rect x={bar.x} y={bar.y} width={bar.w} height={bar.h} fill={bar.row.value < 0 ? 'var(--color-mute-2)' : 'var(--color-ink)'} opacity={bar.row.value < 0 ? '0.55' : '0.88'} />
                  ))}
                  {primaryChart.points && <polyline points={primaryChart.points} fill="none" stroke="var(--color-accent)" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />}
                </svg>
                <div class="grid gap-2 mt-4" style={`grid-template-columns: repeat(${Math.min(primaryFinancialSeries.length, 8)}, minmax(0, 1fr));`}>
                  {primaryFinancialSeries.map((row) => (
                    <div class="min-w-0 text-center">
                      <div class="serif text-[16px] leading-tight num break-words">{row.value.toLocaleString('en-IN')}</div>
                      <div class="mt-1 text-[10px] mute num">{row.label}</div>
                    </div>
                  ))}
                </div>
              </div>
              {secondaryFinancialSeries.length > 0 && (
                <div class="mt-6">
                  <div class="flex items-baseline justify-between gap-4 mb-2">
                    <h4 class="text-[12px] mute uppercase tracking-[0.08em]">{secondaryFinancialSeries[0].source.label}</h4>
                  </div>
                  <div class="space-y-2">
                    {secondaryFinancialSeries.map((row) => {
                      const maxAbs = Math.max(...secondaryFinancialSeries.map((r) => Math.abs(r.value)), 1);
                      const w = Math.max(2, (Math.abs(row.value) / maxAbs) * 100);
                      return (
                        <div class="grid grid-cols-[48px_minmax(0,1fr)_90px] items-center gap-3 text-[12px]">
                          <span class="mute num">{row.label}</span>
                          <span class="h-[8px] bg-[color:var(--color-rule)] relative">
                            <span class={`absolute inset-y-0 ${row.value < 0 ? 'right-1/2 bg-[color:var(--color-mute-2)]' : 'left-1/2 bg-[color:var(--color-ink)]'}`} style={`width: ${Math.min(50, w / 2).toFixed(1)}%;`}></span>
                          </span>
                          <span class="text-right num serif text-[15px]">{row.value.toLocaleString('en-IN')}</span>
                        </div>
                      );
                    })}
                  </div>
                </div>
              )}
            </div>
          )}
          <div>
            <div class="space-y-4">
              {financialTrendFacts.slice(0, 5).map((fact) => (
                <p class="text-[15px] leading-[1.75]">
                  <span class="font-semibold">{fact.label}.</span> {fact.value}
                </p>
              ))}
            </div>
            {articleRatios.length > 0 && (
              <div class="mt-7 grid grid-cols-2 sm:grid-cols-3 gap-px bg-[color:var(--color-rule)] border border-[color:var(--color-rule)]">
                {articleRatios.slice(0, 6).map((row) => (
                  <div class="bg-white p-4">
                    <div class="text-[10px] mute uppercase tracking-[0.08em]">{row.label}</div>
                    <div class="mt-2 serif text-[20px] num">{row.value.toLocaleString('en-IN')}</div>
                  </div>
                ))}
              </div>
            )}
          </div>
        </div>
        {sourcePages(financialSourceFacts.length ? financialSourceFacts : financialTrendFacts) && (
          <p class="mt-4 text-[11px] mute">{sourcePages(financialSourceFacts.length ? financialSourceFacts : financialTrendFacts)}</p>
        )}
      </div>
    )}

    {(shareholdingSourceFacts.length > 0 || controlParagraph) && (
      <div class="mb-16">
        <div class="label mb-4">Shareholding and control</div>
        <div class="grid grid-cols-1 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] gap-12">
          <article>
            {controlParagraph && <p class="text-[16px] leading-[1.82] max-w-[74ch]">{controlParagraph}</p>}
            {articleRelatedParty.length > 0 && (
              <p class="mt-5 text-[15px] leading-[1.75]">
                <span class="font-semibold">Related-party angle.</span> {articleRelatedParty[0].value}
              </p>
            )}
            {articleLitigation.length > 0 && (
              <p class="mt-5 text-[15px] leading-[1.75]">
                <span class="font-semibold">Legal overhang.</span> {articleLitigation[0].value}
              </p>
            )}
          </article>
          <div>
            {shareholdingRows.length > 0 ? (
              <div class="space-y-5">
                {shareholdingRows.map((row) => (
                  <div>
                    <div class="flex items-baseline justify-between gap-4">
                      <span class="text-[13px] leading-snug">{row.value}</span>
                      <span class="serif text-[22px] num">{row.pct.toFixed(row.pct % 1 === 0 ? 0 : 2)}%</span>
                    </div>
                    <div class="mt-2 h-[12px] bg-[color:var(--color-rule)] relative">
                      <span class="absolute inset-y-0 left-0 bg-[color:var(--color-ink)]" style={`width: ${Math.max(0, Math.min(100, row.pct)).toFixed(2)}%;`}></span>
                    </div>
                  </div>
                ))}
              </div>
            ) : (
              <dl class="border-t border-[color:var(--color-ink)]">
                {shareholdingSourceFacts.slice(0, 6).map((fact) => (
                  <div class="py-3 border-b border-[color:var(--color-rule)]">
                    <dt class="text-[11px] mute uppercase tracking-[0.08em]">{fact.label}</dt>
                    <dd class="mt-1 text-[14px] leading-relaxed">{fact.value}</dd>
                  </div>
                ))}
              </dl>
            )}
          </div>
        </div>
        {sourcePages(shareholdingSourceFacts) && <p class="mt-4 text-[11px] mute">{sourcePages(shareholdingSourceFacts)}</p>}
      </div>
    )}

    {riskParagraphs.length > 0 && (
      <div>
        <div class="label mb-4">Risk thesis</div>
        <div class="grid grid-cols-1 lg:grid-cols-[220px_minmax(0,1fr)] gap-10">
          <div>
            <p class="serif text-[42px] leading-none num">{riskCountFact?.value ?? riskThesisFacts.length}</p>
            <p class="mt-3 text-[12px] mute leading-relaxed">{riskCountFact ? 'risk factors disclosed in the filing' : 'risk items extracted from the filing'}</p>
          </div>
          <article>
            <div class="space-y-5">
              {riskParagraphs.map((line) => (
                <p class="text-[15px] leading-[1.78] max-w-[82ch]">{line}</p>
              ))}
            </div>
            {riskThesisFacts.length > 0 && (
              <div class="mt-8 grid grid-cols-1 md:grid-cols-2 gap-x-10 border-t border-[color:var(--color-ink)]">
                {riskThesisFacts.slice(0, 8).map((fact) => (
                  <p class="py-3 border-b border-[color:var(--color-rule)] text-[13px] leading-relaxed">
                    <span class="block text-[10px] mute uppercase tracking-[0.08em]">{fact.label}</span>
                    {fact.value}
                  </p>
                ))}
              </div>
            )}
          </article>
        </div>
        {sourcePages([riskCountFact, ...riskThesisFacts]) && <p class="mt-4 text-[11px] mute">{sourcePages([riskCountFact, ...riskThesisFacts])}</p>}
      </div>
    )}
  </section>
)}

<!-- PROSPECTUS FACT BASE -->
{hasVerifiedProspectus && materialFactCount > 0 && (
  <section class="page-tight pt-12 pb-20 border-t border-[color:var(--color-rule)]">
    <header class="mb-9">
      <div class="flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="section-title">Prospectus fact base</h2>
        <span class="text-[12px] mute">
          <span class="num">{materialFactCount}</span> citation-verified facts
        </span>
      </div>
      <p class="mt-4 text-[14px] leading-relaxed mute max-w-[78ch]">
        Material facts extracted from the filing, grouped so the article can be checked against the underlying data instead of becoming the only source of truth.
      </p>
    </header>
    <div class="space-y-4">
      {dossierGroups.map((group, groupIdx) => (
        <details class="border-y border-[color:var(--color-rule)] py-4" open={groupIdx < 4}>
          <summary class="cursor-pointer list-none">
            <div class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_96px] gap-3 md:items-baseline">
              <div>
                <h3 class="serif text-[24px] leading-tight">{group.title}</h3>
                <p class="mt-2 text-[12.5px] mute leading-relaxed max-w-[78ch]">{group.deck}</p>
              </div>
              <span class="md:text-right text-[12px] mute num">{group.facts.length} facts</span>
            </div>
          </summary>
          <div class="mt-5 grid grid-cols-1 md:grid-cols-2 gap-x-10 border-t border-[color:var(--color-ink)]">
            {group.facts.map((fact) => (
              <article class="py-4 border-b border-[color:var(--color-rule)]">
                <div class="flex flex-wrap items-baseline justify-between gap-3">
                  <h4 class="text-[10px] mute uppercase tracking-[0.08em]">{fact.label}</h4>
                  <span class="text-[10px] mute num">
                    DRHP p.{fact.page}{fact.confidence ? ` · ${fact.confidence}` : ''}
                  </span>
                </div>
                <p class="mt-2 text-[13.5px] leading-relaxed">{fact.value}</p>
                {fact.section && <p class="mt-2 text-[11px] mute">{fact.section}</p>}
              </article>
            ))}
          </div>
        </details>
      ))}
    </div>
  </section>
)}

<!-- DOCUMENTS -->
{documents.length > 0 && (
  <section class="page-tight pt-12 pb-20 border-t border-[color:var(--color-rule)]">
    <header class="mb-9">
      <h2 class="section-title">Documents</h2>
    </header>
    <ul class="list-none p-0 m-0">
      {documents.map((doc: any) => (
        <li>
          <a href={doc.url} target="_blank" rel="noopener" class="flex items-baseline justify-between gap-6 py-4 border-b border-[color:var(--color-rule)] group">
            <span class="serif font-medium text-[16px] group-hover:acc transition-colors">{doc.type}</span>
            <span class="text-[12px] mute num">{doc.source_date ?? doc.date ?? ''}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
)}

<!-- PROVENANCE -->
<section class="page-tight pt-8 pb-16 border-t border-[color:var(--color-rule)]">
  <p class="text-[11.5px] mute leading-[1.6] max-w-[70ch]">
    Data sources:
    {(issue.sources ?? []).map((s: any, i: number) => (
      <>
        {i > 0 ? ', ' : ' '}
        <span>{String(s.source ?? '').toUpperCase()}</span>
      </>
    ))}.
    Data quality <span class="num">{issue.data_quality?.state ?? 'unknown'}</span>{issue.data_quality?.warning_count ? <>, {issue.data_quality.warning_count} warning{issue.data_quality.warning_count === 1 ? '' : 's'}</> : null}.
  </p>
</section>

</Base>
