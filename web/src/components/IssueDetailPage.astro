---
import Base from '../layouts/Base.astro';
import TrajectoryChart from './TrajectoryChart.astro';
import {
  formatDateLong,
  formatDateShort,
  formatInt,
  formatRupee,
  formatRupeeRange,
  formatTimes,
  formatLakhCr,
  daysFromNow,
} from '../lib/format';
import {
  extractIngredient,
  type IssueDetail,
} from '../lib/issues';

const { issue } = Astro.props as { issue: IssueDetail };
const today = new Date();

const status = issue.classification.status;
const company = issue.company.name ?? '';
const exchange = issue.classification.exchange_platform ?? '—';
const issueType = issue.classification.issue_type ?? 'IPO';

const exch = (issue.exchange_details ?? {}) as any;
const bseDetail = exch.bse?.issue_detail?.data?.IPONO_0?.[0] ?? null;
const nseIssueInfo = (exch.nse?.issue_detail?.data?.issueInfo?.dataList ?? []) as any[];
const nseOfferRows = (exch.nse?.offer_document_detail?.data?.data?.InPrincipal ?? []) as any[];

const splitParty = (raw: string | null | undefined): { name: string | null; meta: string | null } => {
  if (!raw) return { name: null, meta: null };
  const [first, ...rest] = String(raw).split('^');
  const meta = rest.join('^').split('|')[0]?.replace(/\s+/g, ' ').trim() || null;
  return { name: first?.trim() || null, meta };
};
const brlm = splitParty(bseDetail?.Book_Running_Lead_Manager);
const registrar = splitParty(bseDetail?.Registrar);
const sponsor = splitParty(bseDetail?.Sponsor_Bank);
const leadManagerNames = issue.parties?.lead_managers ?? [];
const brlmName = brlm.name ?? (leadManagerNames.length ? leadManagerNames.join(', ') : null);
const registrarName = registrar.name ?? issue.parties?.registrar ?? null;
const sponsorName = sponsor.name ?? issue.parties?.sponsor_bank ?? null;

const ing = extractIngredient(issue);
const priceMin = ing.priceMin;
const priceMax = ing.priceMax;
const lotSize = ing.lotSize;
const sharesOffered = ing.sharesOffered;
const faceValue = ing.faceValue;

const minInvestment = lotSize != null && priceMax != null ? lotSize * priceMax : null;
const subscribed = issue.subscription.trajectory.length
  ? issue.subscription.trajectory[issue.subscription.trajectory.length - 1].total?.times ?? issue.subscription.times
  : issue.subscription.times;
const lastTrajectory = issue.subscription.trajectory.length
  ? issue.subscription.trajectory[issue.subscription.trajectory.length - 1]
  : null;

const parseNum = (value: unknown): number | null => {
  if (typeof value === 'number') return Number.isFinite(value) ? value : null;
  if (typeof value !== 'string') return null;
  const cleaned = value.replace(/,/g, '').trim();
  if (!cleaned || cleaned === '-') return null;
  const n = Number(cleaned);
  return Number.isFinite(n) ? n : null;
};

const cleanCell = (value: unknown): string | null => {
  if (value == null) return null;
  const text = String(value).replace(/^"+|"+$/g, '').replace(/\s+/g, ' ').trim();
  return text && text !== '-' ? text : null;
};

const hrefFromValue = (value: unknown): string | null => {
  if (typeof value !== 'string') return null;
  const html = value.match(/href=([^ >]+)/i)?.[1]?.replace(/^["']|["']$/g, '');
  if (html) return html;
  return value.startsWith('http') ? value : null;
};

const labelize = (key: string) => key
  .replace(/_/g, ' ')
  .replace(/([a-z])([A-Z])/g, '$1 $2')
  .replace(/\s+/g, ' ')
  .trim()
  .replace(/\b\w/g, (c) => c.toUpperCase());

// Bid book / demand by price. BSE exposes exact quantity; NSE exposes cumulative demand.
type BidBookRow = { price: number; quantity: number; timestamp: string | null; source: string };
const isBidBookRow = (row: { price: number | null; quantity: number | null; timestamp: string | null; source: string }): row is BidBookRow =>
  row.price != null && row.quantity != null;
const bseBidRows: BidBookRow[] = (((exch.bse?.issue_detail?.data?.IPONO_2 ?? []) as any[])
  .map((r: any) => ({ price: parseNum(r.Price), quantity: parseNum(r.Quantity), timestamp: cleanCell(r.process_dttm), source: 'BSE' }))
  .filter(isBidBookRow));
const nseDemandRows: BidBookRow[] = (((exch.nse?.demand_data?.nse?.rows ?? exch.nse?.issue_detail?.data?.demandDataNSE ?? []) as any[])
  .map((r: any) => ({ price: parseNum(r.price), quantity: parseNum(r.cumQty), timestamp: cleanCell(r.timestamp), source: 'NSE' }))
  .filter(isBidBookRow));
const latestDemandCurve = (issue.subscription.demand_curves ?? [])
  .slice()
  .sort((a, b) => (b.observed_at ?? '').localeCompare(a.observed_at ?? ''))[0] ?? null;
const v3DemandRows: BidBookRow[] = latestDemandCurve
  ? latestDemandCurve.points.map((point) => ({
    price: point.price,
    quantity: point.cumulative_quantity,
    timestamp: latestDemandCurve.source_updated_at,
    source: latestDemandCurve.scope === 'all' ? 'NSE all-exchange' : 'NSE',
  }))
  : [];
const bidBook = bseBidRows.length ? bseBidRows : nseDemandRows.length ? nseDemandRows : v3DemandRows;
const bidBookMaxQty = bidBook.length ? Math.max(...bidBook.map((r) => r.quantity)) : 0;
const bidBookSource = bidBook[0]?.source ?? null;
const demandGraph = exch.nse?.issue_detail?.data?.demandGraph ?? null;

const sizeText = sharesOffered && priceMax != null
  ? formatLakhCr(sharesOffered * priceMax)
  : issue.issue_size?.text ?? null;

const statusLabel = status === 'current' ? 'open' : status === 'upcoming' ? 'upcoming' : status === 'past' ? 'listed' : 'filed';
const tagLine = [issueType, exchange].filter(Boolean).join('  ·  ');

const dateLine = (() => {
  if (status === 'current') {
    const d = daysFromNow(issue.timeline.close_date, today);
    if (d === 0) return 'closes today';
    if (d === 1) return 'closes tomorrow';
    if (d != null && d > 0) return `closes ${formatDateShort(issue.timeline.close_date)}`;
    return 'closed';
  }
  if (status === 'upcoming') return `opens ${formatDateLong(issue.timeline.open_date)}`;
  if (status === 'past') return issue.timeline.listing_date ? `listed ${formatDateLong(issue.timeline.listing_date)}` : '';
  return '';
})();

const standfirst = (() => {
  const parts: string[] = [];
  if (status === 'current') {
    if (sizeText) parts.push(`Raising ${sizeText}`);
    if (priceMin != null && priceMax != null) parts.push(`at ${formatRupeeRange(priceMin, priceMax)} per share`);
  } else if (status === 'upcoming') {
    if (sizeText) parts.push(`Will raise ${sizeText}`);
    if (priceMin != null && priceMax != null) parts.push(`at ${formatRupeeRange(priceMin, priceMax)} per share`);
  } else if (status === 'past' && issue.timeline.listing_date) {
    if (sizeText) parts.push(`Raised ${sizeText}`);
    const ip = issue.pricing.issue_price ?? priceMax;
    if (ip != null) parts.push(`at ${formatRupee(ip)} per share`);
  }
  return parts.join(' ');
})();

const heroFigure = (() => {
  if (status === 'current') {
    if (subscribed != null) return { value: formatTimes(subscribed), label: 'total subscription so far' };
    if (priceMin != null && priceMax != null) return { value: formatRupeeRange(priceMin, priceMax), label: 'price band per share' };
    return null;
  }
  if (status === 'upcoming') {
    if (priceMin != null && priceMax != null) return { value: formatRupeeRange(priceMin, priceMax), label: 'price band per share' };
    if (issue.pricing.issue_price != null) return { value: formatRupee(issue.pricing.issue_price), label: 'issue price' };
    return null;
  }
  if (status === 'past') {
    const g = issue.listing_performance.listing_day_gain;
    if (g != null) return { value: `${g > 0 ? '+' : ''}${g.toFixed(1)}%`, label: 'listing-day move', isGain: true, gain: g };
    return null;
  }
  return null;
})();

const documentOrder = ['DRHP', 'RHP', 'Prospectus', 'Final prospectus', 'Price Band Advertisement', 'Public issue advertisement'];
const documents = (issue.documents ?? []).slice().sort((a: any, b: any) => {
  const ai = documentOrder.indexOf(a.type);
  const bi = documentOrder.indexOf(b.type);
  return (ai === -1 ? 99 : ai) - (bi === -1 ? 99 : bi);
});

const fmtGain = (g: number | null | undefined) => g == null ? '—' : `${g > 0 ? '+' : ''}${g.toFixed(2)}%`;

type SplitRow = { key: string; label: string; times: number; offered: number | null; bid: number | null };
const splitRows: SplitRow[] = (() => {
  if (!lastTrajectory) return [];
  const order = [
    { key: 'qib', label: 'QIB' },
    { key: 'nii', label: 'NII' },
    { key: 'retail', label: 'Retail' },
    { key: 'employee', label: 'Employee' },
    { key: 'shareholder', label: 'Shareholder' },
  ];
  return order.map(({ key, label }) => {
    const c = lastTrajectory.categories[key];
    if (!c || c.times == null) return null;
    return { key, label, times: c.times, offered: c.shares_offered, bid: c.shares_bid };
  }).filter((x): x is SplitRow => x != null);
})();

type SubscriptionRow = {
  sr: string | null;
  category: string;
  offered: number | null;
  bid: number | null;
  applications: number | null;
  times: number | null;
};

const subscriptionRows: SubscriptionRow[] = (() => {
  if (issue.subscription.consolidated?.categories.length) {
    return [
      ...(issue.subscription.consolidated.total_times != null ? [{
        sr: null,
        category: 'Total',
        offered: null,
        bid: null,
        times: issue.subscription.consolidated.total_times,
        applications: null,
      }] : []),
      ...issue.subscription.consolidated.categories.map((row, idx) => ({
        sr: String(idx + 1),
        category: labelize(row.category),
        offered: row.shares_offered,
        bid: row.shares_bid,
        times: row.times,
        applications: row.applications ?? null,
      })),
    ];
  }

  const bseRows = ((exch.bse?.consolidated_bid_details?.rows ?? exch.bse?.bid_details?.rows ?? []) as any[]);
  if (bseRows.length) {
    return bseRows.map((r) => ({
      sr: cleanCell(r.SRNo),
      category: cleanCell(r.col2) ?? '',
      offered: parseNum(r.col3),
      bid: parseNum(r.col4),
      times: parseNum(r.col5),
      applications: parseNum(r.col8),
    })).filter((r) => r.category && r.category.toLowerCase() !== 'category');
  }

  const nseRows = ((exch.nse?.bid_details?.rows ?? exch.nse?.issue_detail?.data?.bidDetails ?? []) as any[]);
  if (nseRows.length) {
    return nseRows.map((r) => ({
      sr: cleanCell(r.srNo),
      category: cleanCell(r.category) ?? '',
      offered: null,
      bid: parseNum(r.noOfshareBid ?? r.noOfSharesBid),
      times: null,
      applications: parseNum(r.noofapplication),
    })).filter((r) => r.category && r.category.toLowerCase() !== 'category');
  }

  const exchangeBook = issue.subscription.by_exchange.nse ?? issue.subscription.by_exchange.bse ?? null;
  if (exchangeBook?.categories?.length) {
    return exchangeBook.categories.map((row, idx) => ({
      sr: String(idx + 1),
      category: labelize(row.category),
      offered: row.shares_offered,
      bid: row.shares_bid,
      times: row.times,
      applications: row.applications ?? null,
    }));
  }

  return splitRows.map((r) => ({
    sr: null,
    category: r.label,
    offered: r.offered,
    bid: r.bid,
    times: r.times,
    applications: null,
  }));
})();
const subscriptionMax = subscriptionRows.length
  ? Math.max(...subscriptionRows.map((r) => r.times ?? (r.bid ?? 0)), 1)
  : 0;
const isMajorSubscriptionCategory = (category: string) => {
  const text = category.toLowerCase();
  return text === 'total' ||
    text.includes('qualified institutional buyers') ||
    text === 'non institutional investors' ||
    text.includes('retail individual') ||
    text.includes('individual investors (ind category bidding for 2 lots') ||
    text === 'employee' ||
    text === 'shareholder';
};
const subscriptionTotalRow = subscriptionRows.find((row) => row.category.toLowerCase() === 'total') ?? null;
const subscriptionVisualRows = subscriptionRows
  .filter((row) => row.category.toLowerCase() !== 'total')
  .map((row) => ({
    ...row,
    metric: row.times ?? row.bid ?? 0,
    isChild: !isMajorSubscriptionCategory(row.category),
  }));
const subscriptionLeaderMetric = subscriptionVisualRows.length
  ? Math.max(...subscriptionVisualRows.map((row) => row.metric))
  : 0;
const subscriptionSourceObservedAt = issue.sources
  .filter((source) => source.source.toLowerCase() === 'bse' && source.endpoint.includes('bid_details'))
  .map((source) => source.observed_at)
  .filter(Boolean)
  .sort()
  .at(-1) ?? null;
const formatObservedAt = (value: string | null): string | null => {
  if (!value) return null;
  const date = new Date(value);
  if (Number.isNaN(date.getTime())) return null;
  return `${date.toLocaleString('en-IN', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Kolkata' })} IST`;
};
const subscriptionUpdatedAt =
  cleanCell(exch.bse?.consolidated_bid_details?.rows?.[1]?.Maxdt) ??
  cleanCell(exch.bse?.bid_details?.rows?.[1]?.Maxdt) ??
  cleanCell(exch.nse?.demand_data?.nse?.rows?.[0]?.timestamp) ??
  cleanCell(exch.nse?.issue_detail?.data?.demandGraph?.timestamp) ??
  formatObservedAt(lastTrajectory?.observed_at ?? null) ??
  formatObservedAt(subscriptionSourceObservedAt);
const subscriptionAllZero = subscriptionRows.length > 0 && subscriptionRows.every((row) =>
  (row.bid == null || row.bid === 0) &&
  (row.times == null || row.times === 0) &&
  (row.applications == null || row.applications === 0)
);

const issueInfoRows = nseIssueInfo
  .map((row) => ({
    title: cleanCell(row.title) ?? 'Exchange note',
    value: cleanCell(row.value),
    href: hrefFromValue(row.value),
  }))
  .filter((row) => row.value || row.href);
const canonicalIssueInfoRows = issue.exchange_issue_info ?? [];
const visibleIssueInfoRows = issueInfoRows.length ? issueInfoRows : canonicalIssueInfoRows;

const offerMetadataRows = nseOfferRows.flatMap((row) => {
  const wanted = [
    'industry',
    'mode_Of_Issue',
    'eligibility_Of_The_Issue',
    'tentative_No_of_Shares',
    'estimated_Total_Issue_Amount',
    'name_Of_LM_BRLM',
    'name_Of_RTA',
    'name_Of_Promoter',
    'name_Of_Market_Maker',
    'name_Of_Company_Secretary_And_Compliance_Officer',
    'website',
    'registered_Office_Region',
    'registered_Office_Address',
    'corporate_Office_Address',
    'isin',
    'corporate_Identity_Number',
  ];
  return wanted.map((key) => ({ title: labelize(key), value: cleanCell(row[key]), href: hrefFromValue(row[key]) })).filter((r) => r.value || r.href);
});

type FactLeaf = {
  value?: unknown;
  raw_excerpt?: string | null;
  source_page?: number | null;
  source_section?: string | null;
  confidence?: string | null;
};
type FactItem = { label: string; value: string; rawValue: unknown; rawExcerpt: string | null; page: number | null; section: string | null; confidence: string | null };
type DossierFact = FactItem & { path: string };
type DossierGroup = { title: string; deck: string; facts: DossierFact[] };

const isFactLeaf = (value: unknown): value is FactLeaf =>
  Boolean(value && typeof value === 'object' && 'value' in (value as Record<string, unknown>));

const readableFactText = (text: string): string => {
  const companyName = company || 'the company';
  return text
    .replace(/\s+/g, ' ')
    .trim()
    .replace(/\bOur Corporate Promoter\b/g, 'the corporate promoter')
    .replace(/\bour Corporate Promoter\b/g, 'the corporate promoter')
    .replace(/\bOur Holding Company\b/g, 'the holding company')
    .replace(/\bour Holding Company\b/g, 'the holding company')
    .replace(/\bOur Promoters\b/g, 'the promoters')
    .replace(/\bour Promoters\b/g, 'the promoters')
    .replace(/\bOur Directors\b/g, 'the directors')
    .replace(/\bour Directors\b/g, 'the directors')
    .replace(/\bOur Group Company\b/g, 'the group company')
    .replace(/\bour Group Company\b/g, 'the group company')
    .replace(/\bOur Company\b/g, companyName)
    .replace(/\bour Company\b/g, companyName)
    .replace(/\bWe have\b/g, `${companyName} has`)
    .replace(/\bwe have\b/g, `${companyName} has`)
    .replace(/\bWe are\b/g, `${companyName} is`)
    .replace(/\bwe are\b/g, `${companyName} is`)
    .replace(/\bWe derive\b/g, `${companyName} derives`)
    .replace(/\bwe derive\b/g, `${companyName} derives`)
    .replace(/\bWe operate\b/g, `${companyName} operates`)
    .replace(/\bwe operate\b/g, `${companyName} operates`)
    .replace(/\bWe cannot assure\b/g, `${companyName} cannot assure`)
    .replace(/\bwe cannot assure\b/g, `${companyName} cannot assure`)
    .replace(/\bwe sell\b/g, 'it sells')
    .replace(/\bwe will not\b/g, 'it will not')
    .replace(/^Derive\b/g, `${companyName} derives`)
    .replace(/\bour products\b/g, 'its products')
    .replace(/\bour customers\b/g, 'its customers')
    .replace(/\bour raw material suppliers\b/g, 'its raw material suppliers')
    .replace(/\bour business\b/g, 'its business')
    .replace(/\bour operations\b/g, 'its operations')
    .replace(/\bour results\b/g, 'its results')
    .replace(/\bour cash flows\b/g, 'its cash flows')
    .replace(/\bour financial condition\b/g, 'its financial condition')
    .replace(/\bour manufacturing facility\b/g, 'its manufacturing facility')
    .replace(/\bour visibility and brand\b/g, 'its visibility and brand')
    .replace(/\bour logo\b/g, 'its logo')
    .replace(/\bGeneral Corporate Purposes\b/g, 'general corporate purposes');
};

const factText = (value: unknown): string | null => {
  if (value == null || value === '') return null;
  if (typeof value === 'number') return value.toLocaleString('en-IN');
  if (typeof value === 'string') return readableFactText(value) || null;
  return null;
};

const factItem = (label: string, leaf: unknown): FactItem | null => {
  if (!isFactLeaf(leaf)) return null;
  const value = factText(leaf.value);
  if (!value) return null;
  return {
    label,
    value,
    rawValue: leaf.value,
    rawExcerpt: leaf.raw_excerpt ?? null,
    page: typeof leaf.source_page === 'number' ? leaf.source_page : null,
    section: leaf.source_section ?? null,
    confidence: leaf.confidence ?? null,
  };
};

const factList = (label: string, values: unknown, limit = 6): FactItem[] =>
  Array.isArray(values)
    ? values.map((leaf) => factItem(label, leaf)).filter((leaf): leaf is FactItem => leaf != null).slice(0, limit)
    : [];

const factLabelFromPath = (path: string): string => {
  const parts = path
    .replace(/\[\d+\]/g, '')
    .split('.')
    .filter(Boolean);
  const leaf = parts.at(-1) ?? path;
  return labelize(leaf);
};

const normalizeFinancialFactItem = (item: FactItem, path: string): FactItem => {
  if (!path.startsWith('financials.')) return item;
  const n = typeof item.rawValue === 'number' ? item.rawValue : parseNum(item.rawValue);
  if (n == null) return item;
  const value = displayFinancialValue(item.label, n, item).toLocaleString('en-IN', { maximumFractionDigits: 2 });
  return { ...item, value };
};

const collectDossierFacts = (value: unknown, path = ''): DossierFact[] => {
  if (isFactLeaf(value)) {
    const item = factItem(factLabelFromPath(path), value);
    return item && item.page != null ? [{ ...normalizeFinancialFactItem(item, path), path }] : [];
  }
  if (Array.isArray(value)) {
    return value.flatMap((child, idx) => collectDossierFacts(child, `${path}[${idx}]`));
  }
  if (value && typeof value === 'object') {
    return Object.entries(value as Record<string, unknown>).flatMap(([key, child]) =>
      collectDossierFacts(child, path ? `${path}.${key}` : key)
    );
  }
  return [];
};

const uniqueFacts = (items: FactItem[], limit = items.length): FactItem[] => {
  const seen = new Set<string>();
  const out: FactItem[] = [];
  for (const item of items) {
    const key = (item.label + ":" + item.value).toLowerCase();
    if (seen.has(key)) continue;
    seen.add(key);
    out.push(item);
    if (out.length >= limit) break;
  }
  return out;
};

const uniqueDossierFacts = (items: DossierFact[]): DossierFact[] => uniqueFacts(items) as DossierFact[];

const sourcePages = (items: (FactItem | null | undefined)[], limit = 6): string | null => {
  const pages = Array.from(new Set(items
    .map((item) => item?.page)
    .filter((page): page is number => typeof page === "number")))
    .sort((a, b) => a - b)
    .slice(0, limit);
  return pages.length ? "Source: DRHP p." + pages.join(", p.") : null;
};

const sentenceJoin = (items: string[]) => {
  const cleaned = items.map((item) => item.trim()).filter(Boolean);
  if (!cleaned.length) return null;
  return cleaned.map((item) => item.endsWith(".") ? item : item + ".").join(" ");
};

const stripTerminalPeriod = (value: string) => value.replace(/[.;]\s*$/g, '');
const lowerFirst = (value: string) => {
  if (!value || /^[A-Z]{2,}\b/.test(value) || /^Rs\.?\b/.test(value) || /^₹/.test(value) || /^INR\b/.test(value)) return value;
  return value.charAt(0).toLowerCase() + value.slice(1);
};
const sentence = (value: string | null | undefined) => {
  if (!value) return null;
  const trimmed = value.trim();
  return trimmed.endsWith('.') ? trimmed : `${trimmed}.`;
};

type ChartPoint = { label: string; value: number; source: FactItem };
const displayFinancialValue = (label: string, value: number, fact: FactItem): number => {
  const metric = label.toLowerCase();
  if (metric.includes('ratio') || metric.includes('return') || metric.includes('eps') || metric.includes('ronw') || metric.includes('roce')) {
    return value;
  }
  if (
    Number.isInteger(value) &&
    Math.abs(value) >= 100 &&
    /\d[\d,]*\.\d{2}/.test(fact.rawExcerpt ?? '')
  ) {
    return value / 100;
  }
  return value;
};
const numericFactSeries = (label: string, values: unknown, periodValues: unknown, limit = 8): ChartPoint[] => {
  if (!Array.isArray(values)) return [];
  const periods = Array.isArray(periodValues)
    ? periodValues.map((leaf) => isFactLeaf(leaf) ? factText(leaf.value) : factText(leaf))
    : [];
  return values
    .map((leaf, idx) => {
      const fact = factItem(label, leaf);
      if (!fact) return null;
      const n = typeof fact.rawValue === 'number' ? fact.rawValue : parseNum(fact.value);
      if (n == null) return null;
      return {
        label: periods[idx] ?? `P${idx + 1}`,
        value: displayFinancialValue(label, n, fact),
        source: fact,
      };
    })
    .filter((row): row is ChartPoint => row != null)
    .slice(0, limit);
};

const chartGeometry = (rows: ChartPoint[], width = 620, height = 220, pad = 28) => {
  if (!rows.length) return { width, height, zeroY: height - pad, points: '', bars: [] as { x: number; y: number; h: number; w: number; row: ChartPoint }[] };
  const values = rows.map((row) => row.value);
  const min = Math.min(0, ...values);
  const max = Math.max(0, ...values);
  const spread = max - min || 1;
  const xStep = rows.length > 1 ? (width - pad * 2) / (rows.length - 1) : 0;
  const yFor = (value: number) => height - pad - ((value - min) / spread) * (height - pad * 2);
  const zeroY = yFor(0);
  const barSlot = (width - pad * 2) / Math.max(rows.length, 1);
  const barW = Math.max(12, Math.min(42, barSlot * 0.56));
  return {
    width,
    height,
    zeroY,
    points: rows.map((row, idx) => `${pad + idx * xStep},${yFor(row.value)}`).join(' '),
    bars: rows.map((row, idx) => {
      const x = pad + idx * barSlot + (barSlot - barW) / 2;
      const y = Math.min(yFor(row.value), zeroY);
      const h = Math.max(2, Math.abs(zeroY - yFor(row.value)));
      return { x, y, h, w: barW, row };
    }),
  };
};

const pctFromText = (text: string): number | null => {
  const match = text.match(/(\d+(?:\.\d+)?)\s*%/);
  if (!match) return null;
  const pct = Number(match[1]);
  return Number.isFinite(pct) ? pct : null;
};

