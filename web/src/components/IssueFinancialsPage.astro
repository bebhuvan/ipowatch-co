---
import Base from '../layouts/Base.astro';
import { type IssueDetail } from '../lib/issues';

const { issue } = Astro.props as { issue: IssueDetail };

const company = issue.company.name ?? issue.title;
const prospectus = issue.prospectus_facts;
const facts = prospectus?.facts ?? {};
const financialFacts = facts.financials?.financials ?? {};

type FactLeaf = {
  value?: unknown;
  raw_excerpt?: string | null;
  source_page?: number | null;
  source_section?: string | null;
  confidence?: string | null;
};
type FactItem = {
  label: string;
  value: string;
  rawValue: unknown;
  rawExcerpt: string | null;
  page: number | null;
  section: string | null;
  confidence: string | null;
};
type StatementRow = {
  label: string;
  values: (FactItem | null)[];
  pages: number[];
};

const labelize = (key: string) => key
  .replace(/_/g, ' ')
  .replace(/([a-z])([A-Z])/g, '$1 $2')
  .replace(/\s+/g, ' ')
  .trim()
  .replace(/\b\w/g, (c) => c.toUpperCase());

const isFactLeaf = (value: unknown): value is FactLeaf =>
  Boolean(value && typeof value === 'object' && 'value' in (value as Record<string, unknown>));

const parseNum = (value: unknown): number | null => {
  if (typeof value === 'number') return Number.isFinite(value) ? value : null;
  if (typeof value !== 'string') return null;
  const cleaned = value.replace(/,/g, '').trim();
  if (!cleaned || cleaned === '-') return null;
  const n = Number(cleaned);
  return Number.isFinite(n) ? n : null;
};

const readableFactText = (text: string): string => {
  const companyName = company || 'the company';
  return text
    .replace(/\s+/g, ' ')
    .trim()
    .replace(/\bOur Corporate Promoter\b/g, 'the corporate promoter')
    .replace(/\bour Corporate Promoter\b/g, 'the corporate promoter')
    .replace(/\bOur Holding Company\b/g, 'the holding company')
    .replace(/\bour Holding Company\b/g, 'the holding company')
    .replace(/\bOur Promoters\b/g, 'the promoters')
    .replace(/\bour Promoters\b/g, 'the promoters')
    .replace(/\bOur Directors\b/g, 'the directors')
    .replace(/\bour Directors\b/g, 'the directors')
    .replace(/\bOur Company\b/g, companyName)
    .replace(/\bour Company\b/g, companyName)
    .replace(/\bWe have\b/g, `${companyName} has`)
    .replace(/\bwe have\b/g, `${companyName} has`)
    .replace(/\bWe are\b/g, `${companyName} is`)
    .replace(/\bwe are\b/g, `${companyName} is`)
    .replace(/\bWe derive\b/g, `${companyName} derives`)
    .replace(/\bwe derive\b/g, `${companyName} derives`)
    .replace(/\bour business\b/g, 'its business')
    .replace(/\bour operations\b/g, 'its operations')
    .replace(/\bour results\b/g, 'its results')
    .replace(/\bour cash flows\b/g, 'its cash flows')
    .replace(/\bour financial condition\b/g, 'its financial condition');
};

const factText = (value: unknown): string | null => {
  if (value == null || value === '') return null;
  if (typeof value === 'number') return value.toLocaleString('en-IN', { maximumFractionDigits: 2 });
  if (typeof value === 'string') return readableFactText(value) || null;
  return null;
};

const metricLabelFromExcerpt = (rawExcerpt: string | null, fallback: string): string => {
  if (!rawExcerpt) return fallback;
  const label = rawExcerpt
    .replace(/\s+/g, ' ')
    .trim()
    .replace(/^\(?[a-z]\)?\.?\s+/i, '')
    .replace(/\s+[-(]?\d[\d,]*(?:\.\d+)?\)?(?:\s+[-(]?\d[\d,]*(?:\.\d+)?\)?)*\s*$/g, '')
    .trim();
  return label || fallback;
};

const rawNumberHasDecimals = (rawExcerpt: string | null): boolean =>
  /\d[\d,]*\.\d{2}/.test(rawExcerpt ?? '');

const displayFinancialNumber = (label: string, value: number, fact: FactItem): number => {
  const metric = label.toLowerCase();
  if (metric.includes('ratio') || metric.includes('return') || metric.includes('eps') || metric.includes('ronw') || metric.includes('roce')) {
    return value;
  }
  if (Number.isInteger(value) && Math.abs(value) >= 100 && rawNumberHasDecimals(fact.rawExcerpt)) {
    return value / 100;
  }
  return value;
};

const formatMetricValue = (label: string, fact: FactItem | null): string => {
  if (!fact) return '—';
  const numeric = typeof fact.rawValue === 'number' ? fact.rawValue : parseNum(fact.rawValue);
  if (numeric == null) return fact.value;
  const display = displayFinancialNumber(label, numeric, fact);
  return display.toLocaleString('en-IN', { maximumFractionDigits: 2 });
};

const factItem = (label: string, leaf: unknown): FactItem | null => {
  if (!isFactLeaf(leaf)) return null;
  const value = factText(leaf.value);
  if (!value) return null;
  const rawExcerpt = leaf.raw_excerpt ?? null;
  return {
    label: label === 'Ratio' || label === 'Return / ratio' || label === 'Ratios'
      ? metricLabelFromExcerpt(rawExcerpt, label)
      : label,
    value,
    rawValue: leaf.value,
    rawExcerpt,
    page: typeof leaf.source_page === 'number' ? leaf.source_page : null,
    section: leaf.source_section ?? null,
    confidence: leaf.confidence ?? null,
  };
};

const factList = (label: string, values: unknown): FactItem[] =>
  Array.isArray(values)
    ? values.map((leaf) => factItem(label, leaf)).filter((leaf): leaf is FactItem => leaf != null)
    : [];

const sourcePages = (items: (FactItem | null | undefined)[], limit = 8): string | null => {
  const pages = Array.from(new Set(items
    .map((item) => item?.page)
    .filter((page): page is number => typeof page === 'number')))
    .sort((a, b) => a - b)
    .slice(0, limit);
  return pages.length ? 'DRHP p.' + pages.join(', p.') : null;
};

const periods = factList('Period', financialFacts.periods);
const periodLabels = periods.map((period, idx) => period.value || `P${idx + 1}`);

const seriesRow = (label: string, key: string): StatementRow | null => {
  const values = factList(label, financialFacts[key]);
  if (!values.length) return null;
  const width = Math.max(periodLabels.length, values.length);
  const padded = Array.from({ length: width }, (_, idx) => values[idx] ?? null);
  return {
    label: values[0]?.label ?? label,
    values: padded,
    pages: Array.from(new Set(values.map((fact) => fact.page).filter((page): page is number => page != null))).sort((a, b) => a - b),
  };
};

const statementRows = [
  seriesRow('Revenue from operations', 'revenue'),
  seriesRow('EBITDA', 'ebitda'),
  seriesRow('Profit after tax', 'pat'),
  seriesRow('Operating cash flow', 'cash_flow'),
  seriesRow('Total assets', 'assets'),
  seriesRow('Debt / borrowings', 'debt'),
  seriesRow('Return / ratio', 'ratios'),
].filter((row): row is StatementRow => row != null);

const detailSections = [
  { id: 'profit-loss', title: 'Profit and loss', rows: [...factList('P&L line', financialFacts.profit_and_loss), ...factList('Margin', financialFacts.margins), ...factList('Margin bridge', financialFacts.margin_bridge)] },
  { id: 'balance-sheet', title: 'Balance sheet', rows: [...factList('Balance-sheet line', financialFacts.balance_sheet), ...factList('Net worth', financialFacts.net_worth), ...factList('Borrowings', financialFacts.borrowings), ...factList('Contingent liability', financialFacts.contingent_liabilities)] },
  { id: 'cash-working-capital', title: 'Cash flow and working capital', rows: [...factList('Cash conversion', financialFacts.cash_conversion), ...factList('Working capital', financialFacts.working_capital), ...factList('Trade receivables', financialFacts.trade_receivables), ...factList('Trade payables', financialFacts.trade_payables), ...factList('Inventory', financialFacts.inventory)] },
  { id: 'ratios', title: 'Ratios and returns', rows: [...factList('EPS / NAV / RoNW', financialFacts.eps_nav_ronw), ...factList('ROE / ROCE', financialFacts.roe_roce), ...factList('Ratio', financialFacts.ratios)] },
  { id: 'segments', title: 'Revenue mix and segments', rows: [...factList('Revenue breakdown', financialFacts.revenue_breakdown), ...factList('Segment financial', financialFacts.segment_financials)] },
  { id: 'notes', title: 'Audit and notes', rows: [...factList('Auditor qualification', financialFacts.auditor_qualifications), ...factList('Accounting policy/change', financialFacts.accounting_policies_or_changes), ...factList('Notable trend', financialFacts.notable_trends)] },
].filter((section) => section.rows.length > 0);

const latestColumnIndex = periodLabels.length ? periodLabels.length - 1 : Math.max(0, ...statementRows.map((row) => row.values.length - 1));
const latestHighlights = statementRows
  .map((row) => ({ label: row.label, value: formatMetricValue(row.label, row.values[latestColumnIndex] ?? row.values.at(-1) ?? null) }))
  .filter((row) => row.value !== '—')
  .slice(0, 6);

const sourceDocument = (issue.documents ?? []).find((doc) => ['DRHP', 'RHP', 'Prospectus', 'Final prospectus'].includes(doc.type));
const qualityState = prospectus?.quality?.state ?? prospectus?.citation_validation?.state ?? null;
const description = `${company} financials from the cited prospectus extraction: reported periods, financial statement rows, ratios, cash flow and working-capital facts.`;
---

<Base title={`${company} financials`} description={description}>
  <div class="page-tight pt-12 pb-3 text-[12.5px] mute">
    <a href={issue.url_path} class="border-b border-[color:var(--color-rule-strong)]">Back to issue</a>
    <span class="mx-2 mute-2">/</span>
    <span>Financials</span>
  </div>

  <section class="page-tight pb-10">
    <div class="flex flex-wrap items-start justify-between gap-8 border-b border-[color:var(--color-ink)] pb-8">
      <div>
        <div class="label mb-4">Prospectus financials</div>
        <h1 class="headline max-w-[14ch] break-words hyphens-auto">{company}</h1>
        <p class="mt-6 serif text-[21px] leading-[1.48] text-[color:var(--color-ink-soft)] max-w-[68ch]">
          Extracted financial statement facts from the offer document, kept separate from the main issue note so the numbers, periods and citations can be inspected directly.
        </p>
      </div>
      <aside class="min-w-[240px] border-t border-[color:var(--color-ink)] pt-4">
        <div class="text-[11px] mute uppercase tracking-[0.08em]">Quality state</div>
        <div class="mt-2 serif text-[28px] leading-none">{qualityState ?? 'review'}</div>
        {sourceDocument?.url && (
          <a href={sourceDocument.url} class="mt-5 inline-block text-[12px] font-semibold border-b border-[color:var(--color-ink)]" target="_blank" rel="noreferrer">
            Open source document
          </a>
        )}
      </aside>
    </div>
  </section>

  <section class="page-tight pb-12">
    <nav class="flex flex-wrap gap-x-5 gap-y-2 text-[12px] font-semibold mute">
      <a href="#statement">Statement table</a>
      {detailSections.map((section) => <a href={`#${section.id}`}>{section.title}</a>)}
    </nav>
  </section>

  {latestHighlights.length > 0 && (
    <section class="page-tight pb-12">
      <div class="label mb-4">Latest reported period</div>
      <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-6 gap-px bg-[color:var(--color-rule)] border border-[color:var(--color-rule)]">
        {latestHighlights.map((row) => (
          <div class="bg-white p-4 min-w-0">
            <div class="text-[10px] mute uppercase tracking-[0.08em] break-words">{row.label}</div>
            <div class="mt-3 serif text-[24px] leading-tight num break-words">{row.value}</div>
          </div>
        ))}
      </div>
      {periodLabels[latestColumnIndex] && <p class="mt-3 text-[11px] mute">Latest period shown: {periodLabels[latestColumnIndex]}</p>}
    </section>
  )}

  {statementRows.length > 0 && (
    <section id="statement" class="page-tight pb-14 scroll-mt-8">
      <div class="flex flex-wrap items-baseline justify-between gap-4 mb-4">
        <div>
          <div class="label mb-3">Financial statement table</div>
          <h2 class="section-title">Reported sequence</h2>
        </div>
        <p class="text-[11px] mute max-w-[52ch]">
          Monetary rows follow the unit printed in the cited DRHP table. Blank cells mean the extractor did not produce a citation-safe value for that metric and period.
        </p>
      </div>

      <div class="overflow-x-auto border-y border-[color:var(--color-ink)]">
        <table class="w-full min-w-[760px] text-[13px]">
          <thead>
            <tr class="border-b border-[color:var(--color-rule)]">
              <th class="text-left py-3 pr-5 font-semibold">Metric</th>
              {periodLabels.map((label) => <th class="text-right py-3 px-3 font-semibold num">{label}</th>)}
              <th class="text-right py-3 pl-3 font-semibold">Source</th>
            </tr>
          </thead>
          <tbody>
            {statementRows.map((row) => (
              <tr class="border-b border-[color:var(--color-rule)] last:border-b-0">
                <th class="text-left py-3 pr-5 font-semibold align-top">{row.label}</th>
                {periodLabels.map((_, idx) => (
                  <td class="text-right py-3 px-3 num align-top">{formatMetricValue(row.label, row.values[idx] ?? null)}</td>
                ))}
                <td class="text-right py-3 pl-3 text-[11px] mute align-top">{sourcePages(row.values, 3) ?? '—'}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </section>
  )}

  {detailSections.map((section) => (
    <section id={section.id} class="page-tight pb-14 scroll-mt-8">
      <div class="grid grid-cols-1 lg:grid-cols-[260px_minmax(0,1fr)] gap-8 border-t border-[color:var(--color-ink)] pt-5">
        <div>
          <div class="label mb-3">{section.title}</div>
          <p class="text-[12px] mute leading-relaxed">
            {sourcePages(section.rows) ? `Sources: ${sourcePages(section.rows)}` : 'Citation-safe extracted facts.'}
          </p>
        </div>
        <div class="border-t border-[color:var(--color-rule)]">
          {section.rows.map((fact) => (
            <article class="grid grid-cols-1 md:grid-cols-[180px_minmax(0,1fr)_86px] gap-3 py-4 border-b border-[color:var(--color-rule)]">
              <div class="text-[10px] mute uppercase tracking-[0.08em]">{fact.label}</div>
              <p class="text-[14px] leading-relaxed">{fact.value}</p>
              <div class="text-[11px] mute md:text-right">{fact.page != null ? `p.${fact.page}` : ''}</div>
            </article>
          ))}
        </div>
      </div>
    </section>
  ))}

  {statementRows.length === 0 && detailSections.length === 0 && (
    <section class="page-tight py-16">
      <div class="border-y border-[color:var(--color-ink)] py-8">
        <h1 class="section-title">No citation-safe financial table yet</h1>
        <p class="mt-4 text-[15px] leading-relaxed max-w-[70ch]">
          The prospectus exists, but the extractor has not produced enough verified financial facts to publish a financials sub-page.
        </p>
      </div>
    </section>
  )}
</Base>
