---
// Tiny inline-SVG sparkline for total subscription times over time.
// Designed to live inside a row at ~70x22. Hairline-only, no labels.
type Props = {
  observations: { observed_at: string; total: { times: number | null } }[];
  width?: number;
  height?: number;
  label?: string;
};

const observations = (Astro.props.observations || []).slice().sort((a, b) => (a.observed_at < b.observed_at ? -1 : 1));
const W = Astro.props.width ?? 72;
const H = Astro.props.height ?? 22;

const pts = observations
  .map((o) => ({ t: new Date(o.observed_at).getTime(), v: o.total?.times ?? null }))
  .filter((p): p is { t: number; v: number } => p.v != null && Number.isFinite(p.v));

const isEmpty = pts.length === 0;
const tMin = pts.length ? pts[0].t : 0;
const tMax = pts.length ? pts[pts.length - 1].t : 1;
const tSpan = Math.max(tMax - tMin, 1);
const vMax = Math.max(1, ...pts.map((p) => p.v));
const PAD = 1.5;

const x = (t: number) => (pts.length <= 1 ? W / 2 : PAD + ((t - tMin) / tSpan) * (W - 2 * PAD));
const y = (v: number) => H - PAD - (v / vMax) * (H - 2 * PAD);

const path = pts.length > 1 ? pts.map((p, i) => `${i === 0 ? 'M' : 'L'} ${x(p.t).toFixed(2)} ${y(p.v).toFixed(2)}`).join(' ') : '';
const last = pts[pts.length - 1];
---

{isEmpty ? (
  <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} aria-label={Astro.props.label ?? 'No subscription data'}>
    <line x1={2} y1={H / 2} x2={W - 2} y2={H / 2} stroke="var(--color-ink)" stroke-width="1" stroke-dasharray="1 3" />
  </svg>
) : pts.length === 1 ? (
  <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} aria-label={Astro.props.label ?? 'Single observation'}>
    <line x1={2} y1={H / 2} x2={W - 6} y2={H / 2} stroke="var(--color-ink)" stroke-width="1" />
    <circle cx={W - 4} cy={H / 2} r="2" fill="var(--color-ink)" />
  </svg>
) : (
  <svg viewBox={`0 0 ${W} ${H}`} width={W} height={H} aria-label={Astro.props.label ?? 'Subscription trajectory'}>
    {/* baseline at v=1 if visible */}
    {vMax >= 1 && (
      <line x1={0} y1={y(1)} x2={W} y2={y(1)} stroke="var(--color-rule)" stroke-width="1" stroke-dasharray="1 3" />
    )}
    <path d={path} fill="none" stroke="var(--color-ink)" stroke-width="1.25" stroke-linejoin="round" stroke-linecap="round" />
    <circle cx={x(last.t)} cy={y(last.v)} r="2" fill="var(--color-ink)" />
  </svg>
)}
