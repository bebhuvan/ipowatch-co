---
import '../styles/global.css';
import { getManifest, getCurrent, getUpcoming } from '../lib/issues';
import { daysFromNow } from '../lib/format';

type Props = {
  title?: string;
  description?: string;
  ogType?: string;
  ogImage?: string;
  canonicalUrl?: string;
  schemas?: any[];
  geoRegion?: string;
  geoPlacename?: string;
  geoPosition?: string;
  robots?: string;
};

const {
  title = 'IPO Watch',
  description = 'Indian equity IPO and primary market data from NSE and BSE.',
  ogType = 'website',
  ogImage = '/og-image.png',
  canonicalUrl,
  schemas = [],
  geoRegion = 'IN-MH',
  geoPlacename = 'Mumbai',
  geoPosition = '19.0760;72.8777',
  robots = 'index, follow, max-image-preview:large',
} = Astro.props;

const siteName = 'IPO Watch';
const siteDomain = 'ipowatch.co';
const siteUrl = Astro.site ? Astro.site.origin : 'https://ipowatch.co';

const displayTitle = title === siteName ? `${siteName} · ${siteDomain}` : `${title} · ${siteName}`;
const canonical = canonicalUrl || new URL(Astro.url.pathname, siteUrl).href;
const ogImageAbs = ogImage.startsWith('http') ? ogImage : `${siteUrl}${ogImage}`;

const manifest = getManifest();
const builtAtSource = manifest.generated_at ?? new Date().toISOString();
const builtAt = new Date(builtAtSource).toLocaleString('en-IN', {
  day: 'numeric', month: 'short', year: 'numeric',
  hour: '2-digit', minute: '2-digit', hour12: false, timeZone: 'Asia/Kolkata',
});

const today = new Date();
const open = getCurrent();
const upcoming = getUpcoming();
const closingToday = open.filter((i) => daysFromNow(i.close_date, today) === 0).length;

const todayLong = today.toLocaleDateString('en-IN', {
  weekday: 'long', day: 'numeric', month: 'long', year: 'numeric',
});

---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon.svg" />
    <!-- Fonts self-hosted via @fontsource-variable — no external CDN round-trip -->
    <title>{displayTitle}</title>

    <!-- Canonical URL -->
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={displayTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_IN" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={canonical} />
    <meta property="twitter:title" content={displayTitle} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={ogImageAbs} />

    <!-- Robots & Search Directives -->
    <meta name="robots" content={robots} />
    <meta name="googlebot" content={robots} />

    <!-- GEO / Geotargeting Meta Tags (Indian Localized SEO) -->
    <meta name="geo.region" content={geoRegion} />
    <meta name="geo.placename" content={geoPlacename} />
    <meta name="geo.position" content={geoPosition} />
    <meta name="ICBM" content={geoPosition} />

    <!-- Additional local descriptors -->
    <meta name="DC.title" content={displayTitle} />
    <meta name="DC.description" content={description} />
    <meta name="DC.publisher" content={siteName} />
    <meta name="DC.format" content="text/html" />
    <meta name="DC.language" content="en-IN" />
    <meta name="DC.coverage" content="India" />

    <!-- Schema.org JSON-LD Structured Data -->
    {schemas && schemas.map((schema) => (
      <script type="application/ld+json" is:inline set:html={JSON.stringify(schema)} />
    ))}
  </head>
  <body class="min-h-screen">
    <header class="page site-header">
      <div class="site-header-main">
        <a href="/" class="site-brand" aria-label={`${siteName} home`}>
          <img src="/logo.svg" alt="" width="26" height="26" class="w-[26px] h-[26px] text-[color:var(--color-ink)]" />
          <span class="site-brand-wordmark">
            <span class="font-light tracking-[0.01em]">IPO</span><span class="font-normal tracking-[-0.01em]"> Watch</span>
          </span>
        </a>
        <nav class="site-nav">
          <a href="/live/">Open</a>
          <a href="/upcoming/">Upcoming</a>
          <a href="/new-filings/">New filings</a>
          <a href="/performance/">Performance</a>
          <a href="/demand/">Demand</a>
          <a href="/archive/">Archive</a>
          <a href="/academy/">Academy</a>
        </nav>
      </div>
      <div class="site-status">
        <span class="num text-[12px]">{todayLong}</span>
        <div class="flex flex-wrap items-baseline gap-x-5 gap-y-1.5">
          <span><span class="live-dot"></span><strong class="text-[color:var(--color-ink)] font-semibold num">{open.length}</strong> open</span>
          {closingToday > 0 && (
            <span><strong class="text-[color:var(--color-ink)] font-semibold num">{closingToday}</strong> close today</span>
          )}
          <span><strong class="text-[color:var(--color-ink)] font-semibold num">{upcoming.length}</strong> upcoming</span>
          <span class="text-[11px] mute-2">Updated {builtAt} IST</span>
        </div>
      </div>
    </header>

    <main>
      <slot />
    </main>

    <footer class="page pt-12 pb-12 border-t border-[color:var(--color-rule)] mt-16">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-10">
        <div>
          <div class="label mb-3">About</div>
          <p class="serif text-[15px] leading-[1.55]" style="max-width:38ch">
            IPO Watch tracks public issues on NSE and BSE. It focuses on dates,
            prices, demand, documents and post-listing returns. No grey-market premium,
            broker links or apply buttons.
          </p>
        </div>
        <div>
          <div class="label mb-3">Browse</div>
          <ul class="flex flex-col gap-1.5 text-[13px] mute">
            <li><a href="/live/">Open issues</a></li>
            <li><a href="/upcoming/">Upcoming</a></li>
            <li><a href="/new-filings/">New filings</a></li>
            <li><a href="/performance/">Performance</a></li>
            <li><a href="/demand/">Demand book</a></li>
            <li><a href="/buybacks/">Buybacks</a> · <a href="/ofs/">OFS</a> · <a href="/rights/">Rights</a></li>
            <li><a href="/archive/">Archive</a></li>
            <li><a href="/academy/">Academy</a></li>
          </ul>
        </div>
        <div>
          <div class="label mb-3">The data</div>
          <ul class="flex flex-col gap-1.5 text-[13px] mute">
            <li><a href="/dealmakers/">Dealmakers</a> · <a href="/companies/">Companies</a></li>
            <li><a href="/sectors/">Sectors</a> · <a href="/documents/">Documents</a></li>
            <li>{manifest.counts.issues.toLocaleString('en-IN')} issues</li>
            <li>{manifest.counts.companies.toLocaleString('en-IN')} companies</li>
            <li>NSE, BSE, CapMkt, Trendlyne</li>
          </ul>
        </div>
        <div>
          <div class="label mb-3">Numbers</div>
          <p class="serif italic text-[14px] mute">
            built {builtAt} IST
          </p>
        </div>
      </div>
    </footer>
  </body>
</html>
