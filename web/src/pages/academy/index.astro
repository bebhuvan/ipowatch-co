---
import Base from '../../layouts/Base.astro';
import { getCollection } from 'astro:content';
import { SECTION_ORDER, type AcademySection } from '../../lib/academy';

const allEntries = await getCollection('academy', (entry) => entry.data.status !== 'draft');

const bySection = new Map<AcademySection, typeof allEntries>();
for (const sec of SECTION_ORDER) bySection.set(sec.slug, []);
for (const entry of allEntries) {
  const bucket = bySection.get(entry.data.section);
  if (bucket) bucket.push(entry);
}
// Within each section, newest first.
for (const list of bySection.values()) {
  list.sort((a, b) => (a.data.published_at < b.data.published_at ? 1 : -1));
}

const totalArticles = allEntries.length;
---

<Base
  title="Academy"
  description="A reference for Indian primary markets — grounded in SEBI regulations, exchange rulebooks, and primary documents."
>
  <article class="academy-index page-tight">
    <header class="ax-masthead">
      <div class="ax-kicker">The Academy</div>
      <h1 class="ax-title serif">How Indian primary markets actually work.</h1>
      <p class="ax-dek serif">
        A reference for IPOs, FPOs, OFS, QIPs, rights issues and buybacks. Every claim
        sourced to SEBI regulations, exchange rulebooks, or the primary documents on
        which the market actually runs. No tip-sheets, no allotment predictions, no
        grey-market chatter.
      </p>
      <p class="ax-meta">
        {totalArticles} article{totalArticles === 1 ? '' : 's'} · five sections · last updated{' '}
        {new Date().toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' })}
      </p>
    </header>

    {SECTION_ORDER.map((section) => {
      const articles = bySection.get(section.slug) ?? [];
      return (
        <section class="ax-section" id={section.slug}>
          <div class="ax-section-head">
            <div class="ax-ordinal">{section.ordinal}</div>
            <div>
              <h2 class="ax-section-title serif">
                <a href={`/academy/${section.slug}/`}>{section.label}</a>
              </h2>
              <p class="ax-section-blurb serif">{section.blurb}</p>
            </div>
          </div>

          {articles.length === 0 ? (
            <p class="ax-empty">In preparation.</p>
          ) : (
            <ol class="ax-article-list">
              {articles.map((entry) => (
                <li>
                  <a
                    class="ax-article-link"
                    href={`/academy/${entry.data.section}/${entry.data.slug}/`}
                  >
                    <span class="ax-article-kicker">{entry.data.kicker}</span>
                    <span class="ax-article-title serif">{entry.data.title}</span>
                    <span class="ax-article-dek serif">{entry.data.dek}</span>
                    <span class="ax-article-meta">
                      {entry.data.reading_time_minutes} min read
                    </span>
                  </a>
                </li>
              ))}
            </ol>
          )}
        </section>
      );
    })}
  </article>
</Base>

<style>
  .academy-index {
    padding-top: 56px;
    padding-bottom: 96px;
    max-width: 880px;
  }

  /* Masthead */
  .ax-masthead {
    border-bottom: 2px solid var(--color-ink);
    padding-bottom: 36px;
    margin-bottom: 48px;
  }
  .ax-kicker {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-deep);
    margin-bottom: 14px;
  }
  .ax-title {
    font-size: clamp(34px, 4.6vw, 52px);
    line-height: 1.05;
    letter-spacing: -0.018em;
    font-weight: 500;
    margin: 0 0 18px;
    max-width: 22ch;
  }
  .ax-dek {
    font-size: 18px;
    line-height: 1.55;
    color: var(--color-ink-soft);
    margin: 0 0 22px;
    max-width: 62ch;
  }
  .ax-meta {
    font-family: var(--font-sans);
    font-size: 12px;
    color: var(--color-mute);
    letter-spacing: 0.01em;
  }

  /* Section block */
  .ax-section {
    border-top: 1px solid var(--color-rule);
    padding-top: 28px;
    margin-top: 40px;
  }
  .ax-section:first-of-type {
    border-top: none;
    margin-top: 0;
    padding-top: 0;
  }

  .ax-section-head {
    display: grid;
    grid-template-columns: 56px 1fr;
    gap: 18px;
    align-items: baseline;
    margin-bottom: 18px;
  }
  .ax-ordinal {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 32px;
    line-height: 1;
    color: var(--color-accent-deep);
    font-weight: 300;
    text-align: right;
    padding-top: 4px;
  }
  .ax-section-title {
    font-size: 28px;
    line-height: 1.15;
    letter-spacing: -0.012em;
    font-weight: 500;
    margin: 0 0 6px;
  }
  .ax-section-title a:hover { color: var(--color-accent-deep); }
  .ax-section-blurb {
    font-size: 15.5px;
    line-height: 1.5;
    color: var(--color-ink-soft);
    margin: 0;
    max-width: 60ch;
  }

  /* Article list under each section */
  .ax-article-list {
    list-style: none;
    padding: 0;
    margin: 0;
    padding-left: 74px;
  }
  .ax-article-list li {
    border-top: 1px solid var(--color-rule);
    padding: 18px 0;
  }
  .ax-article-list li:last-child {
    border-bottom: 1px solid var(--color-rule);
  }

  .ax-article-link {
    display: grid;
    grid-template-columns: 1fr auto;
    grid-template-areas:
      "kicker meta"
      "title  title"
      "dek    dek";
    gap: 6px 16px;
    align-items: baseline;
  }
  .ax-article-link:hover .ax-article-title { color: var(--color-accent-deep); }

  .ax-article-kicker {
    grid-area: kicker;
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-mute);
  }
  .ax-article-title {
    grid-area: title;
    font-size: 21px;
    line-height: 1.2;
    letter-spacing: -0.01em;
    font-weight: 500;
    color: var(--color-ink);
    transition: color .15s ease;
  }
  .ax-article-dek {
    grid-area: dek;
    font-size: 15px;
    line-height: 1.5;
    font-style: italic;
    color: var(--color-ink-soft);
    margin-top: 2px;
    max-width: 60ch;
  }
  .ax-article-meta {
    grid-area: meta;
    font-family: var(--font-sans);
    font-size: 11.5px;
    color: var(--color-mute);
    white-space: nowrap;
  }

  .ax-empty {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--color-mute);
    font-size: 14.5px;
    margin: 8px 0 4px;
    padding-left: 74px;
  }

  @media (max-width: 640px) {
    .ax-section-head {
      grid-template-columns: 1fr;
      gap: 4px;
    }
    .ax-ordinal {
      text-align: left;
      font-size: 24px;
    }
    .ax-article-list { padding-left: 0; }
    .ax-empty { padding-left: 0; }
  }
</style>
