---
import Base from '../layouts/Base.astro';
import { getWebsiteSchema, getOrganizationSchema, getDataCatalogSchema } from '../lib/seo';
import {
  getCurrent,
  getUpcoming,
  getRecentHistorical,
  getDetailBySlug,
  getManifest,
  getYearStats,
  getAvailableYears,
  extractIngredient,
  getRecentByType,
  getCountByType,
  getTopGainersAllTime,
  getGainDistribution,
  dedupByCompany,
  normCompany,
  getDatahub,
  sumMonthly,
  type IssueSummary,
} from '../lib/issues';
import {
  formatRupee,
  formatRupeeRange,
  formatLakhCr,
  formatDateShort,
  formatInt,
  formatTimes,
  daysFromNow,
  displayName,
} from '../lib/format';

const today = new Date();
const todayYear = today.getFullYear();

type Enriched = IssueSummary & {
  lotSize: number | null;
  raisingText: string | null;
  raisingValue: number | null;
  subscriptionTimes: number | null;
  brlmName: string | null;
};

const enrich = (issue: IssueSummary): Enriched => {
  const detail = getDetailBySlug(issue.slug);
  const ing = detail ? extractIngredient(detail) : null;
  const traj = detail?.subscription?.trajectory ?? [];
  const last = traj.length ? traj[traj.length - 1] : null;
  const subscriptionTimes = last?.total?.times ?? detail?.subscription?.times ?? null;
  return {
    ...issue,
    price_band: {
      min: issue.price_band?.min ?? ing?.priceMin ?? null,
      max: issue.price_band?.max ?? ing?.priceMax ?? null,
      text: issue.price_band?.text ?? null,
    },
    lotSize: ing?.lotSize ?? null,
    raisingText: ing?.impliedSize ? formatLakhCr(ing.impliedSize) : detail?.issue_size?.text ?? null,
    raisingValue: ing?.impliedSize ?? null,
    subscriptionTimes,
    brlmName: ing?.brlmName ?? null,
  };
};

const open: Enriched[] = getCurrent().map(enrich).sort((a, b) => {
  const da = daysFromNow(a.close_date, today) ?? 999;
  const db = daysFromNow(b.close_date, today) ?? 999;
  if (da !== db) return da - db;
  return (b.raisingValue ?? 0) - (a.raisingValue ?? 0);
});

const openNames = new Set(open.map((i) => normCompany(i.company_name)));

const upcoming: Enriched[] = getUpcoming()
  .filter((i) => !openNames.has(normCompany(i.company_name)))
  .map(enrich)
  .sort((a, b) => {
    const da = daysFromNow(a.open_date, today) ?? 999;
    const db = daysFromNow(b.open_date, today) ?? 999;
    return da - db;
  });

// Lead — largest open by implied raise; fallback to soonest-closing
const lead = (() => {
  const withSize = open.filter((i) => i.raisingValue != null);
  if (withSize.length > 0) return withSize.slice().sort((a, b) => (b.raisingValue ?? 0) - (a.raisingValue ?? 0))[0];
  return open[0] ?? null;
})();
const otherOpen = lead ? open.filter((i) => i.slug !== lead.slug).slice(0, 6) : open.slice(0, 6);

const stats = getYearStats(todayYear);

// Recently listed — dedup by company, only with listing date
const recentRaw = getRecentHistorical(80);
const recentSeen = new Set<string>();
const recent: IssueSummary[] = [];
for (const i of recentRaw) {
  const k = normCompany(i.company_name);
  if (recentSeen.has(k) || !i.listing_date) continue;
  recentSeen.add(k);
  recent.push(i);
  if (recent.length >= 8) break;
}
const recentGains = recent.map((r) => r.listing_day_gain).filter((g): g is number => g != null);
const recentGainMax = recentGains.length ? Math.max(...recentGains.map(Math.abs)) : 0;

// Distribution + monthly trend
const dist = getGainDistribution(24);
const distMax = Math.max(...dist.bins.map((b) => b.count), 1);
const distZeroIdx = dist.bins.findIndex((b) => b.from === 0);
const distZeroPct = distZeroIdx >= 0 ? (distZeroIdx / dist.bins.length) * 100 : 50;

// Other public issue types — recent buybacks, OFS, rights
const recentBuybacks = dedupByCompany(getRecentByType('Buyback', 12)).slice(0, 5);
const recentOFS = dedupByCompany(getRecentByType('OFS', 12)).slice(0, 5);
const recentRights = dedupByCompany(getRecentByType('Rights', 12)).slice(0, 5);
const countBuyback = getCountByType('Buyback');
const countOFS = getCountByType('OFS');
const countRights = getCountByType('Rights');
const countInvIT = getCountByType('InvIT');
const countREIT = getCountByType('REIT');
const countTender = getCountByType('Tender');
const countIPO = getCountByType('IPO');

// All-time leaderboards
const topGainersAllTime = getTopGainersAllTime(5, { mainboardOnly: false });

// Archive year chart
const years = getAvailableYears();
const yearStatsAll = years.map((y) => getYearStats(y));
const yearMax = Math.max(...yearStatsAll.map((s) => s.total), 1);
const peakYear = yearStatsAll.slice().sort((a, b) => b.total - a.total)[0];

// Roman numerals for ornament
const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];

const typeTag = (issue: { issue_type: string | null; exchange_platform: string | null }) => {
  const t = issue.issue_type ?? '';
  const ex = (issue.exchange_platform ?? '').replace(/\s+/g, ' ').trim();
  return [t, ex].filter(Boolean).join('  ·  ');
};

const closeTiming = (iso: string | null) => {
  const d = daysFromNow(iso, today);
  if (d == null) return '—';
  if (d === 0) return 'Closes today';
  if (d === 1) return 'Closes tomorrow';
  if (d > 0) return 'Closes ' + formatDateShort(iso);
  return 'Closed';
};

const fmtGain = (g: number | null | undefined) => g == null ? '—' : `${g > 0 ? '+' : ''}${g.toFixed(1)}%`;

/* ── SEBI / IndiaDataHub capital raising ── */
const datahub = getDatahub();
const dhAnnual = datahub?.annual ?? {};
const dhYears = Object.keys(dhAnnual).sort();

// Find the latest month with data in this year
const totalSeries = datahub?.indicators.total_raised_cr?.monthly ?? [];
const ipoSeries = datahub?.indicators.ipo_raised_cr?.monthly ?? [];
const thisYearObs = totalSeries.filter((o) => o.date?.startsWith(String(todayYear)));
const latestObsDate = thisYearObs.length ? thisYearObs[thisYearObs.length - 1].date : '';
const latestMonthIdx = latestObsDate ? Number(latestObsDate.slice(5, 7)) : 0;
const ytdFromIso = `${todayYear}-01-01`;
const ytdToIso = latestObsDate || `${todayYear}-12-31`;
const lastYearYtdFromIso = `${todayYear - 1}-01-01`;
const lastYearYtdToIso = latestMonthIdx
  ? `${todayYear - 1}-${String(latestMonthIdx).padStart(2,'0')}-31`
  : `${todayYear - 1}-12-31`;

const ytdTotalRaised = sumMonthly(totalSeries, ytdFromIso, ytdToIso);
const ytdIpoRaised = sumMonthly(ipoSeries, ytdFromIso, ytdToIso);
const lastYearYtdTotal = sumMonthly(totalSeries, lastYearYtdFromIso, lastYearYtdToIso);
const yoyTotal = lastYearYtdTotal > 0 ? ((ytdTotalRaised - lastYearYtdTotal) / lastYearYtdTotal) * 100 : null;

// YTD counts per type
const sumCountMonthly = (key: string): number => sumMonthly(datahub?.indicators[key]?.monthly, ytdFromIso, ytdToIso);
const ytdMainboardCount = sumCountMonthly('ipo_mainboard_count');
const ytdSmeCount = sumCountMonthly('ipo_sme_count');
const ytdFpoCount = sumCountMonthly('fpo_count');
const ytdRightsCount = sumCountMonthly('rights_count');
const ytdQipCount = sumCountMonthly('qip_count');
const ytdPrefCount = sumCountMonthly('preferential_count');

// YTD raised per type
const sumRaisedMonthly = (key: string): number => sumMonthly(datahub?.indicators[key]?.monthly, ytdFromIso, ytdToIso);
const ytdMainboardRaised = sumRaisedMonthly('ipo_mainboard_raised_cr');
const ytdSmeRaised = sumRaisedMonthly('ipo_sme_raised_cr');
const ytdFpoRaised = sumRaisedMonthly('fpo_raised_cr');
const ytdRightsRaised = sumRaisedMonthly('rights_raised_cr');
const ytdQipRaised = sumRaisedMonthly('qip_raised_cr');
const ytdPrefRaised = sumRaisedMonthly('preferential_raised_cr');
const ytdIpoCount = ytdMainboardCount + ytdSmeCount;
const ytdAllIssueCount = ytdIpoCount + ytdFpoCount + ytdRightsCount + ytdQipCount + ytdPrefCount;
const ytdIpoShare = ytdTotalRaised > 0 ? (ytdIpoRaised / ytdTotalRaised) * 100 : null;
const ytdInstrumentRows = [
  { label: 'Mainboard IPO', short: 'Mainboard', count: ytdMainboardCount, raised: ytdMainboardRaised, tone: 'ink' },
  { label: 'SME IPO', short: 'SME', count: ytdSmeCount, raised: ytdSmeRaised, tone: 'accent' },
  { label: 'FPO', short: 'FPO', count: ytdFpoCount, raised: ytdFpoRaised, tone: 'mute' },
  { label: 'Rights', short: 'Rights', count: ytdRightsCount, raised: ytdRightsRaised, tone: 'gold' },
  { label: 'QIP', short: 'QIP', count: ytdQipCount, raised: ytdQipRaised, tone: 'stone' },
  { label: 'Preferential', short: 'Pref.', count: ytdPrefCount, raised: ytdPrefRaised, tone: 'sand' },
];
const ytdInstrumentMaxRaised = Math.max(...ytdInstrumentRows.map((t) => t.raised), 1);
const ytdTopInstrument = ytdInstrumentRows.slice().sort((a, b) => b.raised - a.raised)[0] ?? null;
const ytdPositivePct = Math.round((dist.positive / Math.max(1, dist.total)) * 100);

// Annual chart data: capital raised by type, stacked, per year (₹ Cr)
type AnnualStack = { year: string; total: number; mainboard: number; sme: number; fpo: number; rights: number; qip: number; pref: number };
const annualStack: AnnualStack[] = dhYears.map((y) => {
  const r = dhAnnual[y] ?? {};
  return {
    year: y,
    mainboard: r.ipo_mainboard_raised_cr ?? 0,
    sme: r.ipo_sme_raised_cr ?? 0,
    fpo: r.fpo_raised_cr ?? 0,
    rights: r.rights_raised_cr ?? 0,
    qip: r.qip_raised_cr ?? 0,
    pref: r.preferential_raised_cr ?? 0,
    total: r.total_raised_cr ?? 0,
  };
});
const annualStackMax = Math.max(...annualStack.map((a) => a.total), 1);

// IPO count per year (mainboard + SME stacked)
const annualIpoCounts = dhYears.map((y) => ({
  year: y,
  mainboard: dhAnnual[y]?.ipo_mainboard_count ?? 0,
  sme: dhAnnual[y]?.ipo_sme_count ?? 0,
}));
const annualIpoMax = Math.max(...annualIpoCounts.map((a) => a.mainboard + a.sme), 1);

// Formatters
const fmtCr = (cr: number): string => {
  if (cr >= 1_00_000) return `₹${(cr / 1_00_000).toFixed(2)} L Cr`;
  return `₹${Math.round(cr).toLocaleString('en-IN')} Cr`;
};
const latestMonthLabel = latestObsDate
  ? new Date(latestObsDate).toLocaleDateString('en-IN', { month: 'short', year: 'numeric' })
  : '';

const closingToday = open.filter((i) => daysFromNow(i.close_date, today) === 0).length;
const hottest = open.filter((i) => i.subscriptionTimes != null).sort((a, b) => (b.subscriptionTimes ?? 0) - (a.subscriptionTimes ?? 0))[0] ?? null;

const toLocalISODate = (d: Date) => {
  const y = d.getFullYear();
  const m = String(d.getMonth() + 1).padStart(2, '0');
  const day = String(d.getDate()).padStart(2, '0');
  return `${y}-${m}-${day}`;
};

// Build a 7-day pipeline (today + 6 days ahead)
type PipeEvent = { name: string; verb: 'Closes' | 'Opens'; tag: string; url: string };
type PipeRow = {
  date: Date;
  dow: string;
  dnum: string;
  month: string;
  fullDate: string;
  isWeekend: boolean;
  isToday: boolean;
  events: PipeEvent[];
};
const pipeline: PipeRow[] = [];
for (let i = 0; i < 7; i++) {
  const d = new Date(today.getFullYear(), today.getMonth(), today.getDate() + i);
  const dow = d.toLocaleDateString('en-IN', { weekday: 'short' });
  const dnum = String(d.getDate());
  const month = d.toLocaleDateString('en-IN', { month: 'short' });
  const fullDate = d.toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'long' });
  const isWeekend = d.getDay() === 0 || d.getDay() === 6;
  const iso = toLocalISODate(d);
  const events: PipeRow['events'] = [];
  for (const issue of open) {
    if (issue.close_date === iso) {
      events.push({ name: issue.company_name, verb: 'Closes', tag: typeTag(issue), url: issue.url_path });
    }
  }
  for (const issue of upcoming) {
    if (issue.open_date === iso) {
      events.push({ name: issue.company_name, verb: 'Opens', tag: typeTag(issue), url: issue.url_path });
    }
    if (issue.close_date === iso) {
      events.push({ name: issue.company_name, verb: 'Closes', tag: typeTag(issue), url: issue.url_path });
    }
  }
  events.sort((a, b) => {
    if (a.verb !== b.verb) return a.verb === 'Closes' ? -1 : 1;
    return a.name.localeCompare(b.name);
  });
  pipeline.push({ date: d, dow, dnum, month, fullDate, isWeekend, isToday: i === 0, events });
}
const pipelineEvents = pipeline.flatMap((row) => row.events);
const pipelineOpenCount = pipelineEvents.filter((event) => event.verb === 'Opens').length;
const pipelineCloseCount = pipelineEvents.filter((event) => event.verb === 'Closes').length;
const busiestPipelineDay = pipeline
  .filter((row) => row.events.length > 0)
  .sort((a, b) => b.events.length - a.events.length || a.date.getTime() - b.date.getTime())[0] ?? null;

// Subscription window progress for the lead
let leadProgressPct = 0;
let leadOpenedText = '';
let leadClosesText = '';
if (lead && lead.open_date && lead.close_date) {
  const oISO = lead.open_date;
  const cISO = lead.close_date;
  const o = new Date(oISO + 'T10:00:00');
  const c = new Date(cISO + 'T17:00:00');
  const elapsed = Math.max(0, today.getTime() - o.getTime());
  const total = Math.max(1, c.getTime() - o.getTime());
  leadProgressPct = Math.max(0, Math.min(100, (elapsed / total) * 100));
  leadOpenedText = `Opened ${new Date(oISO).toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short' })}`;
  leadClosesText = `Closes ${new Date(cISO).toLocaleDateString('en-IN', { weekday: 'short', day: 'numeric', month: 'short' })}, 17:00`;
}

const leadContext = (() => {
  if (!lead) return '';
  // Narrative hook only — the price band, lot, retail minimum and issue
  // size all live in the adjacent table, so the prose must not echo them.
  const parts: string[] = [];
  if (lead.raisingText) parts.push(`Raising ${lead.raisingText}`);
  return parts.join(' ');
})();

// Total raised this year (best effort — sum from detail when available)
// Skipped for now; we'll show what's robust.

const manifest = getManifest();

const schemas = [
  getWebsiteSchema(),
  getOrganizationSchema(),
  getDataCatalogSchema({ issues: manifest.counts.issues ?? 0, companies: manifest.counts.companies ?? 0 }),
];
const metaDescription = "Track live and upcoming Indian public IPOs (NSE and BSE) with real-time subscription numbers, pricing, lot sizes, prospectus documents, and post-listing performance.";
---

<Base title="IPO Watch" description={metaDescription} schemas={schemas}>

<!-- ════════════  PITCH  ════════════ -->
<div class="page-tight pt-7 pb-6 border-b border-[color:var(--color-rule)]">
  <p class="serif italic text-[16px] leading-[1.55] text-[color:var(--color-mute)] max-w-[80ch]">
    Live subscription data, prices, prospectus documents, and post-listing returns
    for every public issue on NSE and BSE — since 2001.
  </p>
</div>

<!-- ════════════  LEAD  ════════════ -->
{lead && (
  <section class="page-tight pt-14 pb-14 md:pt-24 md:pb-24 border-b border-[color:var(--color-rule)]">
    <a href={lead.url_path} class="block">
      <div class="grid grid-cols-1 md:grid-cols-[1.4fr_1fr] gap-y-10 md:gap-x-8">
        <div>
          <div class="mb-7 inline-flex items-center gap-2 text-[10.5px] tracking-[0.18em] uppercase font-semibold text-[color:var(--color-accent)]">
            <span class="live-dot"></span> Today's book
          </div>
          <h1 class="headline mb-7 max-w-[18ch] break-words">{displayName(lead.company_name, { dropSuffix: true })}</h1>
          <p class="lede max-w-[34ch] mb-7">
            {leadContext ? <>{leadContext}. </> : ''}
            {lead.subscriptionTimes != null
              ? <>Subscribed <em class="italic acc font-medium">{formatTimes(lead.subscriptionTimes)}</em> so far. </>
              : (!leadContext ? <>Open for subscription. </> : '')}
            {lead.close_date ? `Closes ${new Date(lead.close_date).toLocaleDateString('en-IN', { weekday: 'long', day: 'numeric', month: 'short' })}.` : ''}
          </p>
          <div class="flex flex-wrap gap-x-[14px] gap-y-1 text-[12.5px] mute">
            <span class="pr-[14px] border-r border-[color:var(--color-rule)]">{lead.issue_type ?? 'IPO'}</span>
            <span class="pr-[14px] border-r border-[color:var(--color-rule)]">{lead.exchange_platform}</span>
            {lead.brlmName && <span class="pr-[14px] border-r border-[color:var(--color-rule)]">BRLM · {lead.brlmName}</span>}
          </div>
          {lead.open_date && lead.close_date && (
            <div class="mt-9 max-w-[36ch]">
              <div class="flex justify-between items-baseline text-[11px] tracking-[0.08em] uppercase mute font-semibold mb-2">
                <span>Subscription window</span>
                <span class="num">{Math.round(leadProgressPct)}%</span>
              </div>
              <div class="h-[3px] bg-[color:var(--color-rule)] relative overflow-hidden">
                <div class="absolute inset-y-0 left-0 bg-[color:var(--color-accent)]" style={`width: ${leadProgressPct}%`}></div>
              </div>
              <div class="flex justify-between text-[11.5px] mute mt-2">
                <span>{leadOpenedText}</span>
                <span class="text-[color:var(--color-ink)] num">{leadClosesText}</span>
              </div>
            </div>
          )}
        </div>
        <aside class="md:border-l md:border-[color:var(--color-rule)] md:pl-8">
          <p class="serif italic text-[15px] text-[color:var(--color-mute)] mb-6">The deal, in numbers</p>
          <div class="border-t border-[color:var(--color-ink)]">
            <div class="flex justify-between items-baseline py-[16px] border-b border-[color:var(--color-rule)]">
              <span class="stat-label">Price band</span>
              <span class="serif text-[26px] num leading-tight">{formatRupeeRange(lead.price_band.min, lead.price_band.max)}</span>
            </div>
            <div class="flex justify-between items-baseline py-[16px] border-b border-[color:var(--color-rule)]">
              <span class="stat-label">Shares per lot</span>
              <span class="serif text-[26px] num leading-tight">{lead.lotSize ? formatInt(lead.lotSize) : '—'}</span>
            </div>
            <div class="flex justify-between items-baseline py-[16px] border-b border-[color:var(--color-rule)]">
              <span class="stat-label">Retail minimum</span>
              <span class="serif text-[26px] num leading-tight">{lead.lotSize && lead.price_band.max ? formatRupee(lead.lotSize * lead.price_band.max) : '—'}</span>
            </div>
            <div class="flex justify-between items-baseline py-[16px] border-b border-[color:var(--color-rule)]">
              <span class="stat-label">Issue size</span>
              <span class="serif text-[26px] num leading-tight">{lead.raisingText ?? '—'}</span>
            </div>
          </div>
        </aside>
      </div>
    </a>
  </section>
)}

<!-- ════════════  BANNER  ════════════ -->
{(closingToday > 0 || hottest) && (
  <section class="page-tight py-8 md:py-12 border-b border-[color:var(--color-rule)]">
    <p class="mx-auto max-w-[72ch] border-y border-[color:var(--color-rule)] py-6 text-center serif text-[24px] leading-[1.4] text-[color:var(--color-ink-soft)]">
      {closingToday > 0 && (
        <><span class="num text-[color:var(--color-ink)]">{closingToday}</span> of <span class="num text-[color:var(--color-ink)]">{open.length}</span> open issues close today.</>
      )}
      {hottest && hottest.subscriptionTimes && (
        <> <span class="text-[color:var(--color-ink)]">{displayName(hottest.company_name)}</span> is the most subscribed at <span class="text-[color:var(--color-accent)] num">{formatTimes(hottest.subscriptionTimes)}</span>.</>
      )}
    </p>
  </section>
)}

<!-- ════════════  CURRENTLY OPEN  ════════════ -->
{otherOpen.length > 0 && (
  <section class="page-tight py-14 md:py-24 border-b border-[color:var(--color-rule)]">
    <header class="flex items-baseline justify-between mb-10">
      <h2 class="section-title">Currently open for subscription</h2>
      <a href="/live/" class="label hover:text-[color:var(--color-accent)]">All {open.length} open →</a>
    </header>
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
      {otherOpen.map((issue, idx) => {
        const subPct = issue.subscriptionTimes != null ? Math.min(100, (Math.min(issue.subscriptionTimes, 10) / 10) * 100) : 0;
        return (
          <a href={issue.url_path} class="open-card group block bg-white border border-[color:var(--color-rule-card)] p-[28px_32px_24px] relative overflow-hidden transition-all duration-300 hover:border-[color:var(--color-accent)] hover:bg-[color:var(--color-paper-warm)]">
            <span class="absolute top-[20px] right-[26px] serif italic font-light text-[22px] leading-none text-[color:var(--color-mute-2)] group-hover:text-[color:var(--color-accent)] transition-colors">{ROMAN[idx] ?? idx + 1}</span>
            <div class="flex items-center gap-[10px] text-[10px] tracking-[0.18em] uppercase font-semibold mute mb-4 pr-[40px]">
              <span class="issue-badge issue-badge-live">Live</span>
              <span>{typeTag(issue)}{issue.brlmName ? ` · ${issue.brlmName}` : ''}</span>
            </div>
            <h3 class="t-title mb-2 group-hover:text-[color:var(--color-accent-deep)] transition-colors">{displayName(issue.company_name)}</h3>
            <p class="text-[12.5px] mute mb-7 max-w-[38ch]">
              {issue.subscriptionTimes != null
                ? <>Demand running ahead of issue — bids of <em class="serif italic font-medium text-[color:var(--color-accent)] text-[14px]">{formatTimes(issue.subscriptionTimes)} the offer</em>.</>
                : closeTiming(issue.close_date) === 'Closes today'
                  ? 'Final day of subscription. Bid book opens 10:00, closes 17:00 IST.'
                  : 'Open for subscription. Bid book accepting orders.'}
            </p>
            <div class="grid grid-cols-2 gap-[14px_24px] pt-4 border-t border-[color:var(--color-rule)]">
              <div>
                <div class="label mb-1">Price band</div>
                <div class="serif text-[19px] num leading-tight">{formatRupeeRange(issue.price_band.min, issue.price_band.max)}</div>
              </div>
              <div>
                <div class="label mb-1">Shares per lot</div>
                <div class="serif text-[19px] num leading-tight">{issue.lotSize ? formatInt(issue.lotSize) : '—'}</div>
              </div>
              <div>
                <div class="label mb-1">Retail minimum</div>
                <div class="serif text-[19px] num leading-tight">{issue.lotSize && issue.price_band.max ? formatRupee(issue.lotSize * issue.price_band.max) : '—'}</div>
              </div>
              <div>
                <div class="label mb-1">Issue size</div>
                <div class="serif text-[19px] num leading-tight">{issue.raisingText ?? '—'}</div>
              </div>
            </div>
            <div class="flex items-baseline justify-between gap-4 mt-4 pt-[14px] border-t border-[color:var(--color-rule)]">
              <div class="flex items-center gap-3 flex-1 min-w-0">
                <span class="flex-none w-[90px] h-[3px] bg-[color:var(--color-rule)] relative overflow-hidden">
                  {issue.subscriptionTimes != null && (
                    <span class="absolute inset-y-0 left-0 bg-[color:var(--color-accent)]" style={`width: ${subPct}%`}></span>
                  )}
                </span>
                <span class={`serif font-medium text-[15px] ${issue.subscriptionTimes != null ? '' : 'mute font-normal'}`}>
                  {issue.subscriptionTimes != null ? `${formatTimes(issue.subscriptionTimes)} subscribed` : 'Awaiting first bids'}
                </span>
              </div>
              <span class={`text-[11px] tracking-[0.12em] uppercase font-semibold whitespace-nowrap ${daysFromNow(issue.close_date, today) === 0 ? 'text-[color:var(--color-accent)]' : 'mute'}`}>
                {closeTiming(issue.close_date)}
              </span>
            </div>
          </a>
        );
      })}
    </div>
  </section>
)}

<!-- ════════════  PIPELINE  ════════════ -->
<section class="cv-section page-tight py-14 md:py-24 border-b border-[color:var(--color-rule)]">
  <header class="flex flex-wrap items-baseline justify-between gap-5 mb-12">
    <div>
      <h2 class="section-title">The week ahead</h2>
      {pipelineEvents.length > 0 && (
        <p class="mt-2 text-[13px] mute">
          <span class="num text-[color:var(--color-ink)] font-semibold">{formatInt(pipelineOpenCount)}</span> opening{pipelineOpenCount !== 1 ? 's' : ''},&nbsp;
          <span class="num text-[color:var(--color-accent)] font-semibold">{formatInt(pipelineCloseCount)}</span> closing{pipelineCloseCount !== 1 ? 's' : ''}
