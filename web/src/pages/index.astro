              <div class="relative h-[5px] hidden sm:block">
                <span class="absolute top-0 bottom-0 left-1/2 w-px bg-[color:var(--color-rule)]"></span>
                {g != null && (
                  <span
                    class={`absolute top-0 bottom-0 ${idx === 0 ? 'bg-[color:var(--color-accent)]' : 'bg-[color:var(--color-ink)]'}`}
                    style={isNeg
                      ? `right: 50%; width: ${(pct/2).toFixed(1)}%;`
                      : `left: 50%; width: ${(pct/2).toFixed(1)}%;`}
                  ></span>
                )}
              </div>
              <span class="text-[11.5px] mute num text-right hidden sm:block">{i.listing_date ? formatDateShort(i.listing_date) : '—'}</span>
              <span class={`serif text-[22px] num text-right ${idx === 0 ? 'acc' : ''} ${isNeg ? 'italic mute' : ''}`}>{fmtGain(g)}</span>
            </a>
          </li>
        );
      })}
    </ol>
  </section>
)}

