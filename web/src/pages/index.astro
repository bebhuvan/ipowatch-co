        <div class="pt-0.5">
          <span class={`block text-[11px] tracking-[0.12em] uppercase font-semibold ${row.isToday ? 'text-[color:var(--color-accent)]' : 'mute'}`}>
            {row.isToday ? 'Today' : row.dow}
          </span>
          <span class={`block serif font-light text-[40px] sm:text-[46px] leading-[0.92] num mt-1 ${row.isToday ? 'text-[color:var(--color-accent)]' : row.isWeekend ? 'text-[color:var(--color-mute-2)]' : 'text-[color:var(--color-ink)]'}`}>
            {row.dnum}
          </span>
          <span class={`block text-[11px] tracking-[0.12em] uppercase font-semibold mt-1 ${row.isWeekend ? 'text-[color:var(--color-mute-2)]' : 'mute'}`}>
            {row.month}
          </span>
        </div>

        {/* Events column */}
        <div class="min-w-0 pt-0.5">
          {row.events.length === 0 ? (
            <p class="serif italic text-[15px] text-[color:var(--color-mute-2)] mt-2">
              {row.isWeekend ? 'Markets closed' : 'Nothing scheduled'}
