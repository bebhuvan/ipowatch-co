              <span class="absolute left-0 top-0 bottom-0 w-[2px] bg-[color:var(--color-accent)] scale-y-0 origin-center group-hover:scale-y-100 transition-transform"></span>
              <span class="serif italic font-light text-[16px] text-[color:var(--color-mute-2)] num">{String(idx + 1).padStart(2, '0')}</span>
              <div class="min-w-0">
                <h3 class="t-title truncate group-hover:text-[color:var(--color-accent)] transition-colors">{displayName(i.company_name)}</h3>
                <p class="text-[11.5px] mute mt-[3px]">{typeTag(i)}</p>
