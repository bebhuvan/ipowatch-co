                <a href={e.url} class="group flex items-baseline gap-3 sm:gap-5 py-3 first:pt-0">
                  <span class={`shrink-0 text-[10px] tracking-[0.12em] uppercase font-bold w-[42px] ${e.verb === 'Closes' ? 'text-[color:var(--color-accent)]' : 'text-[color:var(--color-ink-soft)]'}`}>
                    {e.verb}
                  </span>
                  <span class="serif font-medium text-[17px] leading-[1.25] group-hover:text-[color:var(--color-accent-deep)] transition-colors min-w-0 truncate">
                    {displayName(e.name)}
                  </span>
                  <span class="hidden sm:block text-[11px] mute shrink-0 ml-auto">{e.tag}</span>
                </a>
              ))}
            </div>
          )}
        </div>
      </div>
    ))}
  </div>
</section>

<!-- ════════════  YEAR IN CAPITAL MARKETS  ════════════ -->
<section class="cv-section page-tight py-14 md:py-24 border-b border-[color:var(--color-rule)]">
  <header class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_auto] gap-7 md:gap-12 items-end mb-12">
    <div>
      <h2 class="section-title mb-3">Primary market in {todayYear}</h2>
      <p class="t-sub max-w-[46ch]">
        Capital raised through IPOs, rights issues, QIPs, FPOs and preferential allotments.
      </p>
    </div>
    <span class="label md:text-right">Data: SEBI{latestMonthLabel ? ` · through ${latestMonthLabel}` : ''}</span>
  </header>

  <div class="grid grid-cols-1 lg:grid-cols-[1.15fr_0.85fr] gap-10 mb-14">
    <div class="border-t border-[color:var(--color-ink)] pt-6">
      <p class="label mb-4">Year-to-date primary capital</p>
      <p class="serif font-light text-[clamp(40px,6vw,64px)] leading-[0.98] tracking-[-0.014em] num">{fmtCr(ytdTotalRaised)}</p>
      <p class="lede mt-6 max-w-[38ch]">
        IPOs account for <em class="italic acc">{ytdIpoShare == null ? '—' : `${ytdIpoShare.toFixed(0)}%`}</em> of primary capital captured so far, with <em class="italic acc">{formatInt(ytdIpoCount)}</em> IPOs across mainboard and SME.
      </p>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-0 mt-8 border-y border-[color:var(--color-rule)]">
        <div class="py-4 pr-4 border-r border-[color:var(--color-rule)]">
          <p class="t-stat num">{formatInt(ytdAllIssueCount)}</p>
          <p class="label mt-2">Issue count</p>
        </div>
        <div class="py-4 px-4 border-r border-[color:var(--color-rule)]">
          <p class="t-stat num">{formatInt(ytdIpoCount)}</p>
          <p class="label mt-2">IPOs</p>
        </div>
        <div class="py-4 px-4 border-r border-[color:var(--color-rule)]">
          <p class={`t-stat num ${yoyTotal != null && yoyTotal >= 0 ? 'acc' : ''}`}>{yoyTotal == null ? '—' : `${yoyTotal >= 0 ? '+' : ''}${yoyTotal.toFixed(0)}%`}</p>
          <p class="label mt-2">YoY capital</p>
        </div>
        <div class="py-4 pl-4">
          <p class="t-stat acc num">{stats.top_gainer ? fmtGain(stats.top_gainer.listing_day_gain) : '—'}</p>
          <p class="label mt-2">Best day one</p>
        </div>
      </div>
    </div>

    <aside class="border-t border-[color:var(--color-ink)] pt-6">
      <p class="label mb-4">What this means</p>
      <div class="space-y-4">
        <p class="serif text-[22px] leading-[1.35] text-[color:var(--color-ink-soft)]">
          {ytdTopInstrument
            ? <>The largest bucket is <span class="text-[color:var(--color-ink)]">{ytdTopInstrument.label}</span>, at <span class="text-[color:var(--color-ink)] num">{fmtCr(ytdTopInstrument.raised)}</span>.</>
            : <>Capital buckets are still loading.</>}
        </p>
        <p class="text-[13px] leading-[1.65] mute">
          {dist.median != null
            ? <>Across the last twenty-four months of IPO Watch-tracked listings, the median first-day move is <span class="num text-[color:var(--color-ink)]">{fmtGain(dist.median)}</span>; <span class="num text-[color:var(--color-ink)]">{ytdPositivePct}%</span> of issues opened above their offer price.</>
            : <>Listing-day distribution will appear once enough recent listings have price coverage.</>}
        </p>
        {stats.top_gainer && (
          <a href={stats.top_gainer.url_path} class="block border border-[color:var(--color-rule-card)] bg-white px-5 py-4 hover:border-[color:var(--color-accent)] hover:bg-[color:var(--color-paper-warm)] transition-colors">
            <p class="label mb-2">Best listing day</p>
            <p class="t-value">{displayName(stats.top_gainer.company_name)}</p>
            <p class="mt-2 text-[12px] mute num">{fmtGain(stats.top_gainer.listing_day_gain)} on listing</p>
          </a>
        )}
      </div>
    </aside>
  </div>

  <div class="mb-16">
    <div class="flex flex-wrap items-baseline justify-between gap-4 mb-5">
      <h3 class="serif font-medium text-[18px]">By instrument, year to date</h3>
      <span class="label">Counts and capital raised</span>
    </div>
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
      {ytdInstrumentRows.map((t) => {
        const pct = Math.max(2, (t.raised / ytdInstrumentMaxRaised) * 100);
        const barColor = t.tone === 'accent'
          ? 'var(--color-accent)'
          : t.tone === 'gold'
            ? 'var(--color-mute)'
            : t.tone === 'mute'
              ? 'var(--color-ink-2)'
              : t.tone === 'stone'
                ? 'var(--color-ink-4)'
                : t.tone === 'sand'
                  ? 'var(--color-ink-5)'
                  : 'var(--color-ink)';
        return (
          <div class="border border-[color:var(--color-rule-card)] bg-white px-5 py-5">
            <div class="flex items-start justify-between gap-4">
              <div>
                <p class="label">{t.label}</p>
                <p class="t-stat mt-3 num">{formatInt(t.count)}</p>
              </div>
              <p class="serif text-[19px] leading-tight text-right num">{t.raised > 0 ? fmtCr(t.raised) : '—'}</p>
            </div>
            <div class="mt-5 h-[3px] bg-[color:var(--color-rule)] overflow-hidden">
              <div class="h-full" style={`width: ${pct.toFixed(1)}%; background: ${barColor}`}></div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  {annualStack.length > 0 && (
    <div class="border-t border-[color:var(--color-rule)] pt-10 mb-16">
      <header class="grid grid-cols-1 md:grid-cols-[minmax(0,1fr)_auto] gap-3 md:gap-8 items-end mb-6">
        <div>
          <h3 class="serif font-medium text-[18px]">Capital raised per year</h3>
          <p class="text-[12.5px] mute mt-1">Stacked by instrument; scaled to the largest year in the series.</p>
        </div>
        <span class="label md:text-right">₹ Cr · {annualStack[0]?.year}-{annualStack[annualStack.length - 1]?.year}</span>
      </header>
      <div class="border border-[color:var(--color-rule-card)] bg-white p-4 sm:p-6">
        <div class="flex flex-wrap gap-x-4 gap-y-2 text-[11.5px] mute mb-6">
          <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-3 bg-[color:var(--color-ink)]"></span>Mainboard IPO</span>
          <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-3 bg-[color:var(--color-accent)]"></span>SME IPO</span>
          <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-3 bg-[color:var(--color-ink-2)]"></span>FPO</span>
          <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-3 bg-[color:var(--color-mute)]"></span>Rights</span>
          <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-3 bg-[color:var(--color-ink-4)]"></span>QIP</span>
          <span class="inline-flex items-center gap-1.5"><span class="inline-block w-3 h-3 bg-[color:var(--color-ink-5)]"></span>Preferential</span>
        </div>
        <div class="min-w-0 overflow-x-auto">
          <div class="flex gap-1 h-[240px] min-w-[720px]">
            {annualStack.map((a) => {
              const hTotal = (a.total / annualStackMax) * 100;
              const seg = (v: number) => a.total > 0 ? (v / a.total) * hTotal : 0;
              return (
                <div class="flex-1 h-full flex flex-col justify-end min-w-0 group relative" title={`${a.year}: ₹${a.total.toLocaleString('en-IN')} Cr`}>
                  <div style={`height: ${seg(a.pref)}%; min-height: ${a.pref > 0 ? '1px' : '0'};`} class="bg-[color:var(--color-ink-5)]"></div>
                  <div style={`height: ${seg(a.qip)}%; min-height: ${a.qip > 0 ? '1px' : '0'};`} class="bg-[color:var(--color-ink-4)]"></div>
                  <div style={`height: ${seg(a.rights)}%; min-height: ${a.rights > 0 ? '1px' : '0'};`} class="bg-[color:var(--color-mute)]"></div>
                  <div style={`height: ${seg(a.fpo)}%; min-height: ${a.fpo > 0 ? '1px' : '0'};`} class="bg-[color:var(--color-ink-2)]"></div>
                  <div style={`height: ${seg(a.sme)}%; min-height: ${a.sme > 0 ? '1px' : '0'};`} class="bg-[color:var(--color-accent)]"></div>
                  <div style={`height: ${seg(a.mainboard)}%; min-height: ${a.mainboard > 0 ? '1px' : '0'};`} class="bg-[color:var(--color-ink)]"></div>
                </div>
              );
            })}
          </div>
          <div class="flex justify-between mt-3 text-[11px] mute num min-w-[720px]">
            <span>{annualStack[0]?.year}</span>
            <span>{annualStack[Math.floor(annualStack.length / 3)]?.year}</span>
            <span>{annualStack[Math.floor((annualStack.length * 2) / 3)]?.year}</span>
            <span class="acc font-semibold">{annualStack[annualStack.length - 1]?.year}</span>
          </div>
        </div>
      </div>
    </div>
  )}

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6 pt-10 border-t border-[color:var(--color-rule)]">
    {annualIpoCounts.length > 0 && (
      <div class="border border-[color:var(--color-rule-card)] bg-white p-5 sm:p-6">
        <div class="flex items-baseline justify-between gap-4 mb-5">
          <h3 class="serif font-medium text-[18px]">IPOs per year</h3>
          <span class="label">Mainboard + SME</span>
        </div>
        <div class="flex gap-1 h-[175px]">
          {annualIpoCounts.map((a) => {
            const sumv = a.mainboard + a.sme;
            const h = (sumv / annualIpoMax) * 100;
            const mbPart = sumv > 0 ? (a.mainboard / sumv) * h : 0;
            const smePart = sumv > 0 ? (a.sme / sumv) * h : 0;
            return (
              <div class="flex-1 h-full flex flex-col justify-end min-w-0" title={`${a.year}: ${a.mainboard} mainboard + ${a.sme} SME`}>
                <div style={`height: ${smePart}%; min-height: ${a.sme > 0 ? '1px' : '0'};`} class="bg-[color:var(--color-accent)]"></div>
                <div style={`height: ${mbPart}%; min-height: ${a.mainboard > 0 ? '1px' : '0'};`} class="bg-[color:var(--color-ink)]"></div>
              </div>
            );
          })}
        </div>
        <div class="flex justify-between mt-3 text-[11px] mute num">
          <span>{annualIpoCounts[0]?.year}</span>
          <span>{annualIpoCounts[Math.floor(annualIpoCounts.length / 2)]?.year}</span>
          <span class="acc font-semibold">{annualIpoCounts[annualIpoCounts.length - 1]?.year}</span>
        </div>
      </div>
    )}

    <div class="border border-[color:var(--color-rule-card)] bg-white p-5 sm:p-6">
      <div class="flex items-baseline justify-between gap-4 mb-5">
        <h3 class="serif font-medium text-[18px]">Day-one moves</h3>
        <span class="label">Last 24 months</span>
      </div>
      <p class="text-[12.5px] mute mb-5">n=<span class="num">{dist.total.toLocaleString('en-IN')}</span> · median <span class="num acc">{fmtGain(dist.median)}</span> · <span class="num">{ytdPositivePct}%</span> positive</p>
      <div class="flex items-end gap-[3px] h-[175px] relative">
        <div class="absolute top-0 bottom-0 w-px bg-[color:var(--color-accent)] opacity-70" style={`left: ${distZeroPct.toFixed(2)}%`}></div>
        {dist.bins.map((b) => {
          const h = (b.count / distMax) * 100;
          return (
            <div class={`flex-1 ${b.from < 0 ? 'bg-[color:var(--color-mute)]' : 'bg-[color:var(--color-ink)]'}`} style={`height: ${h.toFixed(1)}%; min-height: ${b.count > 0 ? '2px' : '0'};`} title={`${b.from}% to ${b.to}%: ${b.count}`}></div>
          );
        })}
      </div>
      <div class="relative mt-3 h-4 text-[11px] mute num">
        <span class="absolute left-0">−100%</span>
        <span class="absolute -translate-x-1/2" style={`left: ${distZeroPct.toFixed(2)}%`}>0%</span>
        <span class="absolute right-0">+100%+</span>
      </div>
    </div>
  </div>

  <p class="text-[11px] mute mt-10 pt-5 border-t border-[color:var(--color-rule)] max-w-[80ch]">
    Capital-raising counts and rupee aggregates compiled by SEBI; obtained via the IndiaDataHub Economic Monitor.
    Day-one move distribution uses IPO Watch listings from the last 24 months.
  </p>
</section>

<!-- ════════════  RECENTLY LISTED  ════════════ -->
{recent.length > 0 && (
  <section class="cv-section page-tight py-14 md:py-24 border-b border-[color:var(--color-rule)]">
