        <span class="label num">{formatInt(countRights)}</span>
      </div>
      <ul class="list-none p-0 m-0">
        {recentRights.map((i) => (
          <li>
            <a href={i.url_path} class="block py-[10px] border-b border-[color:var(--color-rule)] group">
              <div class="serif font-medium text-[15px] leading-[1.25] truncate group-hover:text-[color:var(--color-accent)]">{displayName(i.company_name)}</div>
              <div class="flex justify-between text-[11.5px] mute mt-1 num">
                <span>{i.exchange_platform}</span>
                <span>{i.listing_date ? formatDateShort(i.listing_date) : (i.close_date ? formatDateShort(i.close_date) : '—')}</span>
              </div>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </div>

  <!-- Type-count band -->
  <div class="mt-14 pt-8 border-t border-[color:var(--color-rule)] grid grid-cols-2 md:grid-cols-6 gap-y-6 gap-x-6">
    {[
      { label: 'IPO', count: countIPO },
      { label: 'Rights', count: countRights },
      { label: 'OFS', count: countOFS },
      { label: 'Tender', count: countTender },
      { label: 'Buyback', count: countBuyback },
      { label: 'REIT · InvIT', count: countREIT + countInvIT },
    ].map((t) => (
      <div>
        <p class="serif font-light num text-[36px] leading-none">{formatInt(t.count)}</p>
        <p class="label mt-2">{t.label}</p>
      </div>
    ))}
  </div>
</section>

<!-- ════════════  ALL-TIME BEST LISTING DAYS  ════════════ -->
{topGainersAllTime.length > 0 && (
  <section class="cv-section page-tight py-14 md:py-24 border-b border-[color:var(--color-rule)]">
    <header class="flex items-baseline justify-between mb-10">
      <h2 class="section-title">Best listing days, all-time</h2>
      <span class="label">Top {topGainersAllTime.length} by day-one gain</span>
    </header>
    <ol class="list-none p-0 m-0">
      {topGainersAllTime.map((i, idx) => (
        <li class="relative group">
          <a href={i.url_path} class="grid grid-cols-[28px_minmax(0,1fr)_84px] sm:grid-cols-[36px_minmax(0,1fr)_140px_100px_100px] gap-4 sm:gap-6 items-baseline py-[20px] px-2 border-b border-[color:var(--color-rule)] transition-all duration-200 group-hover:pl-4">
            <span class="absolute left-0 top-0 bottom-0 w-[2px] bg-[color:var(--color-accent)] scale-y-0 origin-center group-hover:scale-y-100 transition-transform"></span>
            <span class="serif italic font-light text-[20px] text-[color:var(--color-mute-2)] num">{idx + 1}</span>
            <div class="min-w-0">
              <h3 class="t-title truncate group-hover:text-[color:var(--color-accent)] transition-colors">{displayName(i.company_name)}</h3>
              <p class="text-[11.5px] mute mt-1">{typeTag(i)}</p>
            </div>
            <span class="text-[12.5px] mute num text-right hidden sm:block">{i.listing_date ? formatDateShort(i.listing_date) : '—'}</span>
            <span class="text-[12.5px] mute num text-right hidden sm:block">{i.price_band?.min != null ? formatRupeeRange(i.price_band.min, i.price_band.max) : ''}</span>
            <span class="serif text-[26px] num text-right acc">{fmtGain(i.listing_day_gain)}</span>
          </a>
        </li>
      ))}
    </ol>
  </section>
)}

<!-- ════════════  ARCHIVE  ════════════ -->
<section class="cv-section page-tight py-14 pb-8 md:py-24 md:pb-12">
  <header class="flex items-baseline justify-between mb-10">
    <h2 class="section-title">Public issue archive</h2>
    <a href="/archive/" class="label hover:text-[color:var(--color-accent)]">All years →</a>
  </header>
  <div class="grid grid-cols-1 md:grid-cols-[1fr_1.2fr] gap-14 items-end">
    <div>
      <p class="t-sub mb-4 max-w-[40ch]">
        The Indian primary market has grown sevenfold since 2017, with
        {peakYear && (<> <strong class="italic acc font-medium">{peakYear.year}</strong> setting the all-time record at <span class="num">{peakYear.total.toLocaleString('en-IN')}</span> listings.</>)}
        A single year now produces more public issues than the decade from 2001 to 2010.
      </p>
      {peakYear && (
        <div class="serif italic font-light text-[36px] leading-[1.1] tracking-[-0.008em] mt-[18px]">
          <span class="acc">{peakYear.year}</span> · <span class="num">{peakYear.total.toLocaleString('en-IN')}</span> listings, all-time peak
        </div>
      )}
    </div>
    <div>
      <div class="flex gap-1 h-[130px]">
        {yearStatsAll.slice().reverse().map((s) => {
          const h = (s.total / yearMax) * 100;
          const isCurr = s.year === todayYear;
          return (
            <a href={`/archive/${s.year}/`} class="flex-1 h-full flex flex-col justify-end min-w-0 group" title={`${s.year}: ${s.total} issues`}>
              <span
                class={`w-full transition-opacity ${isCurr ? 'bg-[color:var(--color-accent)]' : 'bg-[color:var(--color-ink)]'} group-hover:opacity-55`}
                style={`height: ${h.toFixed(1)}%; min-height: 2px;`}
              ></span>
            </a>
          );
        })}
      </div>
      <div class="flex justify-between mt-2 text-[11px] mute num">
        <span>{yearStatsAll[yearStatsAll.length - 1]?.year}</span>
        <span>2010</span>
        <span>2015</span>
        <span>2020</span>
        <span class="acc font-semibold">{yearStatsAll[0]?.year}</span>
      </div>
    </div>
  </div>
  <div class="flex flex-wrap gap-1 mt-10 pt-[22px] border-t border-[color:var(--color-rule)]">
    {years.slice(0, 17).map((y) => (
      <a href={`/archive/${y}/`} class={`px-[11px] py-[6px] text-[12.5px] border num transition-colors ${y === todayYear ? 'bg-[color:var(--color-accent)] border-[color:var(--color-accent)] text-white' : 'border-[color:var(--color-rule)] text-[color:var(--color-ink-soft)] hover:bg-[color:var(--color-ink)] hover:text-white hover:border-[color:var(--color-ink)]'}`}>{y}</a>
    ))}
  </div>
</section>

</Base>
