      <div class={`grid grid-cols-[72px_minmax(0,1fr)] sm:grid-cols-[96px_minmax(0,1fr)] gap-6 sm:gap-10 py-6 border-b border-[color:var(--color-rule)] ${row.isToday ? 'border-l-2 border-l-[color:var(--color-accent)] pl-4 -ml-4 sm:pl-5 sm:-ml-5' : ''}`}>
