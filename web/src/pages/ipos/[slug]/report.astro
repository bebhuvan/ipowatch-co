---
import Base from '../../../layouts/Base.astro';
import { getCollection, render } from 'astro:content';
import ColumnChart from '../../../components/charts/ColumnChart.astro';
import { publicIssueSlug, listFinancialsSlugs, getFinancialsBySlug, getOfferCard } from '../../../lib/issues';
import { buildSnapshot, shortPeriod } from '../../../lib/financialsView';

export async function getStaticPaths() {
  const entries = await getCollection('ipoReports');
  // Slugs (public form) that have a full financial-statements sub-page.
  const finSlugs = new Set(listFinancialsSlugs().map((s) => publicIssueSlug(s)));
  // Map through publicIssueSlug so the report sits at /ipos/<public-slug>/report,
  // co-located with the detail page (which strips the hash from the raw slug).
  return entries.map((entry) => {
    const publicSlug = publicIssueSlug(entry.data.issue_slug);
    return {
      params: { slug: publicSlug },
      props: { entry, publicSlug, hasFinancials: finSlugs.has(publicSlug) },
    };
  });
}

const { entry, publicSlug, hasFinancials } = Astro.props as { entry: any; publicSlug: string; hasFinancials: boolean };
const { Content } = await render(entry);

const publishedLong = new Date(entry.data.published_at).toLocaleDateString('en-IN', {
  day: 'numeric', month: 'long', year: 'numeric',
});

const fin = hasFinancials ? getFinancialsBySlug(entry.data.issue_slug) : null;
const snapshot = fin ? buildSnapshot(fin) : null;
const offerCard = getOfferCard(entry.data.issue_slug);
const hasSnapshot = (!!snapshot && (snapshot.kpis.length > 0 || snapshot.revenueSeries.length > 1 || snapshot.patSeries.length > 1)) || offerCard.length > 0;
const docType = entry.data.document_type || 'DRHP';
const latestPeriodRaw = snapshot && snapshot.periods.length ? snapshot.periods[0] : '';
const latestPeriodLabel = latestPeriodRaw ? shortPeriod(latestPeriodRaw) : '';
---

<Base title={`${entry.data.title} — IPO Watch`} description={entry.data.dek}>
  <article class="report-article page-tight">
    <nav class="report-crumbs">
      <a href="/">IPO Watch</a>
      <span aria-hidden="true">/</span>
      <a href={`/ipos/${publicSlug}/`}>{entry.data.company_name}</a>
      <span aria-hidden="true">/</span>
      <span>Research report</span>
    </nav>

    <header class="report-header">
      <div class="report-kicker">{entry.data.kicker}</div>
      <h1 class="report-title serif">{entry.data.title}</h1>
      <p class="report-dek serif">{entry.data.dek}</p>
      <p class="report-byline">
        <span>From the {entry.data.document_type}</span>
        <span aria-hidden="true">·</span>
        <span>Published {publishedLong}</span>
        <span aria-hidden="true">·</span>
        <span>{entry.data.reading_time_minutes} min read</span>
      </p>
      {hasFinancials && !hasSnapshot && (
        <p class="report-fin-cta">
          <a href={`/ipos/${publicSlug}/report/financials/`}>
            <span>View the full restated financial statements</span>
            <span aria-hidden="true">→</span>
          </a>
        </p>
      )}
    </header>

    {hasSnapshot && (
      <section class="report-snapshot">
        <div class="report-snapshot-head">
          <span class="label">The offer at a glance</span>
          {hasFinancials && (
            <a class="report-snapshot-link" href={`/ipos/${publicSlug}/report/financials/`}>
              Full financial statements <span aria-hidden="true">→</span>
            </a>
          )}
        </div>

        {offerCard.length > 0 && (
          <div class="report-offer">
            {offerCard.map((r) => (
              <div class={`report-offer-cell${r.label === 'Use of proceeds' ? ' report-offer-cell--wide' : ''}`}>
                <div class="report-offer-label">{r.label}</div>
                <div class="report-offer-val serif">{r.value}</div>
              </div>
            ))}
          </div>
        )}

        {snapshot && (snapshot.kpis.length > 0 || snapshot.revenueSeries.length > 1 || snapshot.patSeries.length > 1) && (
          <div class="report-fin-block">
            <div class="report-fin-head">
              <span class="label">Financials</span>
              <span class="report-fin-note">As reported in the {docType}{latestPeriodLabel ? ` · latest period to ${latestPeriodLabel}` : ''}</span>
            </div>
            {snapshot.kpis.length > 0 && (
              <div class="report-kpis">
                {snapshot.kpis.map((k) => (
                  <div class="report-kpi">
                    <div class="label">{k.label}</div>
                    <div class="report-kpi-val serif num">{k.value}</div>
                  </div>
                ))}
              </div>
            )}
            {(snapshot.revenueSeries.length > 1 || snapshot.patSeries.length > 1) && (
              <div class="report-snapshot-charts">
                {snapshot.revenueSeries.length > 1 && (
                  <figure class="report-chart">
                    <figcaption class="label">Revenue from operations</figcaption>
                    <ColumnChart data={snapshot.revenueSeries} unit="₹ crore" />
                  </figure>
                )}
                {snapshot.patSeries.length > 1 && (
                  <figure class="report-chart">
                    <figcaption class="label">Net profit</figcaption>
                    <ColumnChart data={snapshot.patSeries} unit="₹ crore" />
                  </figure>
                )}
              </div>
            )}
          </div>
        )}
      </section>
    )}

    <div class="report-body serif">
      <Content />
    </div>

    <section class="report-sources">
      <h2 class="report-sources-title">Primary source</h2>
      <p class="report-sources-note">
        Every figure in this report is sourced to a page of the company’s filing.
        Inline citations link to the page; the documents below are the filings themselves.
      </p>
      <ol class="report-sources-list">
        {entry.data.sources.map((s) => (
          <li>
            <span class="src-tier">{s.source_tier}</span>
            <span class="src-kind">{s.document_kind}</span>
            <a href={s.url} rel="noopener" target="_blank">{s.title}</a>
            <span class="src-publisher">{s.publisher}</span>
          </li>
        ))}
      </ol>
    </section>
  </article>
</Base>

<style>
  .report-article {
    padding-top: 60px;
    padding-bottom: 112px;
    max-width: 820px;
  }

  .report-crumbs {
    font-family: var(--font-sans);
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-mute);
    margin-bottom: 32px;
  }
  .report-crumbs a:hover { color: var(--color-ink); }
  .report-crumbs span { margin: 0 8px; }

  .report-header {
    border-bottom: 1px solid var(--color-rule);
    padding-bottom: 30px;
    margin-bottom: 44px;
  }

  .report-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-deep);
    margin-bottom: 18px;
  }
  .report-kicker::before {
    content: "";
    width: 22px;
    height: 2px;
    background: var(--color-accent);
  }

  .report-title {
    font-size: clamp(38px, 5vw, 60px);
    line-height: 1.02;
    letter-spacing: -0.022em;
    font-weight: 500;
    margin: 0 0 20px;
    max-width: 20ch;
  }

  .report-dek {
    font-size: 21px;
    line-height: 1.5;
    font-style: italic;
    font-weight: 300;
    color: var(--color-ink-soft);
    margin: 0 0 24px;
    max-width: 56ch;
  }

  .report-byline {
    font-family: var(--font-sans);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--color-mute);
    text-transform: uppercase;
  }
  .report-byline span + span::before {
    content: "·";
    margin: 0 8px;
    color: var(--color-mute-2);
  }

  .report-fin-cta {
    margin-top: 18px;
  }
  .report-fin-cta a {
    display: inline-flex;
    align-items: baseline;
    gap: 8px;
    font-family: var(--font-sans);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.02em;
    color: var(--color-accent-deep);
    border-bottom: 2px solid var(--color-accent);
    padding-bottom: 3px;
  }
  .report-fin-cta a:hover { color: var(--color-ink); }

  /* Snapshot band */
  .report-snapshot {
    margin: 40px 0 56px;
    padding-top: 22px;
    border-top: 2px solid var(--color-ink);
  }
  .report-snapshot-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin-bottom: 20px;
  }
  /* Prominent pill link to the full statements */
  .report-snapshot-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-family: var(--font-sans);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--color-accent-deep);
    border: 1px solid var(--color-accent);
    padding: 7px 14px;
    transition: background 0.12s ease, color 0.12s ease;
  }
  .report-snapshot-link:hover { background: var(--color-accent); color: #fff; }

  /* Offer at a glance — labelled cells */
  .report-offer {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(170px, 1fr));
    gap: 1px;
    background: var(--color-rule);
    border: 1px solid var(--color-rule);
    margin-bottom: 30px;
  }
  .report-offer-cell { background: var(--color-paper); padding: 13px 16px; }
  .report-offer-cell--wide { grid-column: 1 / -1; }
  .report-offer-label {
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--color-mute);
    margin-bottom: 5px;
  }
  .report-offer-val { font-size: 16px; line-height: 1.4; color: var(--color-ink); white-space: pre-line; }

  /* Financials sub-block inside the snapshot */
  .report-fin-head {
    display: flex;
    align-items: baseline;
    gap: 12px;
    margin-bottom: 14px;
  }
  .report-fin-note {
    font-family: var(--font-sans);
    font-size: 11.5px;
    color: var(--color-mute);
    font-style: italic;
  }

  .report-kpis {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(150px, 1fr));
    gap: 1px;
    background: var(--color-rule);
    border: 1px solid var(--color-rule);
    margin-bottom: 26px;
  }
  .report-kpi { background: var(--color-paper); padding: 15px 18px; }
  .report-kpi-val { font-size: 25px; line-height: 1.1; margin-top: 6px; color: var(--color-ink); }

  .report-snapshot-charts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 22px;
  }
  /* Carded charts */
  .report-chart {
    margin: 0;
    padding: 16px 18px 12px;
    background: var(--color-paper-soft);
    border: 1px solid var(--color-rule);
  }
  .report-chart .label { margin-bottom: 2px; display: block; }

  /* Body — shares the academy prose system */
  .report-body {
    font-size: 19px;
    line-height: 1.62;
    color: var(--color-ink-soft);
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  .report-body :global(p) {
    margin: 0 0 1.5em;
    max-width: 64ch;
    text-wrap: pretty;
  }

  .report-body > :global(p:first-of-type) {
    font-size: 21px;
    line-height: 1.5;
    color: var(--color-ink);
  }
  .report-body > :global(p:first-of-type)::first-letter {
    float: left;
    font-family: var(--font-serif);
    font-weight: 500;
    font-size: 58px;
    line-height: 0.84;
    padding: 5px 12px 0 0;
    color: var(--color-ink);
  }

  .report-body :global(h2) {
    font-family: var(--font-serif);
    font-size: 30px;
    font-weight: 500;
    line-height: 1.16;
    letter-spacing: -0.014em;
    margin: 2.5em 0 0.7em;
    padding-top: 1.1em;
    border-top: 1px solid var(--color-rule);
    color: var(--color-ink);
  }

  .report-body :global(h3) {
    font-family: var(--font-serif);
    font-size: 22px;
    font-style: italic;
    font-weight: 500;
    line-height: 1.25;
    margin: 1.8em 0 0.5em;
    color: var(--color-ink);
  }

  .report-body :global(strong) { font-weight: 600; }

  .report-body :global(ul) {
    margin: 0 0 1.35em 0;
    padding-left: 1.4em;
    max-width: 67ch;
  }
  .report-body :global(li) { margin-bottom: 0.5em; }

  /* Tables — newspaper hairlines */
  .report-body :global(table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1.8em 0 2em;
    font-family: var(--font-sans);
    font-size: 15.5px;
    line-height: 1.5;
  }
  .report-body :global(thead th) {
    text-align: left;
    font-weight: 600;
    letter-spacing: 0.02em;
    padding: 10px 14px 10px 0;
    border-top: 2px solid var(--color-rule-strong);
    border-bottom: 1px solid var(--color-rule-strong);
    color: var(--color-ink);
    vertical-align: bottom;
  }
  .report-body :global(tbody td) {
    padding: 12px 14px 12px 0;
    border-bottom: 1px solid var(--color-rule);
    vertical-align: top;
  }
  .report-body :global(tbody tr:last-child td) {
    border-bottom: 1px solid var(--color-rule-strong);
  }

  /* Pull-quote */
  .report-body :global(aside.pull-quote) {
    margin: 2.2em 0;
    padding-top: 22px;
    font-family: var(--font-serif);
    font-style: italic;
    font-weight: 400;
    font-size: 33px;
    line-height: 1.2;
    letter-spacing: -0.018em;
    color: var(--color-ink);
    max-width: 20ch;
    position: relative;
  }
  .report-body :global(aside.pull-quote)::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    width: 44px;
    height: 3px;
    background: var(--color-accent);
  }

  /* At-a-glance card — a full-width key-facts block in the flow (no float). */
  .report-body :global(aside.article-sidebar) {
    display: block;
    width: 100%;
    max-width: 64ch;
    margin: 2.4em 0;
    padding: 20px 24px 14px;
    border-top: 2px solid var(--color-ink);
    border-bottom: 1px solid var(--color-rule);
    background: var(--color-paper-soft);
    font-family: var(--font-sans);
    color: var(--color-ink);
  }
  .report-body :global(aside.article-sidebar .article-sidebar-label) {
    font-family: var(--font-sans);
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-accent-deep);
    margin-bottom: 4px;
  }
  .report-body :global(aside.article-sidebar .article-sidebar-title) {
    font-family: var(--font-serif);
    font-size: 19px;
    font-weight: 500;
    line-height: 1.2;
    margin-bottom: 14px;
    color: var(--color-ink);
  }
  .report-body :global(aside.article-sidebar p) {
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
    padding: 7px 0;
    max-width: none;
    border-top: 1px solid var(--color-rule);
    color: var(--color-ink-soft);
  }
  .report-body :global(aside.article-sidebar p:first-of-type) { border-top: none; }
  .report-body :global(aside.article-sidebar strong) {
    color: var(--color-ink);
    font-weight: 600;
  }

  /* ── Industry visual blocks ────────────────────────────────── */

  /* Stat strip */
  .report-body :global(.industry-snapshot) {
    margin: 2.2em 0 1.6em;
    padding: 18px 0 16px;
    border-top: 2px solid var(--color-ink);
    border-bottom: 1px solid var(--color-rule);
  }
  .report-body :global(.industry-snapshot-label) {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--color-accent-deep);
    margin-bottom: 14px;
  }
  .report-body :global(.industry-snapshot-stats) {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
    gap: 18px 28px;
  }
  .report-body :global(.industry-stat-val) {
    font-family: var(--font-serif);
    font-size: 26px;
    font-weight: 500;
    color: var(--color-ink);
    line-height: 1.05;
    margin-bottom: 5px;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .report-body :global(.industry-stat-desc) {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--color-mute);
    line-height: 1.45;
  }

  /* Growth bars */
  .report-body :global(.market-growth) {
    margin: 1.8em 0;
  }
  .report-body :global(.market-growth-label) {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-mute);
    margin-bottom: 12px;
  }
  .report-body :global(.market-growth-item) {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }
  .report-body :global(.market-growth-year) {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    color: var(--color-mute);
    width: 32px;
    flex-shrink: 0;
  }
  .report-body :global(.market-growth-bar-wrap) {
    flex: 1;
    height: 26px;
    background: var(--color-paper-soft);
    border: 1px solid var(--color-rule);
    overflow: hidden;
  }
  .report-body :global(.market-growth-bar) {
    height: 100%;
    background: var(--color-accent);
    transition: width 0s;
  }
  .report-body :global(.market-growth-bar--proj) {
    background: var(--color-ink-4);
  }
  .report-body :global(.market-growth-val) {
    font-family: var(--font-serif);
    font-size: 14px;
    font-weight: 500;
    color: var(--color-ink);
    white-space: nowrap;
    width: 130px;
    flex-shrink: 0;
    font-variant-numeric: tabular-nums lining-nums;
  }
  .report-body :global(.market-growth-tag) {
    font-family: var(--font-sans);
    font-size: 9.5px;
    color: var(--color-mute);
    font-style: italic;
    font-weight: normal;
  }
  .report-body :global(.market-growth-note) {
    font-family: var(--font-sans);
    font-size: 11px;
    color: var(--color-mute);
    margin: 6px 0 0 42px;
    font-style: italic;
    max-width: none;
  }

  /* Organised / unorganised split bar */
  .report-body :global(.market-structure) {
    margin: 1.8em 0;
  }
  .report-body :global(.market-structure-label) {
    font-family: var(--font-sans);
    font-size: 10px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-mute);
    margin-bottom: 10px;
  }
  .report-body :global(.market-structure-bar) {
    display: flex;
    height: 46px;
    gap: 2px;
    margin-bottom: 8px;
  }
  .report-body :global(.market-structure-seg) {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 0 10px;
    overflow: hidden;
  }
  .report-body :global(.market-structure-org) {
    background: var(--color-accent);
  }
  .report-body :global(.market-structure-unorg) {
    background: var(--color-paper-soft);
    border: 1px solid var(--color-rule);
  }
  .report-body :global(.market-structure-pct) {
    font-family: var(--font-sans);
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    display: block;
  }
  .report-body :global(.market-structure-org .market-structure-pct) { color: #fff; }
  .report-body :global(.market-structure-unorg .market-structure-pct) { color: var(--color-ink); }
  .report-body :global(.market-structure-name) {
    font-family: var(--font-sans);
    font-size: 9.5px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    margin-top: 2px;
    display: block;
  }
  .report-body :global(.market-structure-org .market-structure-name) { color: rgba(255,255,255,0.75); }
  .report-body :global(.market-structure-unorg .market-structure-name) { color: var(--color-mute); }
  .report-body :global(.market-structure-note) {
    font-family: var(--font-sans);
    font-size: 11.5px;
    color: var(--color-mute);
    font-style: italic;
    line-height: 1.5;
    margin: 0;
    max-width: none;
  }

  /* GFM footnotes — editorial citation marks, not loud numbers */
  .report-body :global(sup) {
    font-size: 0.62em;
    color: var(--color-mute-2);
    font-feature-settings: "sups";
    margin-left: 1px;
    font-family: var(--font-sans);
    letter-spacing: -0.02em;
  }
  .report-body :global(sup a) {
    color: inherit;
    text-decoration: none;
  }
  .report-body :global(sup a:hover) {
    color: var(--color-accent-deep);
  }
  .report-body :global(.footnotes) {
    margin-top: 3em;
    padding-top: 1.4em;
    border-top: 1px solid var(--color-rule);
    font-family: var(--font-sans);
    font-size: 13px;
    line-height: 1.55;
    color: var(--color-mute);
  }
  .report-body :global(.footnotes ol) {
    padding-left: 1.4em;
    column-width: 230px;
    column-gap: 36px;
  }
  .report-body :global(.footnotes li) {
    margin-bottom: 0.3em;
    break-inside: avoid;
  }
  .report-body :global(.footnotes a) {
    color: var(--color-accent-deep);
    text-decoration: underline;
    text-decoration-thickness: 0.5px;
    text-underline-offset: 2px;
  }

  /* Sources block */
  .report-sources {
    margin-top: 64px;
    padding-top: 24px;
    border-top: 2px solid var(--color-ink);
  }
  .report-sources-title {
    font-family: var(--font-sans);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink);
    margin: 0 0 10px;
  }
