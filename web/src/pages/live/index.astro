---
import Base from '../../layouts/Base.astro';
import { getBreadcrumbSchema, getItemListSchema } from '../../lib/seo';
import { getCurrent, getDetailBySlug, extractIngredient } from '../../lib/issues';
import {
  formatLakhCr,
  formatRupee,
  formatRupeeRange,
  formatTimes,
  formatInt,
  daysFromNow,
} from '../../lib/format';

const today = new Date();
const current = getCurrent();

const enriched = current.map((issue) => {
  const detail = getDetailBySlug(issue.slug);
  const traj = detail?.subscription?.trajectory ?? [];
  const last = traj.length ? traj[traj.length - 1] : null;
  const subscriptionTimes = last?.total?.times ?? detail?.subscription?.times ?? null;
  const ing = detail ? extractIngredient(detail) : null;
  const closeDays = daysFromNow(issue.close_date, today) ?? 999;
  return {
    issue: {
      ...issue,
      price_band: {
        min: issue.price_band.min ?? ing?.priceMin ?? null,
        max: issue.price_band.max ?? ing?.priceMax ?? null,
        text: issue.price_band.text,
      },
    },
    subscriptionTimes,
    lotSize: ing?.lotSize ?? null,
    closeDays,
    raise: ing?.impliedSize ? formatLakhCr(ing.impliedSize) : detail?.issue_size?.text ?? null,
    brlmName: ing?.brlmName ?? null,
  };
}).sort((a, b) => a.closeDays - b.closeDays);

const typeTag = (issue: { issue_type: string | null; exchange_platform: string | null }) => {
  const t = issue.issue_type ?? '';
  const ex = (issue.exchange_platform ?? '').replace(/\s+/g, ' ').trim();
  return [t, ex].filter(Boolean).join('  ·  ');
};

const ROMAN = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X', 'XI', 'XII'];
const closeTiming = (d: number) => d === 0 ? 'Closes today' : d === 1 ? 'Closes tomorrow' : d > 0 ? `Closes in ${d} days` : 'Closed';

const schemas = [
  getBreadcrumbSchema([
    { name: "Home", url: "/" },
    { name: "Open Issues", url: "/live/" }
  ]),
  getItemListSchema(
    enriched.map(({ issue, raise }) => ({
      name: `${issue.company_name} ${issue.issue_type ?? 'IPO'}`,
      url: issue.url_path,
      description: raise ? `Issue size: ₹${raise}` : undefined,
    })),
    `Indian IPOs Currently Open for Subscription`,
    '/live/'
  ),
];
const metaDescription = `Track all ${enriched.length} Indian public IPOs currently open for subscription on the NSE & BSE. Get up-to-date subscription multiples, price bands, minimum lot sizes, retail investment values, and key book running lead managers (BRLM).`;
---

<Base title="Live IPOs Open for Subscription (NSE & BSE)" description={metaDescription} schemas={schemas}>
<section class="page-tight pt-16 pb-8">
  <div class="text-[12.5px] mute mb-6 inline-flex items-center gap-2">
    <span class="live-dot"></span>
    <span class="label" style="color: inherit">Open for subscription</span>
  </div>
  <h1 class="headline mb-7 max-w-[18ch]">
    {enriched.length} {enriched.length === 1 ? 'issue' : 'issues'} open right now.
  </h1>
  <p class="serif text-[20px] leading-[1.5] text-[color:var(--color-ink-soft)] max-w-[58ch]">
    Issues currently accepting bids on the exchange order books. Subscription
    numbers are refreshed from NSE and BSE feeds through the day.
  </p>
</section>

<section class="page-tight pb-24">
  {enriched.length === 0 ? (
    <p class="serif italic text-[20px] mute mt-12">A quiet day on the primary market.</p>
  ) : (
    <ul class="ipo-list">
      {enriched.map(({ issue, subscriptionTimes, lotSize, closeDays, raise, brlmName }) => (
        <li class="ipo-row-wrap">
          <span class="ipo-row-accent"></span>
          <a href={issue.url_path} class="ipo-row">
            <div class="ipo-row-main">
              <div class="ipo-row-tags">
                <span class="issue-badge issue-badge-live">Live</span>
                <span class="ipo-row-type">{typeTag(issue)}</span>
              </div>
              <div class="ipo-row-company">{issue.company_name}</div>
            </div>
            <div class="ipo-row-stats">
              <div class="ipo-row-stat">
                <span class="label">Price band</span>
                <span class="ipo-row-val">{formatRupeeRange(issue.price_band.min, issue.price_band.max)}</span>
              </div>
              <div class="ipo-row-stat">
                <span class="label">Lot</span>
                <span class="ipo-row-val">{lotSize ? formatInt(lotSize) : '—'}</span>
              </div>
              <div class="ipo-row-stat">
                <span class="label">Min. investment</span>
                <span class="ipo-row-val">{lotSize && issue.price_band.max ? formatRupee(lotSize * issue.price_band.max) : '—'}</span>
              </div>
              {subscriptionTimes != null ? (
                <div class="ipo-row-stat">
                  <span class="label">Subscribed</span>
                  <span class="ipo-row-val acc">{formatTimes(subscriptionTimes)}</span>
                </div>
              ) : (
                <div class="ipo-row-stat">
                  <span class="label">Issue size</span>
                  <span class="ipo-row-val">{raise ?? '—'}</span>
                </div>
              )}
            </div>
            <span class={`ipo-row-timing ${closeDays === 0 ? 'ipo-row-timing-live' : closeDays === 1 ? 'ipo-row-timing-soon' : ''}`}>
              {closeTiming(closeDays)}
            </span>
          </a>
        </li>
      ))}
    </ul>
  )}
</section>
</Base>
