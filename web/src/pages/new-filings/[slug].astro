---
import Base from '../../layouts/Base.astro';
import { getNewFiling, listNewFilingPaths, type NewFilingArticleBlock, type NewFilingFact } from '../../lib/newFilings';
import { formatDateLong, formatInt } from '../../lib/format';

export function getStaticPaths() {
  return listNewFilingPaths().map(({ slug }) => {
    const filing = getNewFiling(slug);
    return filing ? { params: { slug }, props: { filing } } : null;
  }).filter(Boolean);
}

const { filing } = Astro.props;
const blocks: NewFilingArticleBlock[] = filing.article.blocks?.length
  ? filing.article.blocks
  : filing.article.sections.map((section) => ({
      type: 'evidence_groups',
      title: section.title,
      groups: [{ label: section.title, items: section.facts }],
    }));

const pageText = (page: number | null | undefined) => page ? `p.${page}` : 'source';
const factPage = (fact: NewFilingFact | null | undefined) => pageText(fact?.source_page);
const factValue = (fact: NewFilingFact | null | undefined) => fact?.value ?? '-';
const cellValue = (cell: { value?: string | number; fact?: NewFilingFact | null }) => cell.fact ? factValue(cell.fact) : (cell.value ?? '-');
const pagesText = (pages: number[] | null | undefined) => pages?.length ? pages.map((p) => `p.${p}`).join(', ') : 'source';
const barWidth = (value: number | null | undefined, max: number | null | undefined) => {
  if (!value || !max || max <= 0) return '0%';
  return `${Math.max(2, Math.min(100, (value / max) * 100)).toFixed(1)}%`;
};
---

<Base title={filing.company_name} description={filing.dek}>
  <article>
    <section class="page-tight pt-16 pb-10">
      <div class="flex flex-wrap items-center gap-x-3 gap-y-2 mb-7">
        <span class="issue-badge issue-badge-dark">{filing.document_type}</span>
        <span class="label">SEBI new filing</span>
        <span class="label">{formatDateLong(filing.filing_date)}</span>
      </div>
      <h1 class="headline mb-8 max-w-[18ch]">{filing.company_name}</h1>
      <p class="lede max-w-[72ch]">{filing.dek}</p>
    </section>

    <section class="page-tight pt-8 pb-14 border-t border-[color:var(--color-rule)]">
      <div class="grid grid-cols-2 lg:grid-cols-4 gap-8">
        <div class="pt-[14px] border-t border-[color:var(--color-ink)]">
          <p class="figure-2 num">{formatInt(filing.quality.verified_fact_count)}</p>
          <p class="label mt-3">Verified facts</p>
        </div>
        <div class="pt-[14px] border-t border-[color:var(--color-ink)]">
          <p class="figure-2 num">{formatInt(filing.pdf_pages)}</p>
          <p class="label mt-3">PDF pages</p>
        </div>
        <div class="pt-[14px] border-t border-[color:var(--color-ink)]">
          <p class="figure-2 num">{formatInt(filing.citation_validation.redacted_count)}</p>
          <p class="label mt-3">Redacted claims</p>
        </div>
        <div class="pt-[14px] border-t border-[color:var(--color-ink)]">
          <p class="serif text-[28px] leading-[1.05]">{filing.quality.state}</p>
          <p class="label mt-3">Quality state</p>
        </div>
      </div>
    </section>

    {filing.article.summary.length > 0 && (
      <section class="page-tight pt-10 pb-14 border-t border-[color:var(--color-rule)]">
        <h2 class="section-title mb-8">Filing snapshot</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 border-t border-l border-[color:var(--color-rule-card)]">
          {filing.article.summary.map((fact: NewFilingFact) => (
            <div class="min-h-[150px] border-r border-b border-[color:var(--color-rule-card)] bg-white p-5">
              <p class="label mb-4">{fact.label ?? 'Fact'} · {factPage(fact)}</p>
              <p class="serif text-[22px] leading-[1.18] break-words">{fact.value}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="page-tight pt-10 pb-16 border-t border-[color:var(--color-rule)]">
      <div class="grid grid-cols-1 lg:grid-cols-[250px_minmax(0,1fr)] gap-10">
        <aside class="lg:sticky lg:top-8 self-start">
          <p class="label mb-4">Source document</p>
          <a href={filing.document_url} target="_blank" rel="noreferrer" class="inline-flex border border-[color:var(--color-ink)] px-4 py-2 text-[12px] font-semibold hover:bg-[color:var(--color-ink)] hover:text-white">
            Open SEBI PDF
          </a>
          <div class="mt-7 pt-5 border-t border-[color:var(--color-rule)]">
            <p class="label mb-3">Citation audit</p>
            <p class="text-[13px] leading-[1.55] mute">
              {formatInt(filing.citation_validation.checked_count)} claims checked,
              {formatInt(filing.citation_validation.repaired_count)} page links repaired,
              {formatInt(filing.citation_validation.redacted_count)} unsupported claims removed.
            </p>
          </div>
        </aside>

        <div>
          {blocks.map((block: any) => (
            <section class="pb-14 mb-14 border-b border-[color:var(--color-rule)]">
              {block.kicker && <p class="label label-acc mb-3">{block.kicker}</p>}
              <h2 class="section-title mb-4">{block.title}</h2>
              {block.dek && <p class="t-sub max-w-[70ch] mb-7">{block.dek}</p>}

              {block.type === 'narrative' && (
                <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_300px] gap-9">
                  <div class="space-y-5">
                    {block.paragraphs?.map((paragraph: string) => (
                      <p class="serif text-[22px] leading-[1.48] text-[color:var(--color-ink-soft)]">{paragraph}</p>
                    ))}
                  </div>
                  <div class="border-t border-[color:var(--color-ink)] pt-4">
                    <p class="label mb-4">Key evidence</p>
                    <div class="space-y-4">
                      {block.facts?.slice(0, 5).map((fact: NewFilingFact) => (
                        <div>
                          <p class="text-[13px] leading-[1.45]">{fact.value}</p>
                          <p class="mt-1 text-[11px] mute">{factPage(fact)}</p>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              )}

              {block.type === 'takeaways' && (
                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                  {block.rows?.map((row: any) => (
                    <div class="border-t border-[color:var(--color-ink)] pt-5">
                      <p class="label mb-4">{row.label}</p>
                      <p class="serif text-[22px] leading-[1.42] text-[color:var(--color-ink-soft)]">{row.text}</p>
                      {row.facts?.length > 0 && (
                        <div class="mt-5 space-y-2">
                          {row.facts.slice(0, 3).map((fact: NewFilingFact) => (
                            <p class="text-[12px] leading-[1.45] mute">{factPage(fact)} · {fact.value}</p>
                          ))}
                        </div>
                      )}
                    </div>
                  ))}
                </div>
              )}

              {block.type === 'analysis' && (
                <div class="grid grid-cols-1 xl:grid-cols-[minmax(0,1fr)_300px] gap-9 border-t border-[color:var(--color-ink)] pt-6">
                  <div class="space-y-5">
                    {block.paragraphs?.map((paragraph: string) => (
                      <p class="serif text-[22px] leading-[1.48] text-[color:var(--color-ink-soft)]">{paragraph}</p>
                    ))}
                  </div>
                  {block.facts?.length > 0 && (
                    <div>
                      <p class="label mb-4">Supporting figures</p>
                      <div class="space-y-4">
                        {block.facts.slice(0, 6).map((fact: NewFilingFact) => (
                          <div>
                            <p class="text-[13px] leading-[1.45]">{fact.value}</p>
                            <p class="mt-1 text-[11px] mute">{factPage(fact)}</p>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              )}

              {block.type === 'table' && (
                <div class="overflow-x-auto border-t border-[color:var(--color-ink)]">
                  <table class="w-full min-w-[680px] text-left">
                    <thead>
                      <tr class="border-b border-[color:var(--color-rule)]">
                        {block.columns?.map((column: string) => (
                          <th class="label py-3 pr-5">{column}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {block.rows?.map((row: any) => (
                        <tr class="border-b border-[color:var(--color-rule)] align-top">
                          <td class="py-4 pr-5 text-[13px] font-semibold w-[190px]">{row.label}</td>
                          <td class="py-4 pr-5 serif text-[20px] leading-[1.28]">{row.value}</td>
                          <td class="py-4 pr-5 text-[12px] mute w-[140px]">{pagesText(row.source_pages)}</td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {block.type === 'structured_table' && (
                <div class="overflow-x-auto border-t border-[color:var(--color-ink)]">
                  <table class="w-full min-w-[760px] text-left">
                    <thead>
                      <tr class="border-b border-[color:var(--color-rule)]">
                        {block.columns?.map((column: string) => (
                          <th class="label py-3 pr-5">{column}</th>
                        ))}
                      </tr>
                    </thead>
                    <tbody>
                      {block.rows?.map((row: any) => (
                        <tr class="border-b border-[color:var(--color-rule)] align-top">
                          {row.cells?.map((cell: any) => (
                            <td class="py-4 pr-5">
                              <p class="text-[14px] leading-[1.35] break-words">{cellValue(cell)}</p>
                              {cell.fact?.source_page && <p class="mt-1 text-[11px] mute">{factPage(cell.fact)}</p>}
                            </td>
                          ))}
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              )}

              {block.type === 'bar_chart' && (
                <div class="border-t border-[color:var(--color-ink)] pt-6">
                  <div class="space-y-5">
                    {block.points?.map((point: any) => (
                      <div class="grid grid-cols-[120px_minmax(0,1fr)] gap-4 items-center">
                        <div>
                          <p class="text-[13px] font-semibold">{point.label}</p>
                          <p class="text-[11px] mute">{pageText(point.source_page)}</p>
                        </div>
                        <div class="space-y-2">
                          <div class="grid grid-cols-[64px_minmax(0,1fr)_72px] gap-3 items-center">
                            <span class="label">Revenue</span>
                            <span class="h-3 bg-[color:var(--color-rule)] block"><span class="h-3 bg-[color:var(--color-ink)] block" style={`width:${barWidth(point.revenue, block.max_value)}`}></span></span>
                            <span class="text-[12px] num">{point.revenue ?? '-'}</span>
                          </div>
                          <div class="grid grid-cols-[64px_minmax(0,1fr)_72px] gap-3 items-center">
                            <span class="label">PAT</span>
                            <span class="h-3 bg-[color:var(--color-rule)] block"><span class="h-3 bg-[color:var(--color-accent)] block" style={`width:${barWidth(point.profit_after_tax, block.max_value)}`}></span></span>
                            <span class="text-[12px] num">{point.profit_after_tax ?? '-'}</span>
                          </div>
                        </div>
                      </div>
                    ))}
                  </div>
                </div>
              )}

              {block.type === 'evidence_groups' && (
                <div class="grid grid-cols-1 md:grid-cols-2 gap-x-10 gap-y-8">
                  {block.paragraphs?.length > 0 && (
                    <div class="md:col-span-2 space-y-4 max-w-[76ch]">
                      {block.paragraphs.map((paragraph: string) => (
                        <p class="serif text-[21px] leading-[1.45] text-[color:var(--color-ink-soft)]">{paragraph}</p>
                      ))}
                    </div>
                  )}
                  {block.groups?.map((group: any) => (
                    <div class="border-t border-[color:var(--color-ink)] pt-4">
                      <h3 class="label mb-4">{group.label}</h3>
                      <div class="space-y-4">
                        {group.items?.map((fact: NewFilingFact) => (
                          <div>
                            <p class="serif text-[20px] leading-[1.3]">{fact.value}</p>
                            <p class="mt-2 text-[12px] mute">{factPage(fact)}</p>
                          </div>
                        ))}
                      </div>
                    </div>
                  ))}
                </div>
              )}

              {block.type === 'risk_matrix' && (
                <div class="space-y-8">
                  {block.risk_factor_count && (
                    <div class="border-t border-[color:var(--color-ink)] pt-4">
                      <p class="label mb-2">Risk-factor count · {factPage(block.risk_factor_count)}</p>
                      <p class="serif text-[24px] leading-[1.2]">{block.risk_factor_count.value}</p>
                    </div>
                  )}
                  {block.rows?.length > 0 && (
                    <div class="overflow-x-auto border-t border-[color:var(--color-ink)]">
                      <table class="w-full min-w-[680px] text-left">
                        <thead>
                          <tr class="border-b border-[color:var(--color-rule)]">
                            <th class="label py-3 pr-5">Risk</th>
                            <th class="label py-3 pr-5">Why it matters</th>
                            <th class="label py-3 pr-5">Source</th>
                          </tr>
                        </thead>
                        <tbody>
                          {block.rows.map((row: any) => (
                            <tr class="border-b border-[color:var(--color-rule)] align-top">
                              <td class="py-4 pr-5 serif text-[20px] leading-[1.28]">{factValue(row.risk)}</td>
                              <td class="py-4 pr-5 text-[14px] leading-[1.45]">{factValue(row.why_it_matters)}</td>
                              <td class="py-4 pr-5 text-[12px] mute w-[120px]">{factPage(row.risk ?? row.why_it_matters)}</td>
                            </tr>
                          ))}
                        </tbody>
                      </table>
                    </div>
                  )}
                  {block.red_flags?.length > 0 && (
                    <div>
                      <p class="label mb-4">Additional red flags</p>
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        {block.red_flags.map((fact: NewFilingFact) => (
                          <div class="border-l border-[color:var(--color-accent)] pl-4">
                            <p class="text-[14px] leading-[1.45]">{fact.value}</p>
                            <p class="mt-1 text-[11px] mute">{factPage(fact)}</p>
                          </div>
                        ))}
                      </div>
                    </div>
                  )}
                </div>
              )}
            </section>
          ))}

          <section>
            <h2 class="section-title mb-6">Source notes</h2>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-x-8 gap-y-3">
              {filing.article.citations.slice(0, 40).map((fact: NewFilingFact) => (
                <div class="grid grid-cols-[64px_minmax(0,1fr)] gap-3 border-t border-[color:var(--color-rule)] pt-3">
                  <p class="label">{factPage(fact)}</p>
                  <p class="text-[12px] leading-[1.45] mute">{fact.raw_excerpt}</p>
                </div>
              ))}
            </div>
          </section>
        </div>
      </div>
    </section>
  </article>
</Base>
