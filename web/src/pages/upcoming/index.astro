---
import Base from '../../layouts/Base.astro';
import { getUpcoming, getDetailBySlug, extractIngredient } from '../../lib/issues';
import {
  formatDateShort,
  formatLakhCr,
  formatRupee,
  formatRupeeRange,
  formatInt,
  daysFromNow,
} from '../../lib/format';

const today = new Date();
const enriched = getUpcoming().map((issue) => {
  const detail = getDetailBySlug(issue.slug);
  const ing = detail ? extractIngredient(detail) : null;
  return {
    issue: {
      ...issue,
      price_band: {
        min: issue.price_band.min ?? ing?.priceMin ?? null,
        max: issue.price_band.max ?? ing?.priceMax ?? null,
        text: issue.price_band.text,
      },
    },
    lotSize: ing?.lotSize ?? null,
    brlmName: ing?.brlmName ?? null,
    raise: ing?.impliedSize ? formatLakhCr(ing.impliedSize) : detail?.issue_size?.text ?? null,
    openDays: daysFromNow(issue.open_date, today) ?? 999,
  };
}).sort((a, b) => a.openDays - b.openDays);

const typeTag = (issue: { issue_type: string | null; exchange_platform: string | null }) => {
  const t = issue.issue_type ?? '';
  const ex = (issue.exchange_platform ?? '').replace(/\s+/g, ' ').trim();
  return [t, ex].filter(Boolean).join('  ·  ');
};

const openWindow = (open: string | null, close: string | null) => {
  if (!open && !close) return '—';
  const o = open ? formatDateShort(open) : '—';
  const c = close ? formatDateShort(close) : '';
  return c ? `${o} — ${c}` : o;
};

---

<Base title="Opening soon">
<section class="page-tight pt-16 pb-8">
  <div class="text-[12.5px] mute mb-6">
    <span class="label" style="color: inherit">Opening soon</span>
  </div>
  <h1 class="headline mb-7 max-w-[18ch]">
    {enriched.length} {enriched.length === 1 ? 'issue' : 'issues'} on the calendar.
  </h1>
  <p class="serif text-[20px] leading-[1.5] text-[color:var(--color-ink-soft)] max-w-[58ch]">
    Issues with announced opening dates that are not yet accepting bids.
    Dates and price bands can still change before the issue opens.
  </p>
</section>

<section class="page-tight pb-24">
  {enriched.length === 0 ? (
    <p class="serif italic text-[20px] mute mt-12">No upcoming issues with confirmed dates.</p>
  ) : (
    <ul class="ipo-list">
      {enriched.map(({ issue, lotSize, raise, openDays, brlmName }) => (
        <li class="ipo-row-wrap">
          <span class="ipo-row-accent"></span>
          <a href={issue.url_path} class="ipo-row">
            <div class="ipo-row-main">
              <div class="ipo-row-tags">
                <span class="issue-badge issue-badge-dark">Upcoming</span>
                <span class="ipo-row-type">{typeTag(issue)}{brlmName ? ` · ${brlmName}` : ''}</span>
              </div>
              <div class="ipo-row-company">{issue.company_name}</div>
            </div>
            <div class="ipo-row-stats">
              <div class="ipo-row-stat">
                <span class="label">Price band</span>
                <span class="ipo-row-val">{formatRupeeRange(issue.price_band.min, issue.price_band.max)}</span>
              </div>
              <div class="ipo-row-stat">
                <span class="label">Lot</span>
                <span class="ipo-row-val">{lotSize ? formatInt(lotSize) : '—'}</span>
              </div>
              <div class="ipo-row-stat">
                <span class="label">Min. investment</span>
                <span class="ipo-row-val">{lotSize && issue.price_band.max ? formatRupee(lotSize * issue.price_band.max) : '—'}</span>
              </div>
              <div class="ipo-row-stat">
                <span class="label">Issue size</span>
                <span class="ipo-row-val">{raise ?? '—'}</span>
              </div>
              <div class="ipo-row-stat">
                <span class="label">Window</span>
                <span class="ipo-row-val">{openWindow(issue.open_date, issue.close_date)}</span>
              </div>
            </div>
            <span class={`ipo-row-timing ${openDays === 0 ? 'ipo-row-timing-live' : openDays === 1 ? 'ipo-row-timing-soon' : ''}`}>
              {openDays === 0 ? 'Opens today' : openDays === 1 ? 'Tomorrow' : openDays > 0 ? `In ${openDays}d` : '—'}
            </span>
          </a>
        </li>
      ))}
    </ul>
  )}
</section>
</Base>
